FundamentalDataTypes DEFINITIONS
AUTOMATIC TAGS ::=

BEGIN

EXPORTS ALL ;

-- ****************************************************************************
-- * Low precision real number types. This OCTET STRING is intended to hold   *
-- * IEEE754 single precision floating point numbers.                         *
-- * Standard encoding rules (e.g. DER, BER, UPER etc.) do not allow for the  *
-- * IEEE754 formats to be used, and so this OCTET STRING is intended to hold *
-- * the IEEE754 encodings. Implementers of this specification are required   *
-- * to use their own functions to encode/decode the IEEE754 values that will *
-- * populate this OCTET STRING.                                              *
-- ****************************************************************************
IEEE754Sp ::=               OCTET STRING (SIZE(4))

-- ****************************************************************************
-- * High precision real number types. This OCTET STRING is intended to hold  *
-- * IEEE754 double precision floating point numbers.                         *
-- * Standard encoding rules (e.g. DER, BER, UPER etc.) do not allow for the  *
-- * IEEE754 formats to be used, and so this OCTET STRING is intended to hold *
-- * the IEEE754 encodings. Implementers of this specification are required   *
-- * to use their own functions to encode/decode the IEEE754 values that will *
-- * populate this OCTET STRING.                                              *
-- ****************************************************************************
IEEE754Dp ::=               OCTET STRING (SIZE(8))

-- Constants defined to aid padding, which is used to align byte and multiple
-- byte parameters on word boundaries for ease of decoding.
Pad1bits ::=                INTEGER (0..1)
Pad2bits ::=                INTEGER (0..3)
Pad3bits ::=                INTEGER (0..7)
Pad4bits ::=                INTEGER (0..15)
Pad5bits ::=                INTEGER (0..31)
Pad6bits ::=                INTEGER (0..63)
Pad7bits ::=                INTEGER (0..127)
Pad8bits ::=                INTEGER (0..255)
Pad9bits ::=                INTEGER (0..511)
Pad10bits ::=               INTEGER (0..1023)
Pad11bits ::=               INTEGER (0..2047)
Pad12bits ::=               INTEGER (0..4095)
Pad13bits ::=               INTEGER (0..8191)
Pad14bits ::=               INTEGER (0..16383)
Pad15bits ::=               INTEGER (0..32767)
Pad16bits ::=               INTEGER (0..65535)
Pad17bits ::=               INTEGER (0..131071)
Pad18bits ::=               INTEGER (0..262143)
Pad19bits ::=               INTEGER (0..524287)
Pad24bits ::=               INTEGER (0..16777215)
Pad25bits ::=               INTEGER (0..33554431)

