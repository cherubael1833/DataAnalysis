Unsigned20 ::=              INTEGER (0..1048575)
Unsigned21 ::=              INTEGER (0..2097151)
Unsigned24 ::=              INTEGER (0..16777215)
Unsigned32 ::=              INTEGER (0..4294967295)
Unsigned33 ::=              INTEGER (0..8589934591)
Signed3 ::=                 INTEGER (-4..3)
