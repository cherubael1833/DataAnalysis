-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 10 - Provides degradation factors.                     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS10Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    pBrrc                           IEEE754Sp,                  -- metres
    pCltclsb                        IEEE754Sp,                  -- metres
    pCltcv1                         IEEE754Sp,                  -- metres/second
    pIltcv1                         IEEE754Sp,                  -- seconds
    pCltcv0                         IEEE754Sp,                  -- metres
    pIltcv0                         IEEE754Sp,                  -- seconds
    pCgeolsb                        IEEE754Sp,                  -- metres
    pCgeov                          IEEE754Sp,                  -- metres/second
    pIgeo                           IEEE754Sp,                  -- seconds
    pCer                            IEEE754Sp,                  -- metres
    pCionostep                      IEEE754Sp,                  -- metres
    pIiono                          IEEE754Sp,                  -- seconds
    pCionoramp                      IEEE754Sp,                  -- metres/second
    pCcovariance                    IEEE754Sp,                  -- unitless
    pRSSUDRE                        BOOLEAN,                    -- unitless
    pRSSiono                        BOOLEAN,                    -- unitless
    wordPadding1                    Pad14bits,
    spare80                         OCTET STRING (SIZE(10)),    -- spare 80 bits
    spare1                          Unsigned1,                  -- spare bit
    wordPadding2                    Pad15bits
}


-- ****************************************************************************
-- * SBAS Message Type 12 - Unscaled SBAS Network Time/UTC/GLONASS Offset     *
-- *                                                                          *
-- * Message name:    DataSBAS12Unscaled                                      *
-- * Message ID:      6385                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 12 - SBAS Network time offset to UTC/GLONASS.          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS12Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    pA1SNT                          Signed24,                   -- 2^-50 seconds/second - first order term of polynomial
    pA0SNT                          Signed32,                   -- 2^-30 seconds - constant term of polynomial
    ptot                            Unsigned8,                  -- 2^12 seconds - UTC reference time
    pWNt                            Unsigned8,                  -- weeks - UTC reference week number
    pDeltatLS                       Signed8,                    -- seconds - delta time due to leap seconds
    pWNLSF                          Unsigned8,                  -- weeks - week number the leap second becomes effective
    pDN                             Unsigned8,                  -- days - day the leap second becomes effective
    pDeltatLSF                      Signed8,                    -- seconds - delta time due to leap seconds
    pUTCID                          Unsigned3,                  -- UTC Standard Identifier
    pGPSToW                         Unsigned20,                 -- seconds - GPS Time of Week
    pGPSWN                          Unsigned10,                 -- weeks - GPS Week Number
    pGLONASSIndicator               Unsigned1,                  -- unitless
    pGLONASSTimeOffset              SEQUENCE (SIZE(5)) OF Unsigned16,   -- reserved in least significant 74 bits
    wordPadding1                    Pad6bits
}


-- ****************************************************************************
-- * SBAS Message Type 12 - Scaled SBAS Network Time/UTC/GLONASS Offset       *
-- *                                                                          *
-- * Message name:    DataSBAS12Scaled                                        *
-- * Message ID:      6286                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 12 - SBAS Network time offset to UTC/GLONASS.          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS12Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    pA1SNT                          IEEE754Sp,                  -- seconds/second - first order term of polynomial
    pA0SNT                          IEEE754Dp,                  -- seconds - constant term of polynomial
    wordPadding1                    Pad12bits,
    ptot                            INTEGER (0..602112),        -- seconds - UTC reference time
    pWNt                            INTEGER (0..255),           -- weeks - UTC reference week number
    pDeltatLS                       INTEGER (-128..127),        -- seconds - delta time due to leap seconds
    pWNLSF                          INTEGER (0..255),           -- weeks - week number the leap second becomes effective
    wordPadding2                    Pad5bits,
    pDN                             INTEGER (1..7),             -- days - day the leap second becomes effective
    pDeltatLSF                      INTEGER (-128..127),        -- seconds - delta time due to leap seconds
    wordPadding3                    Pad5bits,
    pUTCID                          INTEGER (0..7),             -- UTC Standard Identifier
    wordPadding4                    Pad12bits,
    pGPSToW                         INTEGER (0..604799),        -- seconds - GPS Time of Week
    wordPadding5                    Pad6bits,
    pGPSWN                          INTEGER (0..1023),          -- weeks - GPS Week Number
    wordPadding6                    Pad15bits,
    pGLONASSIndicator               INTEGER (0..1),             -- unitless
    pGLONASSTimeOffset              SEQUENCE (SIZE(5)) OF Unsigned16    -- reserved in least significant 74 bits
}


-- ****************************************************************************
-- * SBAS Message Type 17 - Unscaled Almanac                                  *
-- *                                                                          *
-- * Message name:    DataSBAS17Unscaled                                      *
-- * Message ID:      6310                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 17 - This message contains the unscaled almanac        *
-- * parameters received from the tracked SBAS satellites.                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The signal ID refers to where the message has come from.                 *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS17Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to report almanac
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    dataSource                      DataSource,
    signalID                        SBASMultiSignalID,
    wordPadding                     Pad10bits,
    sbasSatUnscaledAlmanacs SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        timeOfDay                       Unsigned11,             -- 64 seconds
        dataID                          Unsigned2,              -- unitless
        prnNumber                       Unsigned8,              -- unitless
        healthAndStatus                 Unsigned8,              -- unitless
        xG                              Signed15,               -- 2,600 metres
        yG                              Signed15,               -- 2,600 metres
        zG                              Signed9,                -- 26,000 metres
        xGdot                           Signed3,                -- 10 metres/second
        yGdot                           Signed3,                -- 10 metres/second
        zGdot                           Signed4,                -- 60 metres/second
        wordPadding                     Pad2bits
    }
}


-- ****************************************************************************
-- * SBAS Message Type 17 - Scaled Almanac                                    *
-- *                                                                          *
-- * Message name:    DataSBAS17Scaled                                        *
-- * Message ID:      6337                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 17 - This message contains the scaled almanac          *
-- * parameters received from the tracked SBAS satellites.                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The signal ID refers to where the message has come from.                 *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS17Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to report almanac
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    dataSource                      DataSource,
    signalID                        SBASMultiSignalID,
    wordPadding                     Pad10bits,
    sbasSatScaledAlmanacs SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        timeOfDay                       IEEE754Sp,              -- seconds
        wordPadding                     Pad8bits,
        dataID                          Unsigned8,              -- unitless
        wordPadding1                    Pad8bits,
        prnNumber                       Unsigned8,              -- unitless
        wordPadding2                    Pad8bits,
        healthAndStatus                 Unsigned8,              -- unitless
        xG                              IEEE754Sp,              -- metres
        yG                              IEEE754Sp,              -- metres
        zG                              IEEE754Sp,              -- metres
        xGdot                           IEEE754Sp,              -- metres/second
        yGdot                           IEEE754Sp,              -- metres/second
        zGdot                           IEEE754Sp               -- metres/second
    }
}


-- ****************************************************************************
-- * SBAS Message Type 18 - Unscaled Iono Corrections - IGP Mask              *
-- *                                                                          *
-- * Message name:    DataSBAS18Unscaled                                      *
-- * Message ID:      6387                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 18 - This message contains the broadcast unscaled      *
-- * ionospheric correction factors received from a single tracked SBAS       *
-- * satellite.                                                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS18Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    nBands                          Unsigned4,              -- unitless (0-11)
    bandNumber                      Unsigned4,              -- unitless (0-10)
    iodi                            Unsigned2,              -- unitless (0-3)
    igpMask                         BIT STRING (SIZE(201)), -- unitless
    spare                           BIT STRING (SIZE(1)),
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 18 - Scaled Iono Corrections - IGP Mask                *
-- *                                                                          *
-- * Message name:    DataSBAS18Scaled                                        *
-- * Message ID:      6357                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 18 - This message contains the broadcast scaled        *
-- * ionospheric correction factors received from a single tracked SBAS       *
-- * satellite.                                                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS18Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    nBands                          Unsigned8,              -- unitless (0-11)
    bandNumber                      Unsigned8,              -- unitless (0-10)
    wordPadding1                    Pad8bits,
    iodi                            Unsigned8,              -- unitless (0-3)
    igpMask                         SEQUENCE (SIZE(13)) OF Unsigned16 -- unitless - mask is in the 201 least significant bits
}


-- ****************************************************************************
-- * SBAS Message Type 24 - Unscaled Mixed Fast/Long Term Error Corrections   *
-- *                                                                          *
-- * Message name:    DataSBAS24Unscaled                                      *
-- * Message ID:      6399                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 24 - Provides Mixed Fast Corrections and Long Term     *
-- * Satellite Error Corrections.                                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS24Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    prcF                            SEQUENCE (SIZE(6)) OF Signed12,     -- 0.125 metres
    udrei                           SEQUENCE (SIZE(6)) OF Unsigned4,    -- UDRE Indicators
    iodP                            Unsigned2,                  -- IOD PRN
    blockID                         Unsigned2,                  -- Block ID 0-3 maps to Message type ID 2-5
    iodF                            Unsigned2,                  -- IOD Fast
    spare                           Unsigned4,
    longTermCorrection              SBASUnscaledLongTermCorrection,
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 24 - Scaled Mixed Fast/Long Term Error Corrections     *
-- *                                                                          *
-- * Message name:    DataSBAS24Scaled                                        *
-- * Message ID:      6303                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 24 - Provides Mixed Fast Corrections and Long Term     *
-- * Satellite Error Corrections.                                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS24Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    wordPadding1                    Pad6bits,
    iodP                            INTEGER (0..3),             -- IOD PRN
    wordPadding2                    Pad6bits,
    blockID                         INTEGER (0..3),             -- Block ID 0-3 maps to Message type ID 2-5
    wordPadding3                    Pad6bits,
    iodF                            INTEGER (0..3),             -- IOD Fast
    wordPadding4                    Pad8bits,
    prcF                            SEQUENCE (SIZE(6)) OF IEEE754Sp,    -- metres
    udrei                           SEQUENCE (SIZE(6)) OF SEQUENCE {
        wordPadding                     Pad4bits,
        udrei                           INTEGER (0..15)             -- UDRE Indicators
    },
    wordPadding5                    Pad15bits,
    longTermCorrection              SBASScaledLongTermCorrection
}


-- ****************************************************************************
-- * SBAS Message Type 25 - Unscaled Long Term Satellite Error Corrections    *
-- *                                                                          *
-- * Message name:    DataSBAS25Unscaled                                      *
-- * Message ID:      6360                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 25 - Provides Long Term Satellite Error Corrections.   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS25Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    longTermCorrections             SEQUENCE (SIZE(2)) OF SBASUnscaledLongTermCorrection,
    wordPadding1                    Pad12bits
}

-- Comment states value of least significant bit, if not 1, and units.
SBASUnscaledLongTermCorrection ::= CHOICE {
    velCode0Message                 SEQUENCE {
        deltas                          SEQUENCE (SIZE(2)) OF SEQUENCE {
            prnMask                         Unsigned6,                  -- PRN Mask Number
            iod                             Unsigned8,                  -- Issue of Data
            deltax                          Signed9,                    -- 0.125 metres
            deltay                          Signed9,                    -- 0.125 metres
            deltaz                          Signed9,                    -- 0.125 metres
            deltaaf0                        Signed10                    -- 2^-31 seconds
            },
        iodP                            Unsigned2,                  -- Issue of Data PRN
        spare                           Unsigned1
    },
    velCode1Message                 SEQUENCE {
        prnMask                         Unsigned6,                  -- PRN Mask Number
        iod                             Unsigned8,                  -- Issue of Data
        deltax                          Signed11,                   -- 0.125 metres
        deltay                          Signed11,                   -- 0.125 metres
        deltaz                          Signed11,                   -- 0.125 metres
        deltaaf0                        Signed11,                   -- 2^-31 seconds
        deltaxdot                       Signed8,                    -- 2^-11 metres/second
        deltaydot                       Signed8,                    -- 2^-11 metres/second
        deltazdot                       Signed8,                    -- 2^-11 metres/second
        deltaaf1                        Signed8,                    -- 2^-39 seconds/second
        toda                            Signed13,                   -- 16 seconds
        iodP                            Unsigned2                   -- Issue of Data PRN
    }
}


-- ****************************************************************************
-- * SBAS Message Type 25 - Scaled Long Term Satellite Error Corrections      *
-- *                                                                          *
-- * Message name:    DataSBAS25Scaled                                        *
-- * Message ID:      6441                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 25 - Provides Long Term Satellite Error Corrections.   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS25Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    longTermCorrections             SEQUENCE (SIZE(2)) OF SEQUENCE {
        wordPadding                     Pad15bits,
        longTermCorrection              SBASScaledLongTermCorrection
    }
}

SBASScaledLongTermCorrection ::= CHOICE {
    velCode0Message                 SEQUENCE {
        deltas                          SEQUENCE (SIZE(2)) OF SEQUENCE {
            wordPadding                     Pad2bits,
            prnMask                         Unsigned6,                  -- PRN Mask Number
            iod                             Unsigned8,                  -- Issue of Data
            deltax                          IEEE754Sp,                  -- metres
            deltay                          IEEE754Sp,                  -- metres
            deltaz                          IEEE754Sp,                  -- metres
            deltaaf0                        IEEE754Sp                   -- seconds
            },
        wordPadding                     Pad6bits,
        iodP                            Unsigned2,                  -- Issue of Data PRN
        wordPadding1                    Pad7bits,
        spare                           Unsigned1
    },
    velCode1Message                 SEQUENCE {
        wordPadding                     Pad2bits,
        prnMask                         Unsigned6,                  -- PRN Mask Number
        iod                             Unsigned8,                  -- Issue of Data
        deltax                          IEEE754Sp,                  -- metres
        deltay                          IEEE754Sp,                  -- metres
        deltaz                          IEEE754Sp,                  -- metres
        deltaaf0                        IEEE754Sp,                  -- seconds
        deltaxdot                       IEEE754Sp,                  -- metres/second
        deltaydot                       IEEE754Sp,                  -- metres/second
        deltazdot                       IEEE754Sp,                  -- metres/second
        deltaaf1                        IEEE754Sp,                  -- seconds/second
        toda                            IEEE754Sp,                  -- seconds
        wordPadding1                    Pad14bits,
        iodP                            Unsigned2                   -- Issue of Data PRN
    }
}


-- ****************************************************************************
-- * SBAS Message Type 26 - Unscaled Ionospheric Delay Corrections            *
-- *                                                                          *
-- * Message name:    DataSBAS26Unscaled                                      *
-- * Message ID:      6409                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 26 - This message contains the broadcast unscaled      *
-- * ionospheric correction factors received from a single tracked SBAS       *
-- * satellite.                                                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS26Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    bandNumber                      Unsigned4,              -- unitless (0-10)
    blockID                         Unsigned4,              -- unitless (0-13)
    igpBlock                        SEQUENCE (SIZE(15)) OF SEQUENCE {
        igpVDE                          Unsigned9,              -- 0.125 metres
        igpGIVEI                        Unsigned4               -- unitless
    },
    iodi                            Unsigned2,              -- unitless (0-3)
    spare                           BIT STRING (SIZE(7)),
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 26 - Scaled Ionospheric Delay Corrections              *
-- *                                                                          *
-- * Message name:    DataSBAS26Scaled                                        *
-- * Message ID:      6379                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 26 - This message contains the broadcast scaled        *
-- * ionospheric correction factors received from a single tracked SBAS       *
-- * satellite.                                                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS26Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    bandNumber                      Unsigned8,              -- unitless (0-10)
    blockID                         Unsigned8,              -- unitless (0-13)
    igpBlock                        SEQUENCE (SIZE(15)) OF SEQUENCE {
        igpVDE                          IEEE754Sp,              -- metres
        igpGIVEI                        Unsigned16              -- unitless
    },
    iodi                            Unsigned8,              -- unitless (0-3)
    wordPadding1                    Pad1bits,
    spare                           Unsigned7
}


-- ****************************************************************************
-- * SBAS Message Type 27 - Service Message                                   *
-- *                                                                          *
-- * Message name:    DataSBAS27Unscaled                                      *
-- * Message ID:      6431                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 27 - Provides SBAS Service Messages.                   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS27Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    iods                            Unsigned3,              -- Issue of Data Service
    msgCount                        Unsigned3,              -- Number of service messages
    msgNumber                       Unsigned3,              -- Service message number
    regionCount                     Unsigned3,              -- Number of regions
    priorityCode                    Unsigned2,
    deltaUDREInside                 Unsigned4,              -- Delta UDRE Inside
    deltaUDREOutside                Unsigned4,              -- Delta UDRE Outside
    regions                         SEQUENCE (SIZE(5)) OF SEQUENCE {
        c1Lat                           Signed8,                -- Coordinate 1 latitude degrees
        c1Lon                           Signed9,                -- Coordinate 1 longitude degrees
        c2Lat                           Signed8,                -- Coordinate 2 latitude degrees
        c2Lon                           Signed9,                -- Coordinate 2 longitude degrees
        shape                           Unsigned1
    },
    spare                           Unsigned15,
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 27 - Service Message                                   *
-- *                                                                          *
-- * Message name:    DataSBAS27Scaled                                        *
-- * Message ID:      6347                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 27 - Provides SBAS Service Messages.                   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS27Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    wordPadding1                    Pad5bits,
    iods                            Unsigned3,              -- Issue of Data Service
    wordPadding2                    Pad5bits,
    msgCount                        Unsigned3,              -- Number of service messages
    wordPadding3                    Pad5bits,
    msgNumber                       Unsigned3,              -- Service message number
    wordPadding4                    Pad5bits,
    regionCount                     Unsigned3,              -- Number of regions
    wordPadding5                    Pad6bits,
    priorityCode                    Unsigned2,
    wordPadding6                    Pad4bits,
    deltaUDREInside                 Unsigned4,              -- Delta UDRE Inside
    wordPadding7                    Pad4bits,
    deltaUDREOutside                Unsigned4,              -- Delta UDRE Outside
    wordPadding8                    Pad8bits,
    regions                         SEQUENCE (SIZE(5)) OF SEQUENCE {
        wordPadding                     Pad8bits,
        c1Lat                           INTEGER (-90..90),      -- Coordinate 1 latitude degrees
        wordPadding1                    Pad7bits,
        c1Lon                           INTEGER (-180..180),    -- Coordinate 1 longitude degrees
        wordPadding2                    Pad8bits,
        c2Lat                           INTEGER (-90..90),      -- Coordinate 2 latitude degrees
        wordPadding3                    Pad7bits,
        c2Lon                           INTEGER (-180..180),    -- Coordinate 2 longitude degrees
        wordPadding4                    Pad15bits,
        shape                           Unsigned1
    },
    wordPadding9                    Pad1bits,
    spare                           Unsigned15
}


-- ****************************************************************************
-- * SBAS Message Type 28 - Clock-Ephemeris Covariance Matrix                 *
-- *                                                                          *
-- * Message name:    DataSBAS28Unscaled                                      *
-- * Message ID:      6334                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 28 - Provides SBAS Clock-Ephemeris Covariance Matrix.  *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS28Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    iodP                            Unsigned2,              -- IOD PRN
    satelliteMatrix                 SEQUENCE (SIZE(2)) OF SEQUENCE {
        prnMask                         Unsigned6,              -- PRN Mask Number
        scaleExponent                   Unsigned3,              -- Scale exponent
        e11                             Unsigned9,              -- unitless
        e22                             Unsigned9,              -- unitless
        e33                             Unsigned9,              -- unitless
        e44                             Unsigned9,              -- unitless
        e12                             Unsigned10,             -- unitless
        e13                             Unsigned10,             -- unitless
        e14                             Unsigned10,             -- unitless
        e23                             Unsigned10,             -- unitless
        e24                             Unsigned10,             -- unitless
        e34                             Unsigned10              -- unitless
    },
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 28 - Clock-Ephemeris Covariance Matrix                 *
-- *                                                                          *
-- * Message name:    DataSBAS28Scaled                                        *
-- * Message ID:      6369                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 28 - Provides SBAS Clock-Ephemeris Covariance Matrix.  *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS28Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    wordPadding1                    Pad14bits,
    iodP                            INTEGER (0..3),         -- IOD PRN
    satelliteMatrix                 SEQUENCE (SIZE(2)) OF SEQUENCE {
        wordPadding                     Pad10bits,
        prnMask                         INTEGER (0..51),        -- PRN Mask Number
        wordPadding1                    Pad13bits,
        scaleExponent                   INTEGER (0..7),         -- Scale exponent
        wordPadding2                    Pad7bits,
        e11                             INTEGER (0..511),       -- unitless
        wordPadding3                    Pad7bits,
        e22                             INTEGER (0..511),       -- unitless
        wordPadding4                    Pad7bits,
        e33                             INTEGER (0..511),       -- unitless
        wordPadding5                    Pad7bits,
        e44                             INTEGER (0..511),       -- unitless
        wordPadding6                    Pad6bits,
        e12                             INTEGER (-512..511),    -- unitless
        wordPadding7                    Pad6bits,
        e13                             INTEGER (-512..511),    -- unitless
        wordPadding8                    Pad6bits,
        e14                             INTEGER (-512..511),    -- unitless
        wordPadding9                    Pad6bits,
        e23                             INTEGER (-512..511),    -- unitless
        wordPadding10                   Pad6bits,
        e24                             INTEGER (-512..511),    -- unitless
        wordPadding11                   Pad6bits,
        e34                             INTEGER (-512..511)     -- unitless
    }
}


-- ****************************************************************************
-- * UTC Corrections Messages                                                 *
-- *                                                                          *
-- * Message name:    DataUTCCorrections                                      *
-- * Message ID:      6421                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast UTC correction factors received from *
-- * a single tracked GPS or Galileo satellite.                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The GPS and Galileo UTC Correction Parameters can be consolidated        *
-- * together.                                                                *
-- *                                                                          *
-- * Note, the 2nd order term of the polynomial A2 is only available from the *
-- * GPS CNAV/CNAV2 transmissions.                                            *
-- *                                                                          *
-- * Note that A2 is set to 0 if it is not present in the broadcast signal.   *
-- *                                                                          *
-- ****************************************************************************
--
DataUTCCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    signal                          SignalID,
    satID                           SatID,
    a0                              IEEE754Dp,              -- seconds
    a1                              IEEE754Sp,              -- seconds/second
    wordPadding                     Pad8bits,
    deltaTLS                        Signed8,                -- seconds: Leap second count before leap second adjustment
    wordPadding1                    Pad12bits,
    utcDataReferenceTimeOfWeek      INTEGER (0..1048560),   -- seconds of week
    utcDataReferenceWeekNumber      Unsigned8,              -- weeks
    weekNumberOfLeapSecAdjustment   Unsigned8,              -- weeks
    deltaTLSF                       Signed8,                -- seconds: Leap second count after leap second adjustment
    wordPadding2                    Pad5bits,
    -- dayNumber: Day number at the end of which a leap second adjustment becomes effective.
    -- 0 is not valid; the broadcast day number will be in the range 1..7.
    dayNumber                       INTEGER (0..7),
    a2                              IEEE754Sp               -- seconds/second/second
}


-- ****************************************************************************
-- * Waypoint Information                                                     *
-- *                                                                          *
-- * Message name:    DataWaypointInfo                                        *
-- * Message ID:      6445                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       Once (per request)                                      *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message allows the waypoint information to be set or output.        *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * WaypointID 0 is special, meaning current waypoint, or all waypoints,     *
-- * depending on context, and should not be used here.                       *
-- *                                                                          *
-- ****************************************************************************
--
DataWaypointInfo ::= SEQUENCE {
    numberOfMessages                Unsigned8,              -- Number of messages to be sent (N)
    messageNumber                   Unsigned8,              -- Number of message (0 to N-1)
    wordPadding                     Pad6bits,
    waypointInfo                    SEQUENCE (SIZE(0..1023)) OF SEQUENCE {
        waypointID                      WaypointID,             -- WaypointID 0 is not a real waypoint and is not valid here
        position                        Position
    }
}


-- ****************************************************************************
-- * Route Information                                                        *
-- *                                                                          *
-- * Message name:    DataRouteInfo                                           *
-- * Message ID:      6325                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       Once (per request)                                      *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message allows the route information to be set or output.           *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * RouteID 0 is special, meaning current route, or all routes, depending    *
-- * on context, and should not be used here.                                 *
-- *                                                                          *
-- * WaypointID 0 is special, meaning current waypoint, or all waypoints,     *
-- * depending on context, and should not be used here.                       *
-- *                                                                          *
-- ****************************************************************************
--
DataRouteInfo ::= SEQUENCE {
    numberOfMessages                Unsigned8,              -- Number of messages to be sent (N)
    messageNumber                   Unsigned8,              -- Number of message (0 to N-1)
    routeID                         RouteID,
    wordPadding                     Pad6bits,
    waypointsInRoute                SEQUENCE (SIZE(0..1023)) OF WaypointID  -- WaypointID 0 is not a real waypoint and is not valid here
}


-- ****************************************************************************
-- * Route Waypoint Navigation                                                *
-- *                                                                          *
-- * Message name:    DataRouteWaypointNav                                    *
-- * Message ID:      6410                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message supports navigation between waypoints (for both route and   *
-- * waypoint navigation).                                                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * For the case of 'waypoint' navigation, a single WaypointID is provided   *
-- * (toWaypoint).                                                            *
-- *                                                                          *
-- ****************************************************************************
--
DataRouteWaypointNav ::= SEQUENCE {
    validityTime                    TimeStamp,
    applicableRouteID               RouteID,                -- A RouteID, or 0 to indicate waypoint navigation.
    navigateToWaypoint              WaypointIndex,          -- Route waypoint index, or 0 if this is waypoint navigation.
    navigateFromWaypoint            WaypointIndex,          -- Route waypoint index, or 0 if this is waypoint navigation.
    fixStatus                       FixStatus,
    positionFigureOfMerit           PositionFigureOfMerit,
    magneticCorrectionSource        MagneticVariationSource,
    qFlag                           QFlag,
    fixAided                        BOOLEAN,
    useVerticalGuidance             BOOLEAN,
    wordPadding                     Pad1bits,
    toWaypoint                      ToWaypoint,             -- information for the next waypoint
    fromWaypoint                    FromWaypoint,           -- valid only if navigateFromWaypoint field is not set to 0.
    endWaypoint                     EndWaypoint             -- same as toWaypoint for waypoint navigation or the final waypoint for route navigation
}

EndWaypoint ::= SEQUENCE {
    waypointID                      WaypointID,
    waypointPosition                Position,
    distanceToWaypoint              IEEE754Sp,              -- metres (via any intermediary waypoints using great circle routes)
    timeToWaypoint                  IEEE754Sp,              -- seconds (via any intermediary waypoints using great circle routes)
    trackToWaypoint                 AngularDir              -- track bearing and reference
}

ToWaypoint ::= SEQUENCE {
    waypointID                      WaypointID,
    waypointPosition                Position,
    distanceToWaypoint              IEEE754Sp,              -- metres
    timeToWaypoint                  IEEE754Sp,              -- seconds
    trackToWaypoint                 AngularDir,             -- track bearing and reference
    verticalSlantAngleToWaypoint    IEEE754Sp,              -- degrees (-90.0 <= value <= +90.0)
    climbRateToWaypoint             IEEE754Sp               -- metres/second
}

FromWaypoint ::= SEQUENCE {
    waypointID                      WaypointID,
    waypointPosition                Position,
    distanceFromWaypoint            IEEE754Sp,              -- metres
    trackFromWaypoint               AngularDir,             -- track bearing and reference
    verticalSlantAngleFromWaypoint  IEEE754Sp               -- degrees (-90.0 <= value <= +90.0)
}


-- ****************************************************************************
-- * Waypoint Reached Alert                                                   *
-- *                                                                          *
-- * Message name:    DataWaypointReachedAlert                                *
-- * Message ID:      6263                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides an alert when a waypoint is reached.               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataWaypointReachedAlert ::= SEQUENCE {
    validityTime                    TimeStamp,
    applicableRouteID               RouteID,                -- RouteID will be 0 if this is a waypoint only alert.
    waypointIndexReached            WaypointIndex,          -- Index will be 0 if not navigating a route.
    waypointIDReached               WaypointID
}


-- ****************************************************************************
-- * Provides Position Relative to a Waypoint Reference                       *
-- *                                                                          *
-- * Message name:    DataRelativePosition                                    *
-- * Message ID:      6308                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides relative navigation (also known as 'Bullseye       *
-- * Navigation') by reporting current distance and bearing from a reference  *
-- * position waypoint 'Bullseye' set with CmndSelectReferenceWaypoint.       *
-- *                                                                          *
-- * Notes:                                                                   *
-- * Set the required waypoint number using CmndSelectReferenceWaypoint prior *
-- * to connecting to this message.                                           *
-- *                                                                          *
-- ****************************************************************************
--
DataRelativePosition ::= SEQUENCE {
    validityTime                    TimeStamp,
    fixStatus                       FixStatus,
    positionFigureOfMerit           PositionFigureOfMerit,
    magneticCorrectionSource        MagneticVariationSource,
    qFlag                           QFlag,
    fixAided                        BOOLEAN,
    useVerticalGuidance             BOOLEAN,
    wordPadding                     Pad1bits,
    referenceID                     WaypointID,
    referencePosition               Position,               -- 'Bullseye' location
    distanceFromReference           IEEE754Sp,              -- metres
    trackFromReference              AngularDir,             -- track bearing and reference
    verticalSlantAngleFromReference IEEE754Sp               -- degrees (-90.0 <= value <= +90.0)
}


-- ****************************************************************************
-- * Datum Information                                                        *
-- *                                                                          *
-- * Message name:    DataDatumInfo                                           *
-- * Message ID:      6446                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message allows the datum transformation parameters for              *
-- * transformations from alternative datums to the WGS-84 datum to be output *
-- * and input. Only the user defined datums can be set or read.              *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Only those datums specified as user defined datums may have their        *
-- * parameters set by the user.                                              *
-- *                                                                          *
-- * The parameters set should be for transformation FROM the user defined    *
-- * datum to WGS-84 and should follow the sign conventions outlined in NATO  *
-- * STANAG 2211.                                                             *
-- *                                                                          *
-- ****************************************************************************
--
DataDatumInfo ::= SEQUENCE {
    wordPadding                     Pad12bits,
    datumInfo                       SEQUENCE (SIZE(0..10)) OF SEQUENCE {
        datumID                         DatumID,            -- A user defined datum (see DatumID user0 to user9)
        a                               IEEE754Dp,          -- Length of semi-major axis of the ellipsoid (in metres)
        e2                              IEEE754Dp,          -- Square of the eccentricity of the ellipsoid
        dx                              IEEE754Sp,          -- Shift in X-coordinate (in metres)
        dy                              IEEE754Sp,          -- Shift in Y-coordinate (in metres)
        dz                              IEEE754Sp,          -- Shift in Z-coordinate (in metres)
        ds                              IEEE754Sp,          -- Scale change (ppm)
        rx                              IEEE754Sp,          -- Rotation about X-axis (in arcseconds)
        ry                              IEEE754Sp,          -- Rotation about Y-axis (in arcseconds)
        rz                              IEEE754Sp,          -- Rotation about Z-axis (in arcseconds)
        transformationAccuracyValid     BOOLEAN,
        wordPadding                     Pad7bits,
        accuracyX                       Unsigned8,          -- metres (1 sigma accuracy)
        accuracyY                       Unsigned8,          -- metres (1 sigma accuracy)
        accuracyZ                       Unsigned8           -- metres (1 sigma accuracy)
    }
}


-- ****************************************************************************
-- * Atmospheric Corrections                                                  *
-- *                                                                          *
-- * Message name:    DataAtmosphericCorrections                              *
-- * Message ID:      6401                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * The atmospheric corrections message returns information about the        *
-- * methods used to correct for atmospheric delays and the correction        *
-- * values themselves.                                                       *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Ionospheric correction is frequency dependant, the value given is        *
-- * referenced to the signal indicated by SignalID. The user can scale this  *
-- * value to other frequencies to find the correction applied to other       *
-- * signals.                                                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataAtmosphericCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    atmosphericCorrectionInfos      AtmosphericCorrectionInfos
}

AtmosphericCorrectionInfos ::= SEQUENCE {
    atmosphericCorrectionInfos      SEQUENCE (SIZE(0..65535)) OF SEQUENCE {
        signalID                        SignalID,
        satID                           SatID,
        wordPadding                     Pad4bits,
        ionoCorrectionInUse             IonoCorrection,
        wordPadding1                    Pad4bits,
        tropoCorrectionInUse            TropoCorrection,
        ionoCorrection                  IEEE754Sp,              -- metres
        tropoCorrection                 IEEE754Sp               -- metres
    }
}


-- ****************************************************************************
-- * Receiver Clock Bias Message                                              *
-- *                                                                          *
-- * Message name:    DataRxClockBias                                         *
-- * Message ID:      6266                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides information about the receiver clock bias and      *
-- * drift with respect to the given biasTimeRef.                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- * A positive rxClockBias value means the rxClock is ahead of the given     *
-- * biasTimeRef.                                                             *
-- *                                                                          *
-- * In some scenarios the clock bias/drift reported may be with respect to a *
-- * different time reference than validityTime. It is therefore important to *
-- * note the time reference indicated by biasTimeRef.                        *
-- *                                                                          *
-- ****************************************************************************
--
DataRxClockBias ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad4bits,
    fixStatus                       FixStatus,
    wordPadding1                    Pad4bits,
    timeFigureOfMerit               TimeFigureOfMerit,
    wordPadding2                    Pad12bits,
    biasTimeRef                     TimeReference,
    rxClockBias                     IEEE754Dp,              -- seconds - see Notes for the sense
    rxClockDrift                    IEEE754Sp               -- seconds/second
}


-- ****************************************************************************
-- * User Messages                                                            *
-- *                                                                          *
-- * Message name:    DataUserMessages                                        *
-- * Message ID:      6353                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * Returns the 'User Messages' encoded in the NAV data.                     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * For GPS LNAV the 'special' message, from subframe 4, page 17, consists   *
-- * of 22 octets, from a limited character set (see IS-GPS-200).             *
-- *                                                                          *
-- * For GPS CNAV the type 36 and 15 'text' message consists of 18 and 29     *
-- * octets respectively, again from a limited character set (see             *
-- * IS-GPS-200).                                                             *
-- *                                                                          *
-- * For GLONASS CNAV string type 60 contains 184 bits, or 23 octets.         *
-- *                                                                          *
-- * The messageString shall be tail padded, if necessary, with a null        *
-- * (0x00) octet to form an even number of octets. The messageString is      *
-- * then sent as a sequence of octet pair words as described in the main     *
-- * document (LSB then MSB).                                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataUserMessages ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad8bits,
    userMessage                     SEQUENCE (SIZE(0..255)) OF SEQUENCE {
        gnssSignal                      SignalID,
        satID                           SatID,
        wordPadding                     Pad8bits,
        messageString                   SEQUENCE (SIZE(0..255)) OF MessageOctet
    }
}


END