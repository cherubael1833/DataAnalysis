-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
        data                            CHOICE {
            fnav                            GLOFNAVSatUnscaledAlmanacs,
            fmnav                           GLOFMNAVSatUnscaledAlmanacs,
            cnav                            GLOCNAVSatUnscaledAlmanacs,
            reserved3                       GLOCNAVSatUnscaledAlmanacs,        -- used as placeholder
            reserved4                       GLOCNAVSatUnscaledAlmanacs,        -- used as placeholder
            reserved5                       GLOCNAVSatUnscaledAlmanacs,        -- used as placeholder
            reserved6                       GLOCNAVSatUnscaledAlmanacs,        -- used as placeholder
            reserved7                       GLOCNAVSatUnscaledAlmanacs         -- used as placeholder
        }
    }
}


-- See Table 4.9, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOFNAVSatUnscaledAlmanacs ::= SEQUENCE {
    tauc                            Signed28,               -- 2^-27 seconds
    nDayA                           Unsigned11,             -- days (1-1461)
    nSatA                           Unsigned5,              -- dimensionless (1-24)
    hnA                             Unsigned5,              -- dimensionless (0-31)
    lambdaA                         Signed21,               -- 2^-20 semi-cycles
    tlambdaA                        Unsigned21,             -- 2^-5 seconds
    deltaiA                         Signed18,               -- 2^-20 semi-cycles
    deltaTA                         Signed22,               -- 2^-9 seconds per orbital period
    deltaTdotA                      Signed7,                -- 2^-14 seconds per orbital period ^ 2
    eccA                            Unsigned15,             -- 2^-20 dimensionless
    omegaA                          Signed16,               -- 2^-15 semi-cycles
    tauA                            Signed10,               -- 2^-18 seconds
    cA                              Unsigned1,              -- dimensionless (0-1)
    wordPadding                     Pad12bits
}


-- See Table 4.9, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOFMNAVSatUnscaledAlmanacs ::= SEQUENCE {
    tauc                            Signed32,               -- 2^-31 seconds
    tauGPS                          Signed22,               -- 2^-30 days
    n4                              Unsigned5,              -- 4-year interval (1-31)
    nDayA                           Unsigned11,             -- days (1-1461)
    nSatA                           Unsigned5,              -- dimensionless (1-24)
    hnA                             Unsigned5,              -- dimensionless (0-31)
    lambdaA                         Signed21,               -- 2^-20 semi-cycles
    tlambdaA                        Unsigned21,             -- 2^-5 seconds
    deltaiA                         Signed18,               -- 2^-20 semi-cycles
    deltaTA                         Signed22,               -- 2^-9 seconds per orbital period
    deltaTdotA                      Signed7,                -- 2^-14 seconds per orbital period ^ 2
    eccA                            Unsigned15,             -- 2^-20 dimensionless
    omegaA                          Signed16,               -- 2^-15 semi-cycles
    mA                              Unsigned2,              -- dimensionless
    b1                              Signed11,               -- 2^-10 seconds
    b2                              Signed10,               -- 2^-16 seconds/msd
    kp                              Unsigned2,              -- dimensionless
    tauA                            Signed10,               -- 2^-18 seconds
    cA                              Unsigned1,              -- dimensionless (0-1)
    wordPadding                     Pad4bits
}

-- See string Type 20, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOCNAVSatUnscaledAlmanacs ::= SEQUENCE {
    jA                              Unsigned6,              -- SVN (0-63)
    to                              Unsigned2,              -- Orbit type (00)
    nS                              Unsigned6,              -- dimensionless (0-63)
    eA                              Unsigned6,              -- days (0-63)
    nDayA                           Unsigned11,             -- days (1-1461)
    srA                             Unsigned5,              -- dimensionless
    mA                              Unsigned3,              -- dimensionless
    tauA                            Signed14,               -- 2^-20 seconds
    lambdaA                         Signed21,               -- 2^-20 half-cycles
    tlambdaA                        Unsigned21,             -- 2^-5 seconds
    deltaiA                         Signed15,               -- 2^-20 half-cycles
    eccA                            Unsigned15,             -- 2^-20 dimensionless
    omegaA                          Signed16,               -- 2^-15 half-cycles
    deltaTA                         Signed19,               -- 2^-9 seconds
    deltaTdotA                      Signed7,                -- 2^-14 seconds per orbit
    wordPadding                     Pad9bits
}


-- ****************************************************************************
-- * GLONASS Scaled Almanac                                                   *
-- *                                                                          *
-- * Message name:    DataGLOScaledAlmanac                                    *
-- * Message ID:      6398                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the scaled almanac parameters received from the    *
-- * tracked GLONASS satellites.                                              *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Note that the signal ID refers to where the message has come from.       *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * GLONASS ICD.                                                             *
-- *                                                                          *
-- ****************************************************************************
--
DataGLOScaledAlmanac ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to report almanac
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    dataSource                      DataSource,
    signalID                        GLOMultiSignalID,
    perSatAlmanacData               GLOSatScaledAlmanacs
}

GLOSatScaledAlmanacs ::= SEQUENCE {
    wordPadding                     Pad10bits,
    gloSatScaledAlmanacs SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        wordPadding                     Pad13bits,
-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
        data                            CHOICE {
            fnav                            GLOFNAVSatScaledAlmanacs,
            fmnav                           GLOFMNAVSatScaledAlmanacs,
            cnav                            GLOCNAVSatScaledAlmanacs,
            reserved3                       GLOCNAVSatScaledAlmanacs,      -- used as placeholder
            reserved4                       GLOCNAVSatScaledAlmanacs,      -- used as placeholder
            reserved5                       GLOCNAVSatScaledAlmanacs,      -- used as placeholder
            reserved6                       GLOCNAVSatScaledAlmanacs,      -- used as placeholder
            reserved7                       GLOCNAVSatScaledAlmanacs       -- used as placeholder
        }
    }
}

-- See Table 4.9, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states units and, optionally, (expected range)
GLOFNAVSatScaledAlmanacs ::= SEQUENCE {
    tauc                            IEEE754Dp,              -- seconds
    wordPadding                     Pad5bits,
    nDayA                           INTEGER (0..1461),      -- days (1-1461)
    wordPadding1                    Pad11bits,
    nSatA                           INTEGER (0..24),        -- dimensionless (1-24)
    wordPadding2                    Pad11bits,
    hnA                             INTEGER (0..31),        -- dimensionless
    lambdaA                         IEEE754Sp,              -- semi-cycles
    tlambdaA                        IEEE754Sp,              -- seconds
    deltaiA                         IEEE754Sp,              -- semi-cycles
    deltaTA                         IEEE754Sp,              -- seconds per orbital period
    deltaTdotA                      IEEE754Sp,              -- seconds per orbital period ^ 2
    eccA                            IEEE754Sp,              -- dimensionless
    omegaA                          IEEE754Sp,              -- semi-cycles
    tauA                            IEEE754Sp,              -- seconds
    wordPadding3                    Pad15bits,
    cA                              Unsigned1               -- dimensionless (0-1)
}

-- See Table 4.9, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states units and, optionally, (expected range)
GLOFMNAVSatScaledAlmanacs ::= SEQUENCE {
    tauc                            IEEE754Dp,              -- seconds
    tauGPS                          IEEE754Sp,              -- seconds
    wordPadding                     Pad11bits,
    n4                              INTEGER (0..31),        -- 4-year interval (1-31)
    wordPadding1                    Pad5bits,
    nDayA                           INTEGER (0..1461),      -- days (1-1461)
    wordPadding2                    Pad11bits,
    nSatA                           INTEGER (0..24),        -- dimensionless (1-24)
    wordPadding3                    Pad11bits,
    hnA                             INTEGER (0..31),            -- dimensionless
    lambdaA                         IEEE754Sp,                  -- semi-cycles
    tlambdaA                        IEEE754Sp,              -- seconds
    deltaiA                         IEEE754Sp,              -- semi-cycles
    deltaTA                         IEEE754Sp,              -- seconds per orbital period
    deltaTdotA                      IEEE754Sp,              -- seconds per orbital period ^ 2
    eccA                            IEEE754Sp,              -- dimensionless
    omegaA                          IEEE754Sp,              -- semi-cycles
    b1                              IEEE754Sp,              -- seconds
    b2                              IEEE754Sp,              -- seconds/msd
    wordPadding4                    Pad6bits,
    mA                              Unsigned2,              -- dimensionless
    wordPadding5                    Pad6bits,
    kp                              Unsigned2,              -- dimensionless
    tauA                            IEEE754Sp,              -- seconds
    wordPadding6                    Pad15bits,
    cA                              Unsigned1               -- dimensionless (0-1)
}

-- See string Type 20, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states units and, optionally, (expected range)
GLOCNAVSatScaledAlmanacs ::= SEQUENCE {
    satID                           SatID,                  -- SVN
    wordPadding                     Pad6bits,
    to                              INTEGER (0..3),         -- Orbit type (00)
    wordPadding1                    Pad2bits,
    nS                              INTEGER (0..63),        -- dimensionless (0-63)
    wordPadding2                    Pad2bits,
    eA                              INTEGER (0..63),        -- days (0-63)
    wordPadding3                    Pad13bits,
    nDayA                           INTEGER (0..1461),      -- days (1-1461)
    wordPadding4                    Pad3bits,
    srA                             INTEGER (0..31),        -- dimensionless
    wordPadding5                    Pad5bits,
    mA                              INTEGER (0..7),         -- dimensionless
    tauA                            IEEE754Sp,              -- seconds
    lambdaA                         IEEE754Sp,              -- half-cycles
    tlambdaA                        IEEE754Sp,              -- seconds
    deltaiA                         IEEE754Sp,              -- half-cycles
    eccA                            IEEE754Sp,              -- dimensionless
    omegaA                          IEEE754Sp,              -- half-cycles
    deltaTA                         IEEE754Sp,              -- seconds
    deltaTdotA                      IEEE754Sp               -- seconds per orbit
}


-- Ephemeris and clock corrections  --
--
-- These messages provide the unscaled and scaled ephemeris and clock
-- corrections.
-- The GNSSs provide different information so implement on a constellation
-- by constellation basis.
--
-- ****************************************************************************
-- * GPS Unscaled Ephemeris and Clock                                         *
-- *                                                                          *
-- * Message name:    DataGPSUnscaledEphemerisAndClock                        *
-- * Message ID:      6383                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains unscaled ephemeris and clock corrections for a     *
-- * single GPS satellite.                                                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Interface Specification NAVSTAR GPS.                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataGPSUnscaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GPSMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    gpsUnscaledEphemerisAndClock    GPSSatUnscaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GPSSatUnscaledEphemerisAndClock ::= CHOICE {
    lnav                            GPSLNAVSatUnscaledEphemerisAndClock,
    cnav                            GPSCNAVSatUnscaledEphemerisAndClock,
    reserved2                       GPSCNAVSatUnscaledEphemerisAndClock,    -- CNAV structure used as placeholder
    reserved3                       GPSCNAVSatUnscaledEphemerisAndClock,    -- CNAV structure used as placeholder
    reserved4                       GPSCNAVSatUnscaledEphemerisAndClock,    -- CNAV structure used as placeholder
    reserved5                       GPSCNAVSatUnscaledEphemerisAndClock,    -- CNAV structure used as placeholder
    reserved6                       GPSCNAVSatUnscaledEphemerisAndClock,    -- CNAV structure used as placeholder
    reserved7                       GPSCNAVSatUnscaledEphemerisAndClock     -- CNAV structure used as placeholder
}

-- Comment states value of least significant bit, if not 1, and units.
GPSLNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

    weekNumber                      Unsigned10,             -- weeks

    -- Signal Health Parameters
    navDataHealthStatusSummary      BOOLEAN,                -- as defined in IS-GPS-200
    signalHealthStatus              Unsigned5,              -- as defined in IS-GPS-200

    -- Clock Parameters
    clockIOD                        Unsigned10,             -- as defined in IS-GPS-200
    groupDelayDifferential          Signed8,                -- 2^-31 seconds
    clockReferenceTime              Unsigned16,             -- 2^4 seconds
    af2                             Signed8,                -- 2^-55 seconds/second/second
    af1                             Signed16,               -- 2^-43 seconds/second
    af0                             Signed22,               -- 2^-31 seconds

    -- Miscellaneous Parameters
    l2PDataFlag                     BOOLEAN,                -- as defined in IS-GPS-200
    codeOnL2                        Unsigned2,              -- as defined in IS-GPS-200
    userRangeAccuracy               Unsigned4,              -- as defined in IS-GPS-200
    wordPadding                     Pad1bits,

    -- Ephemeris Parameters
    ephemerisIOD                    Unsigned8,              -- as defined in IS-GPS-200
    crs                             Signed16,               -- 2^-5 metres
    deltaN                          Signed16,               -- 2^-43 semi-circles/second
    m0                              Signed32,               -- 2^-31 semi-circles
    cuc                             Signed16,               -- 2^-29 radians
    ecc                             Signed32,               -- 2^-33 dimensionless
    cus                             Signed16,               -- 2^-29 radians
    rootA                           Unsigned32,             -- 2^-19 sqrt(metres)
    ephemerisReferenceTime          Unsigned32,             -- 2^4 seconds
    cic                             Signed16,               -- 2^-29 radians
    omega0                          Signed32,               -- 2^-31 semi-circles
    cis                             Signed16,               -- 2^-29 radians
    i0                              Signed32,               -- 2^-31 semi-circles
    crc                             Signed16,               -- 2^-5 metres
    omega                           Signed32,               -- 2^-31 semi-circles
    omegaDot                        Signed24,               -- 2^-43 semi-circles/second
    iDot                            Signed14,               -- 2^-43 semi-circles/second
    wordPadding1                    Pad10bits
}

-- Comment states value of least significant bit, if not 1, and units.
GPSCNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

    ephemerisReferenceWeekNumber    Unsigned13,             -- weeks

    -- Signal Health Parameters
    l1HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200
    l2HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200
    l5HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200

    -- Ephemeris Parameters
    ceiDataSequencePropToW10        Unsigned11,             -- 300 seconds
    userRangeAccuracyED             Signed5,                -- as defined in IS-GPS-200
    ephemerisDataRefToW10           Unsigned11,             -- 300 seconds
    deltaA                          Signed26,               -- 2^-9 metres
    aDot                            Signed25,               -- 2^-21 metres/second
    deltaN                          Signed17,               -- 2^-44 semi-circles/second
    deltaNDot                       Signed23,               -- 2^-57 semi-circles/second/second
    m0                              Signed33,               -- 2^-32 semi-circles
    ecc                             Unsigned33,             -- 2^-34 dimensionless
    omega                           Signed33,               -- 2^-32 semi-circles
    ephemerisDataRefToW11           Unsigned11,             -- 300 seconds
    omega0                          Signed33,               -- 2^-32 semi-circles
    deltaOmegaDot                   Signed17,               -- 2^-44 semi-circles/second
    i0                              Signed33,               -- 2^-32 semi-circles
    iDot                            Signed15,               -- 2^-44 semi-circles/second
    cis                             Signed16,               -- 2^-30 radians
    cic                             Signed16,               -- 2^-30 radians
    crs                             Signed24,               -- 2^-8 meters
    crc                             Signed24,               -- 2^-8 meters
    cus                             Signed21,               -- 2^-30 radians
    cuc                             Signed21,               -- 2^-30 radians

    -- Clock Correction Parameters
    ceiDataSequencePropToW30        Unsigned11,             -- 300 seconds
    userRangeAccuracyNED0           Signed5,                -- as defined in IS-GPS-200
    userRangeAccuracyNED1           Unsigned3,              -- as defined in IS-GPS-200
    userRangeAccuracyNED2           Unsigned3,              -- as defined in IS-GPS-200
    clockReferenceTimeOfWeek        Unsigned11,             -- 300 seconds
    af0                             Signed26,               -- 2^-35 seconds
    af1                             Signed20,               -- 2^-48 seconds/second
    af2                             Signed10,               -- 2^-60 seconds/second/second

    -- Group Delay Parameters
    totalGroupDelay                 Signed13,               -- 2^-35 seconds
    interSignalCorrectionL1CA       Signed13,               -- 2^-35 seconds
    interSignalCorrectionL2C        Signed13,               -- 2^-35 seconds
    interSignalCorrectionL5I5       Signed13,               -- 2^-35 seconds
    interSignalCorrectionL5Q5       Signed13,               -- 2^-35 seconds

    wordPadding1                    Pad6bits

}


-- ****************************************************************************
-- * GPS Scaled Ephemeris and Clock                                           *
-- *                                                                          *
-- * Message name:    DataGPSScaledEphemerisAndClock                          *
-- * Message ID:      6322                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains scaled ephemeris and clock corrections for a       *
-- * single GPS satellite.                                                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Interface Specification NAVSTAR GPS.                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataGPSScaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GPSMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    gpsScaledEphemerisAndClock      GPSSatScaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GPSSatScaledEphemerisAndClock ::= CHOICE {
    lnav                            GPSLNAVSatScaledEphemerisAndClock,
    cnav                            GPSCNAVSatScaledEphemerisAndClock,
    reserved2                       GPSCNAVSatScaledEphemerisAndClock,   -- CNAV structure used as placeholder
    reserved3                       GPSCNAVSatScaledEphemerisAndClock,   -- CNAV structure used as placeholder
    reserved4                       GPSCNAVSatScaledEphemerisAndClock,   -- CNAV structure used as placeholder
    reserved5                       GPSCNAVSatScaledEphemerisAndClock,   -- CNAV structure used as placeholder
    reserved6                       GPSCNAVSatScaledEphemerisAndClock,   -- CNAV structure used as placeholder
    reserved7                       GPSCNAVSatScaledEphemerisAndClock    -- CNAV structure used as placeholder
}

GPSLNAVSatScaledEphemerisAndClock ::= SEQUENCE {

    -- Ephemeris Parameters
    ephemerisIOD                    Unsigned8,              -- as defined in IS-GPS-200
    wordPadding                     Pad4bits,
    userRangeAccuracy               Unsigned4,              -- as defined in IS-GPS-200
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..604784),    -- seconds
    wordPadding2                    Pad6bits,
    ephemerisReferenceWeekNumber    Unsigned10,             -- weeks
    m0                              IEEE754Dp,              -- radians
    deltaN                          IEEE754Sp,              -- radians/second
    ecc                             IEEE754Dp,              -- dimensionless
    rootA                           IEEE754Dp,              -- sqrt(metres)
    omega0                          IEEE754Dp,              -- radians
    i0                              IEEE754Dp,              -- radians
    omega                           IEEE754Dp,              -- radians
    omegaDot                        IEEE754Dp,              -- radians/second
    iDot                            IEEE754Sp,              -- radians/second
    cuc                             IEEE754Sp,              -- radians
    cus                             IEEE754Sp,              -- radians
    crc                             IEEE754Sp,              -- metres
    crs                             IEEE754Sp,              -- metres
    cic                             IEEE754Sp,              -- radians
    cis                             IEEE754Sp,              -- radians

    -- Clock Parameters
    wordPadding3                    Pad6bits,
    clockIOD                        Unsigned10,             -- as defined in IS-GPS-200
    wordPadding4                    Pad12bits,
    clockReferenceTime              INTEGER (0..604784),    -- seconds
    af2                             IEEE754Sp,              -- seconds/second/second
    af1                             IEEE754Sp,              -- seconds/second
    af0                             IEEE754Sp,              -- seconds

    -- Group Delay Parameters
    totalGroupDelay                 IEEE754Sp,              -- seconds

    -- Signal Health Parameters
    navDataHealthStatusSummary      BOOLEAN,                -- as defined in IS-GPS-200
    wordPadding5                    Pad10bits,
    signalHealthStatus              Unsigned5               -- as defined in IS-GPS-200
}

GPSCNAVSatScaledEphemerisAndClock ::= SEQUENCE {

    -- Ephemeris Parameters
    wordPadding                     Pad11bits,
    userRangeAccuracyED             Signed5,                -- as defined in IS-GPS-200
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..604500),    -- seconds
    wordPadding2                    Pad3bits,
    ephemerisReferenceWeekNumber    Unsigned13,             -- weeks
    wordPadding3                    Pad12bits,
    ephemerisDataPredictTimeOfWeek  INTEGER (0..604500),    -- seconds
    deltaA                          IEEE754Dp,              -- metres
    aDot                            IEEE754Dp,              -- metres/second
    deltaNDot                       IEEE754Sp,              -- radians/second/second
    m0                              IEEE754Dp,              -- radians
    ecc                             IEEE754Dp,              -- dimensionless
    omega                           IEEE754Dp,              -- radians
    omega0                          IEEE754Dp,              -- radians
    deltaOmegaDot                   IEEE754Sp,              -- radians/second
    i0                              IEEE754Dp,              -- radians
    iDot                            IEEE754Sp,              -- radians/second
    cis                             IEEE754Sp,              -- radians
    cic                             IEEE754Sp,              -- radians
    crs                             IEEE754Sp,              -- metres
    crc                             IEEE754Sp,              -- metres
    cus                             IEEE754Sp,              -- radians
    cuc                             IEEE754Sp,              -- radians

    -- Clock Correction Parameters
    wordPadding4                    Pad12bits,
    clockReferenceTime              INTEGER (0..604500),    -- seconds
    wordPadding5                    Pad12bits,
    clockDataPredictTimeOfWeek      INTEGER (0..604500),    -- seconds
    wordPadding6                    Pad3bits,
    userRangeAccuracyNED0           Signed5,                -- as defined in IS-GPS-200
    wordPadding7                    Pad5bits,
    userRangeAccuracyNED1           Unsigned3,              -- as defined in IS-GPS-200
    wordPadding8                    Pad5bits,
    userRangeAccuracyNED2           Unsigned3,              -- as defined in IS-GPS-200
    wordPadding9                    Pad8bits,
    af2                             IEEE754Sp,              -- seconds/second/second
    af1                             IEEE754Sp,              -- seconds/second
    af0                             IEEE754Dp,              -- seconds

    -- Group Delay Parameters
    totalGroupDelay                 IEEE754Sp,              -- seconds
    interSignalCorrectionL1CA       IEEE754Sp,              -- seconds
    interSignalCorrectionL2C        IEEE754Sp,              -- seconds
    interSignalCorrectionL5I5       IEEE754Sp,              -- seconds
    interSignalCorrectionL5Q5       IEEE754Sp,              -- seconds

    -- Signal Health Parameters
    l1HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200
    l2HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200
    l5HealthStatus                  BOOLEAN,                -- as defined in IS-GPS-200
    wordPadding10                   Pad13bits
}


-- ****************************************************************************
-- * Galileo Unscaled Ephemeris and Clock                                     *
-- *                                                                          *
-- * Message name:    DataGalUnscaledEphemerisAndClock                        *
-- * Message ID:      6328                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains unscaled ephemeris and clock corrections for a     *
-- * single Galileo satellite.                                                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Galileo Open Service Signal-in-Space Interface Control Document.         *
-- * If parameters are decoded from an F/NAV message, clock parameters relate *
-- * to the dual frequency E1,E5a combination. If parameters are decoded from *
-- * an I/NAV message, clock parameters relate to the dual frequency E1,E5b   *
-- * combination.                                                             *
-- *                                                                          *
-- ****************************************************************************
--
DataGalUnscaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GalMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    galUnscaledEphemerisAndClock    GalSatUnscaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GalSatUnscaledEphemerisAndClock ::= CHOICE {
    fnav                            GalFNAVSatUnscaledEphemerisAndClock,
    inav                            GalINAVSatUnscaledEphemerisAndClock,
    reserved2                       GalFNAVSatUnscaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved3                       GalFNAVSatUnscaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved4                       GalFNAVSatUnscaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved5                       GalFNAVSatUnscaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved6                       GalFNAVSatUnscaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved7                       GalFNAVSatUnscaledEphemerisAndClock     -- F/NAV structure used as placeholder
}

-- Comment states value of least significant bit, if not 1, and units.
GalFNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

    weekNumber                      Unsigned12,             -- weeks

    -- Issue of Data nav
    navIOD                          Unsigned10,             -- dimensionless

    -- Ephemeris parameters
    m0                              Signed32,               -- 2^-31 semi-circles
    deltaN                          Signed16,               -- 2^-43 semi-circles/second
    ecc                             Unsigned32,             -- 2^-33 dimensionless
    rootA                           Unsigned32,             -- 2^-19 sqrt(metres)
    omega0                          Signed32,               -- 2^-31 semi-circles
    i0                              Signed32,               -- 2^-31 semi-circles
    omega                           Signed32,               -- 2^-31 semi-circles
    omegaDot                        Signed24,               -- 2^-43 semi-circles/second
    iDot                            Signed14,               -- 2^-43 semi-circles/second
    cuc                             Signed16,               -- 2^-29 radians
    cus                             Signed16,               -- 2^-29 radians
    crc                             Signed16,               -- 2^-5 metres
    crs                             Signed16,               -- 2^-5 metres
    cic                             Signed16,               -- 2^-29 radians
    cis                             Signed16,               -- 2^-29 radians
    ephemerisReferenceTime          Unsigned14,             -- 60 seconds

    -- Clock Correction Parameters
    clockCorrectionReferenceToW     Unsigned14,             -- 60 seconds
    af0                             Signed31,               -- 2^-34 seconds
    af1                             Signed21,               -- 2^-46 seconds/second
    af2                             Signed6,                -- 2^-59 seconds/second/second

    signalInSpaceAccuracy           Unsigned8,

    -- Navigation Message (I/F) Dependent Parameters
    bgdE1E5a                        Unsigned10,             -- 2^-32 seconds
    e5aHealthStatus                 GalSignalHealthIndicator,
