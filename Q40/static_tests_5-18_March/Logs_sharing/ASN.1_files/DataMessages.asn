-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * BeiDou Navigation Satellite System Signal In Space ICD.                  *
-- *                                                                          *
-- ****************************************************************************
--
DataBDSScaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          BDSMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    bdsScaledEphemerisAndClock      BDSSatScaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
BDSSatScaledEphemerisAndClock ::= CHOICE {
    dnav                            BDSDNAVSatScaledEphemerisAndClock,
    cnav1                           BDSCNAVSatScaledEphemerisAndClock,
    cnav2                           BDSCNAVSatScaledEphemerisAndClock,
    reserved3                       BDSCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved4                       BDSCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved5                       BDSCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved6                       BDSCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved7                       BDSCNAVSatScaledEphemerisAndClock    -- used as placeholder
}

-- See Tables 5.10 & 5.7, BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B1I (Version 3.0), February 2019
-- Comment states units
BDSDNAVSatScaledEphemerisAndClock ::= SEQUENCE {

    -- Ephemeris Parameters
    wordPadding                     Pad11bits,
    ephemerisAOD                    INTEGER (0..31),        -- see reference
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..604792),    -- seconds
    rootA                           IEEE754Dp,              -- sqrt(metres)
    ecc                             IEEE754Dp,              -- dimensionless
    omega                           IEEE754Dp,              -- radians
    deltaN                          IEEE754Sp,              -- radians/second
    m0                              IEEE754Dp,              -- radians
    omega0                          IEEE754Dp,              -- radians
    omegaDot                        IEEE754Sp,              -- radians/second
    i0                              IEEE754Dp,              -- radians
    iDot                            IEEE754Sp,              -- radians/second
    cuc                             IEEE754Sp,              -- radians
    cus                             IEEE754Sp,              -- radians
    crc                             IEEE754Sp,              -- metres
    crs                             IEEE754Sp,              -- metres
    cic                             IEEE754Sp,              -- radians
    cis                             IEEE754Sp,              -- radians

    -- Clock Parameters
    wordPadding2                    Pad11bits,
    clockAOD                        INTEGER (0..31),        -- see reference
    wordPadding3                    Pad12bits,
    clockReferenceTime              INTEGER (0..604792),    -- seconds
    a0                              IEEE754Sp,              -- seconds/second/second
    a1                              IEEE754Sp,              -- seconds/second
    a2                              IEEE754Sp,              -- seconds

    -- Group Delay Parameters
    tGD1                            IEEE754Sp,              -- seconds
    tGD2                            IEEE754Sp,              -- seconds

    -- Satellite Health Parameters
    satH1                           BOOLEAN,                -- '0' means broadcasting satellite is good and '1' means not
    wordPadding4                    Pad15bits
}

-- See Tables 7.7, 7.5, 7.6 and 7.22,  BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B2a (Version 1.0), December 2017
-- Comment states units
BDSCNAVSatScaledEphemerisAndClock ::= SEQUENCE {

    -- Ephemeris Parameters
    wordPadding                     Pad8bits,
    ephemerisIOD                    INTEGER (0..255),       -- see reference
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..604500),    -- seconds
    wordPadding2                    Pad14bits,
    satOrbitType                    INTEGER (0..3),         -- 01 (1) indicates the GEO satellite, 10 (2) indicates the IGSO satellite, 11 (3) indicates the MEO satellite, and 00 (0) is reserved.
    deltaA                          IEEE754Dp,              -- metres
    aDot                            IEEE754Dp,              -- metres/second
    deltaN0                         IEEE754Sp,              -- semi-circles/second
    deltaN0Dot                      IEEE754Sp,              -- semi-circles/second/second
    m0                              IEEE754Dp,              -- semi-circles
    ecc                             IEEE754Dp,              -- dimensionless
    omega                           IEEE754Dp,              -- semi-circles
    omega0                          IEEE754Dp,              -- semi-circles
    i0                              IEEE754Dp,              -- semi-circles
    omegaDot                        IEEE754Sp,              -- semi-circles/second
    i0Dot                           IEEE754Sp,              -- semi-circles/second
    cis                             IEEE754Sp,              -- radians
    cic                             IEEE754Sp,              -- radians
    crs                             IEEE754Sp,              -- metres
    crc                             IEEE754Sp,              -- metres
    cus                             IEEE754Sp,              -- radians
    cuc                             IEEE754Sp,              -- radians

    -- Clock Correction Parameters
    wordPadding3                    Pad6bits,
    clockIOD                        INTEGER (0..1023),      -- see reference
    clockReferenceTime              IEEE754Sp,              -- seconds
    a0                              IEEE754Dp,              -- seconds
    a1                              IEEE754Sp,              -- seconds/second
    a2                              IEEE754Sp,              -- seconds/second/second

    -- Group Delay Parameters
    tGDB1Cp                         IEEE754Sp,              -- seconds
    tGDB2ap                         IEEE754Sp,              -- seconds
    iscB1Cd                         IEEE754Sp,              -- seconds

    -- Satellite Health Parameters
    wordPadding4                    Pad14bits,
    satHealthStatus                 INTEGER (0..3)          -- 0 - satellite is healthy, 1 - satellite is unhealthy or in test, 2 and 3 - reserved
}


-- ****************************************************************************
-- * GLONASS Unscaled Ephemeris and Clock                                     *
-- *                                                                          *
-- * Message name:    DataGLOUnscaledEphemerisAndClock                        *
-- * Message ID:      6259                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains unscaled ephemeris and clock corrections for a     *
-- * single GLONASS satellite.                                                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * GLONASS ICD.                                                             *
-- * The message contents depends on the type of navigation message decoded.  *
-- *                                                                          *
-- ****************************************************************************
--
DataGLOUnscaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GLOMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    gloUnscaledEphemerisAndClock    GLOSatUnscaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GLOSatUnscaledEphemerisAndClock ::= CHOICE {
    fnav                            GLOFNAVSatUnscaledEphemerisAndClock,
    fmnav                           GLOFMNAVSatUnscaledEphemerisAndClock,
    cnav                            GLOCNAVSatUnscaledEphemerisAndClock,
    reserved3                       GLOCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved4                       GLOCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved5                       GLOCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved6                       GLOCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved7                       GLOCNAVSatUnscaledEphemerisAndClock     -- used as placeholder
}

-- See Table 4.5, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOFNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

   -- Clock Parameters
    tkh                             Unsigned5,              -- hours (0-23)
    tkm                             Unsigned6,              -- minutes (0-59)
    tks                             Unsigned1,              -- 30 seconds (0 or 30)
    tb                              Unsigned7,              -- 15 minutes (15-1425)
    gammantb                        Signed11,               -- 2^-40 dimensionless
    tauntb                          Signed22,               -- 2^-30 seconds

    -- Ephemeris Parameters
    xntb                            Signed27,               -- 2^-11 km
    yntb                            Signed27,               -- 2^-11 km
    zntb                            Signed27,               -- 2^-11 km
    xntbdot                         Signed24,               -- 2^-20 km/second
    yntbdot                         Signed24,               -- 2^-20 km/second
    zntbdot                         Signed24,               -- 2^-20 km/second
    xntbdotdot                      Signed5,                -- 2^-30 km/second/second
    yntbdotdot                      Signed5,                -- 2^-30 km/second/second
    zntbdotdot                      Signed5,                -- 2^-30 km/second/second

    -- Flags and Supplementary Parameters
    bn                              Unsigned3,              -- dimensionless
    deltataun                       Signed5,                -- 2^-30 seconds
    en                              Unsigned5,              -- days (0-31)
    p1                              Unsigned2,              -- dimensionless
    p2                              Unsigned1,              -- dimensionless
    p3                              Unsigned1,              -- dimensionless

    wordPadding                     Pad3bits
}

-- See Table 4.5, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOFMNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

   -- Clock Parameters
    tkh                             Unsigned5,              -- hours (0-23)
    tkm                             Unsigned6,              -- minutes (0-59)
    tks                             Unsigned1,              -- 30 seconds (0 or 30)
    tb                              Unsigned7,              -- 15 minutes (15-1425)
    m                               Unsigned2,              -- dimensionless (0-3)
    gammantb                        Signed11,               -- 2^-40 dimensionless
    tauntb                          Signed22,               -- 2^-30 seconds

    -- Ephemeris Parameters
    xntb                            Signed27,               -- 2^-11 km
    yntb                            Signed27,               -- 2^-11 km
    zntb                            Signed27,               -- 2^-11 km
    xntbdot                         Signed24,               -- 2^-20 km/second
    yntbdot                         Signed24,               -- 2^-20 km/second
    zntbdot                         Signed24,               -- 2^-20 km/second
    xntbdotdot                      Signed5,                -- 2^-30 km/second/second
    yntbdotdot                      Signed5,                -- 2^-30 km/second/second
    zntbdotdot                      Signed5,                -- 2^-30 km/second/second

    -- Flags and Supplementary Parameters
    bn                              Unsigned3,              -- dimensionless
    p                               Unsigned2,              -- dimensionless
    nt                              Unsigned11,             -- days (0-1461)
    ft                              Unsigned4,              -- dimensionless
    n                               Unsigned5,              -- dimensionless (0-31)
    deltataun                       Signed5,                -- 2^-30 seconds
    en                              Unsigned5,              -- days (0-31)
    p1                              Unsigned2,              -- dimensionless
    p2                              Unsigned1,              -- dimensionless
    p3                              Unsigned1,              -- dimensionless
    p4                              Unsigned1,              -- dimensionless

    -- Satellite Health
    ln                              Unsigned1,              -- dimensionless (0 - healthy, 1 - malfunction)

    wordPadding                     Pad9bits
}

-- See string Type 10, 11 & 12, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOCNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

    -- Clock Correction Parameters
    n4                              Unsigned5,              -- 4 year interval (1-31)
    nT                              Unsigned11,             -- 24 hours (1-1461)
    mj                              Unsigned3,              -- dimensionless
    ps                              Unsigned6,              -- dimensionless (0-63)
    tb                              Unsigned10,             -- 90 seconds (0-86310)
    eEj                             Unsigned8,              -- 6 hours (1-255)
    eTj                             Unsigned8,              -- 6 hours (1-255)
    rEj                             Unsigned2,              -- dimensionless (0-3)
    rTj                             Unsigned2,              -- dimensionless (0-3)
    fEj                             Signed5,                -- dimensionless (-15-15)
    fTj                             Signed5,                -- dimensionless (-15-15)
    tauj                            Signed32,               -- 2^-38 seconds
    gammaj                          Signed19,               -- 2^-48 dimensionless
    betaj                           Signed15,               -- 2^-57 /second
    tauc                            Signed40,               -- 2^-31 seconds
    taucdot                         Signed13,               -- 2^-49 seconds/second
    deltataujL2                     Signed18,               -- 2^-38 seconds
    deltatauGPS                     Signed30,               -- 2^-38 seconds

    -- Ephemeris Parameters
    xj                              Signed40,               -- 2^-20 km
    yj                              Signed40,               -- 2^-20 km
    zj                              Signed40,               -- 2^-20 km
    xjdot                           Signed35,               -- 2^-30 km/second
    yjdot                           Signed35,               -- 2^-30 km/second
    zjdot                           Signed35,               -- 2^-30 km/second
    xjdotdot                        Signed15,               -- 2^-19 km/second/second
    yjdotdot                        Signed15,               -- 2^-19 km/second/second
    zjdotdot                        Signed15,               -- 2^-19 km/second/second

    --Antenna Phase Centre Offset Parameters
    deltaxjpc                       Signed13,               -- 2^-10 metres
    deltayjpc                       Signed13,               -- 2^-10 metres
    deltazjpc                       Signed13,               -- 2^-10 metres

    wordPadding                     Pad3bits
 }


-- ****************************************************************************
-- * GLONASS Scaled Ephemeris and Clock                                       *
-- *                                                                          *
-- * Message name:    DataGLOScaledEphemerisAndClock                          *
-- * Message ID:      6389                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains scaled ephemeris and clock corrections for a       *
-- * single GLONASS satellite.                                                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * GLONASS ICD.                                                             *
-- * The message contents depends on the type of navigation message decoded.  *
-- *                                                                          *
-- ****************************************************************************
--
DataGLOScaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GLOMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    gloScaledEphemerisAndClock      GLOSatScaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GLOSatScaledEphemerisAndClock ::= CHOICE {
    fnav                            GLOFNAVSatScaledEphemerisAndClock,
    fmnav                           GLOFMNAVSatScaledEphemerisAndClock,
    cnav                            GLOCNAVSatScaledEphemerisAndClock,
    reserved3                       GLOCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved4                       GLOCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved5                       GLOCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved6                       GLOCNAVSatScaledEphemerisAndClock,   -- used as placeholder
    reserved7                       GLOCNAVSatScaledEphemerisAndClock    -- used as placeholder
}

-- See Table 4.5, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states units and, optionally, (expected range)
GLOFNAVSatScaledEphemerisAndClock ::= SEQUENCE {

   -- Clock Parameters
    wordPadding1                    Pad11bits,
    tkh                             INTEGER (0..23),        -- hours (0-23)
    wordPadding2                    Pad2bits,
    tkm                             INTEGER (0..59),        -- minutes (0-59)
    wordPadding3                    Pad3bits,
    tks                             INTEGER (0..30),        -- seconds (0 or 30)
    wordPadding4                    Pad5bits,
    tb                              INTEGER (0..1425),      -- minutes (15-1425)
    gammantb                        IEEE754Sp,              -- dimensionless
    tauntb                          IEEE754Sp,              -- seconds

    -- Ephemeris Parameters
    xntb                            IEEE754Dp,              -- metres
    yntb                            IEEE754Dp,              -- metres
    zntb                            IEEE754Dp,              -- metres
    xntbdot                         IEEE754Sp,              -- metres/second
    yntbdot                         IEEE754Sp,              -- metres/second
    zntbdot                         IEEE754Sp,              -- metres/second
    xntbdotdot                      IEEE754Sp,              -- metres/second/second
    yntbdotdot                      IEEE754Sp,              -- metres/second/second
    zntbdotdot                      IEEE754Sp,              -- metres/second/second

    -- Flags and Supplementary Parameters
    wordPadding5                    Pad13bits,
    bn                              INTEGER (0..7),         -- dimensionless
    deltataun                       IEEE754Sp,              -- seconds
    wordPadding6                    Pad3bits,
    en                              INTEGER (0..31),        -- days (0-31)
    wordPadding7                    Pad2bits,
    p1                              INTEGER (0..60),        -- minutes
    wordPadding8                    Pad7bits,
    p2                              INTEGER (0..1),         -- dimensionless
    wordPadding9                    Pad7bits,
    p3                              INTEGER (0..1)          -- dimensionless
}

-- See Table 4.5, ICD L1, L2 GLONASS, Edition 5.1 2008
-- Comment states units and, optionally, (expected range)
GLOFMNAVSatScaledEphemerisAndClock ::= SEQUENCE {

   -- Clock Parameters
    wordPadding                     Pad6bits,
    m                               INTEGER (0..3),         -- dimensionless (0-3)
    wordPadding1                    Pad3bits,
    tkh                             INTEGER (0..23),        -- hours (0-23)
    wordPadding2                    Pad2bits,
    tkm                             INTEGER (0..59),        -- minutes (0-59)
    wordPadding3                    Pad3bits,
    tks                             INTEGER (0..30),        -- seconds (0 or 30)
    wordPadding4                    Pad5bits,
    tb                              INTEGER (0..1425),      -- minutes (15-1425)
    gammantb                        IEEE754Sp,              -- dimensionless
    tauntb                          IEEE754Sp,              -- seconds

    -- Ephemeris Parameters
    xntb                            IEEE754Dp,              -- metres
    yntb                            IEEE754Dp,              -- metres
    zntb                            IEEE754Dp,              -- metres
    xntbdot                         IEEE754Sp,              -- metres/second
    yntbdot                         IEEE754Sp,              -- metres/second
    zntbdot                         IEEE754Sp,              -- metres/second
    xntbdotdot                      IEEE754Sp,              -- metres/second/second
    yntbdotdot                      IEEE754Sp,              -- metres/second/second
    zntbdotdot                      IEEE754Sp,              -- metres/second/second

    -- Flags and Supplementary Parameters
    wordPadding5                    Pad5bits,
    bn                              INTEGER (0..7),         -- dimensionless
    wordPadding6                    Pad6bits,
    p                               INTEGER (0..3),         -- dimensionless
    wordPadding7                    Pad5bits,
    nt                              INTEGER (0..1461),      -- days (0-1461)
    wordPadding8                    Pad6bits,
    ft                              INTEGER (0..512),       -- metres
    wordPadding9                    Pad11bits,
    n                               INTEGER (0..31),        -- dimensionless (0-31)
    deltataun                       IEEE754Sp,              -- seconds
    wordPadding10                   Pad3bits,
    en                              INTEGER (0..31),        -- days (0-31)
    wordPadding11                   Pad2bits,
    p1                              INTEGER (0..60),        -- minutes
    wordPadding12                   Pad7bits,
    p2                              INTEGER (0..1),         -- dimensionless
    wordPadding13                   Pad7bits,
    p3                              INTEGER (0..1),         -- dimensionless
    wordPadding14                   Pad7bits,
    p4                              INTEGER (0..1),         -- dimensionless

    -- Satellite Health
    wordPadding15                   Pad7bits,
    ln                              INTEGER (0..1)          -- dimensionless (0 - healthy, 1 - malfunction)
}

-- See string Type 10, 11 & 12, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states units and, optionally, (expected range)
GLOCNAVSatScaledEphemerisAndClock ::= SEQUENCE {

    -- Clock Correction Parameters
    wordPadding                     Pad11bits,
    n4                              INTEGER (0..31),        -- 4 year interval
    wordPadding1                    Pad5bits,
    nT                              INTEGER (0..1461),      -- day number
    wordPadding2                    Pad6bits,
    mj                              INTEGER (0..3),         -- dimensionless
    wordPadding3                    Pad2bits,
    ps                              INTEGER (0..63),        -- dimensionless
    wordPadding4                    Pad15bits,
    tb                              INTEGER (0..86310),     -- seconds
    eEj                             IEEE754Sp,              -- seconds
    eTj                             IEEE754Sp,              -- seconds
    wordPadding5                    Pad6bits,
    rEj                             INTEGER (0..3),         -- dimensionless
    wordPadding6                    Pad6bits,
    rTj                             INTEGER (0..3),         -- dimensionless
    fEj                             IEEE754Sp,              -- metres
    fTj                             IEEE754Sp,              -- metres
    tauj                            IEEE754Dp,              -- seconds
    gammaj                          IEEE754Sp,              -- dimensionless
    betaj                           IEEE754Sp,              -- /second
    tauc                            IEEE754Dp,              -- seconds
    taucdot                         IEEE754Sp,              -- seconds/second
    deltataujL2                     IEEE754Sp,              -- seconds
    deltatauGPS                     IEEE754Dp,              -- seconds

    -- Ephemeris Parameters
    xj                              IEEE754Dp,              -- metres
    yj                              IEEE754Dp,              -- metres
    zj                              IEEE754Dp,              -- metres
    xjdot                           IEEE754Dp,              -- metres/second
    yjdot                           IEEE754Dp,              -- metres/second
    zjdot                           IEEE754Dp,              -- metres/second
    xjdotdot                        IEEE754Sp,              -- metres/second/second
    yjdotdot                        IEEE754Sp,              -- metres/second/second
    zjdotdot                        IEEE754Sp,              -- metres/second/second

    --Antenna Phase Centre Offset Parameters
    deltaxjpc                       IEEE754Sp,              -- metres
    deltayjpc                       IEEE754Sp,              -- metres
    deltazjpc                       IEEE754Sp               -- metres
}


-- Ionospheric Correction Messages  --
--
-- These messages provide the unscaled and scaled ionospheric corrections
-- The GNSSs provide different information so implement on a constellation
-- by constellation basis.
--
-- ****************************************************************************
-- * GPS Unscaled Iono Corrections                                            *
-- *                                                                          *
-- * Message name:    DataGPSUnscaledIonoCorrections                          *
-- * Message ID:      6352                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast ionospheric unscaled correction      *
-- * factors received from a single tracked GPS satellite.                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Interface Specification NAVSTAR GPS.                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataGPSUnscaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          GPSSignalID,
    wordPadding1                    Pad13bits,
    gpsSatUnscaledIonoCorrections   GPSSatUnscaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GPSSatUnscaledIonoCorrections ::= CHOICE {
    lnav                            GPSLNAVSatUnscaledIonoCorrections,
    cnav                            GPSCNAVSatUnscaledIonoCorrections,
    reserved2                       GPSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved3                       GPSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved4                       GPSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved5                       GPSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved6                       GPSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved7                       GPSCNAVSatUnscaledIonoCorrections     -- used as placeholder
}

-- Comment states value of least significant bit, if not 1, and units.
GPSLNAVSatUnscaledIonoCorrections ::= SEQUENCE {
    alpha0                          Signed8,                -- 2^-30 seconds
    alpha1                          Signed8,                -- 2^-27 seconds/semi-circle
    alpha2                          Signed8,                -- 2^-24 seconds/semi-circle/semi-circle
    alpha3                          Signed8,                -- 2^-24 seconds/semi-circle/semi-circle/semi-circle
    beta0                           Signed8,                -- 2^11 seconds
    beta1                           Signed8,                -- 2^14 seconds/semi-circle
    beta2                           Signed8,                -- 2^16 seconds/semi-circle/semi-circle
    beta3                           Signed8                 -- 2^16 seconds/semi-circle/semi-circle/semi-circle
}

GPSCNAVSatUnscaledIonoCorrections ::= GPSLNAVSatUnscaledIonoCorrections


-- ****************************************************************************
-- * GPS Scaled Iono Corrections                                              *
-- *                                                                          *
-- * Message name:    DataGPSScaledIonoCorrections                            *
-- * Message ID:      6258                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast ionospheric scaled correction        *
-- * factors received from a single tracked GPS satellite.                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Interface Specification NAVSTAR GPS.                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataGPSScaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          GPSSignalID,
    wordPadding1                    Pad13bits,
    gpsSatScaledIonoCorrections     GPSSatScaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GPSSatScaledIonoCorrections ::= CHOICE {
    lnav                            GPSLNAVSatScaledIonoCorrections,
    cnav                            GPSCNAVSatScaledIonoCorrections,
    reserved2                       GPSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved3                       GPSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved4                       GPSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved5                       GPSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved6                       GPSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved7                       GPSCNAVSatScaledIonoCorrections     -- used as placeholder
}

GPSLNAVSatScaledIonoCorrections ::= SEQUENCE {
    alpha0                          IEEE754Sp,              -- seconds
    alpha1                          IEEE754Sp,              -- seconds/radian
    alpha2                          IEEE754Sp,              -- seconds/radian/radian
    alpha3                          IEEE754Sp,              -- seconds/radian/radian/radian
    beta0                           IEEE754Sp,              -- seconds
    beta1                           IEEE754Sp,              -- seconds/radian
    beta2                           IEEE754Sp,              -- seconds/radian/radian
    beta3                           IEEE754Sp               -- seconds/radian/radian/radian
}

GPSCNAVSatScaledIonoCorrections ::= GPSLNAVSatScaledIonoCorrections


-- ****************************************************************************
-- * Galileo Unscaled Iono Corrections                                        *
-- *                                                                          *
-- * Message name:    DataGalUnscaledIonoCorrections                          *
-- * Message ID:      6254                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast unscaled ionospheric correction      *
-- * factors received from a single tracked Galileo satellite.                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Galileo Open Service Signal-in-Space Interface Control Document.         *
-- * sfu is solar flux unit = 10^-22 W/(Hz.m^2)                               *
-- *                                                                          *
-- ****************************************************************************
--
DataGalUnscaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          GalSignalID,
    wordPadding1                    Pad13bits,
    galSatUnscaledIonoCorrections   GalSatUnscaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GalSatUnscaledIonoCorrections ::= CHOICE {
    inav                            GalINAVSatUnscaledIonoCorrections,
    fnav                            GalFNAVSatUnscaledIonoCorrections,
    reserved2                       GalFNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved3                       GalFNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved4                       GalFNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved5                       GalFNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved6                       GalFNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved7                       GalFNAVSatUnscaledIonoCorrections     -- used as placeholder
}

-- Comment states value of least significant bit, if not 1, and units.
GalINAVSatUnscaledIonoCorrections ::= SEQUENCE {
    ai0                             Unsigned11,             -- 2^-2 sfu
    ai1                             Signed11,               -- 2^-8 sfu/degree
    ai2                             Signed14,               -- 2^-15 sfu/degree/degree
    ionoDisturbanceForRegion1       BOOLEAN,                -- FALSE = None
    ionoDisturbanceForRegion2       BOOLEAN,                -- FALSE = None
    ionoDisturbanceForRegion3       BOOLEAN,                -- FALSE = None
    ionoDisturbanceForRegion4       BOOLEAN,                -- FALSE = None
    ionoDisturbanceForRegion5       BOOLEAN,                -- FALSE = None
    wordPadding1                    Pad7bits
}

GalFNAVSatUnscaledIonoCorrections ::= GalINAVSatUnscaledIonoCorrections


