    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to report almanac
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    dataSource                      DataSource,
    signalID                        GalMultiSignalID,
    perSatAlmanacData               GalSatUnscaledAlmanacs
}

GalSatUnscaledAlmanacs ::= SEQUENCE {
    wordPadding                     Pad10bits,
    galSatUnscaledAlmanacs  SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        wordPadding                     Pad13bits,
-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
        data                            CHOICE {
            fnav                            GalFNAVSatUnscaledAlmanacs,
            inav                            GalINAVSatUnscaledAlmanacs,
            reserved2                       GalINAVSatUnscaledAlmanacs,     -- I/NAV structure used as placeholder
            reserved3                       GalINAVSatUnscaledAlmanacs,     -- I/NAV structure used as placeholder
            reserved4                       GalINAVSatUnscaledAlmanacs,     -- I/NAV structure used as placeholder
            reserved5                       GalINAVSatUnscaledAlmanacs,     -- I/NAV structure used as placeholder
            reserved6                       GalINAVSatUnscaledAlmanacs,     -- I/NAV structure used as placeholder
            reserved7                       GalINAVSatUnscaledAlmanacs      -- I/NAV structure used as placeholder
        }
    }
}

