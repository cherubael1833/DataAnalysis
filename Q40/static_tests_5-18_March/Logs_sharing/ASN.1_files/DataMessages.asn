-- * factors received from a single tracked BeiDou satellite.                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * BeiDou Navigation Satellite System Signal In Space ICD.                  *
-- *                                                                          *
-- * TECu is Total Electron Content unit (10^16 electrons/m^2)                *
-- *                                                                          *
-- ****************************************************************************
--
DataBDSUnscaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          BDSSignalID,
    wordPadding1                    Pad13bits,
    bdsSatUnscaledIonoCorrections   BDSSatUnscaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
BDSSatUnscaledIonoCorrections ::= CHOICE {
    dnav                            BDSDNAVSatUnscaledIonoCorrections,
    cnav1                           BDSCNAVSatUnscaledIonoCorrections,
    cnav2                           BDSCNAVSatUnscaledIonoCorrections,
    reserved3                       BDSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved4                       BDSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved5                       BDSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved6                       BDSCNAVSatUnscaledIonoCorrections,    -- used as placeholder
    reserved7                       BDSCNAVSatUnscaledIonoCorrections     -- used as placeholder
}

-- See Table 5.5, BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B1I (Version 3.0), February 2019
-- Comment states value of least significant bit, if not 1, and units
BDSDNAVSatUnscaledIonoCorrections ::= SEQUENCE {
    alpha0                          Signed8,                -- 2^-30 seconds
    alpha1                          Signed8,                -- 2^-27 seconds/semi-circle
    alpha2                          Signed8,                -- 2^-24 seconds/semi-circle/semi-circle
    alpha3                          Signed8,                -- 2^-24 seconds/semi-circle/semi-circle/semi-circle
    beta0                           Signed8,                -- 2^11 seconds
    beta1                           Signed8,                -- 2^14 seconds/semi-circle
    beta2                           Signed8,                -- 2^16 seconds/semi-circle/semi-circle
    beta3                           Signed8                 -- 2^16 seconds/semi-circle/semi-circle/semi-circle
}

-- See Table 7.10,  BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B2a (Version 1.0), December 2017
-- Comment states value of least significant bit, if not 1, and units
BDSCNAVSatUnscaledIonoCorrections ::= SEQUENCE {
    alpha1                          Unsigned10,             -- 2^-3 TECu
    alpha2                          Signed8,                -- 2^-3 TECu
    alpha3                          Unsigned8,              -- 2^-3 TECu
    alpha4                          Unsigned8,              -- 2^-3 TECu
    alpha5                          Unsigned8,              -- - 2^-3 TECu (note scale factor is negative)
    alpha6                          Signed8,                -- 2^-3 TECu
    alpha7                          Signed8,                -- 2^-3 TECu
    alpha8                          Signed8,                -- 2^-3 TECu
    alpha9                          Signed8,                -- 2^-3 TECu
    wordPadding                     Pad6bits
}

-- ****************************************************************************
-- * BeiDou Scaled Iono Corrections                                           *
-- *                                                                          *
-- * Message name:    DataBDSScaledIonoCorrections                            *
-- * Message ID:      6284                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast scaled ionospheric correction        *
-- * factors received from a single tracked BeiDou satellite.                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * BeiDou Navigation Satellite System Signal In Space ICD.                  *
-- *                                                                          *
-- * TECu is Total Electron Content unit (10^16 electrons/m^2)                *
-- *                                                                          *
-- ****************************************************************************
--
DataBDSScaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          BDSSignalID,
    wordPadding1                    Pad13bits,
    bdsSatScaledIonoCorrections     BDSSatScaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
BDSSatScaledIonoCorrections ::= CHOICE {
    dnav                            BDSDNAVSatScaledIonoCorrections,
    cnav1                           BDSCNAVSatScaledIonoCorrections,
    cnav2                           BDSCNAVSatScaledIonoCorrections,
    reserved3                       BDSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved4                       BDSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved5                       BDSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved6                       BDSCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved7                       BDSCNAVSatScaledIonoCorrections     -- used as placeholder
}

-- See Table 5.5, BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B1I (Version 3.0), February 2019
-- Comment states units
BDSDNAVSatScaledIonoCorrections ::= SEQUENCE {
    alpha0                          IEEE754Sp,              -- seconds
    alpha1                          IEEE754Sp,              -- seconds/radian
    alpha2                          IEEE754Sp,              -- seconds/radian/radian
    alpha3                          IEEE754Sp,              -- seconds/radian/radian/radian
    beta0                           IEEE754Sp,              -- seconds
    beta1                           IEEE754Sp,              -- seconds/radian
    beta2                           IEEE754Sp,              -- seconds/radian/radian
    beta3                           IEEE754Sp               -- seconds/radian/radian/radian
}

-- See Table 7.10,  BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B2a (Version 1.0), December 2017
-- Comment states units
BDSCNAVSatScaledIonoCorrections ::= SEQUENCE {
    alpha1                          IEEE754Sp,              -- TECu
    alpha2                          IEEE754Sp,              -- TECu
    alpha3                          IEEE754Sp,              -- TECu
    alpha4                          IEEE754Sp,              -- TECu
    alpha5                          IEEE754Sp,              -- TECu
    alpha6                          IEEE754Sp,              -- TECu
    alpha7                          IEEE754Sp,              -- TECu
    alpha8                          IEEE754Sp,              -- TECu
    alpha9                          IEEE754Sp               -- TECu
}


-- ****************************************************************************
-- * GLONASS Unscaled Iono Corrections                                        *
-- *                                                                          *
-- * Message name:    DataGLOUnscaledIonoCorrections                          *
-- * Message ID:      6458                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast ionospheric unscaled correction      *
-- * factors received from a single tracked GLONASS satellite.                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * GLONASS ICD.                                                             *
-- * sfu is solar flux unit = 10^-22 W/(Hz.m^2)                               *
-- *                                                                          *
-- ****************************************************************************
--
DataGLOUnscaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          GLOSignalID,
    wordPadding1                    Pad13bits,
    gloSatUnscaledIonoCorrections   GLOSatUnscaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GLOSatUnscaledIonoCorrections ::= CHOICE {
    fnav                            NULL,                               -- no ionospheric corrections available
    fmnav                           NULL,                               -- no ionospheric corrections available
    cnav                            GLOCNAVSatUnscaledIonoCorrections,
    reserved3                       GLOCNAVSatUnscaledIonoCorrections,  -- used as placeholder
    reserved4                       GLOCNAVSatUnscaledIonoCorrections,  -- used as placeholder
    reserved5                       GLOCNAVSatUnscaledIonoCorrections,  -- used as placeholder
    reserved6                       GLOCNAVSatUnscaledIonoCorrections,  -- used as placeholder
    reserved7                       GLOCNAVSatUnscaledIonoCorrections   -- used as placeholder
}

-- See string Type 25, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states value of least significant bit, if not 1, units and, optionally, (expected range)
GLOCNAVSatUnscaledIonoCorrections ::= SEQUENCE {
    cA                              Unsigned9,              -- 2^-7 dimensionless
    cF107                           Unsigned13,             -- 2^-4 sfu
    cAp                             Unsigned9,              -- 2^0 nT
    wordPadding1                    Pad1bits
}


-- ****************************************************************************
-- * GLONASS Scaled Iono Corrections                                          *
-- *                                                                          *
-- * Message name:    DataGLOScaledIonoCorrections                            *
-- * Message ID:      6367                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the broadcast ionospheric scaled correction        *
-- * factors received from a single tracked GLONASS satellite.                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * GLONASS ICD.                                                             *
-- * sfu is solar flux unit = 10^-22 W/(Hz.m^2)                               *
-- *                                                                          *
-- ****************************************************************************
--
DataGLOScaledIonoCorrections ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          GLOSignalID,
    wordPadding1                    Pad13bits,
    gloSatScaledIonoCorrections     GLOSatScaledIonoCorrections
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GLOSatScaledIonoCorrections ::= CHOICE {
    fnav                            NULL,                               -- no ionospheric corrections available
    fmnav                           NULL,                               -- no ionospheric corrections available
    cnav                            GLOCNAVSatScaledIonoCorrections,
    reserved3                       GLOCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved4                       GLOCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved5                       GLOCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved6                       GLOCNAVSatScaledIonoCorrections,    -- used as placeholder
    reserved7                       GLOCNAVSatScaledIonoCorrections     -- used as placeholder
}

-- See string Type 25, GLONASS ICD, CDMA OS Navigation Signal L1 frequency band, Edition 1.0
-- and GLONASS ICD, CDMA OS Navigation Signal L3 frequency band, Edition 1.0
-- Comment states units and, optionally, (expected range)
GLOCNAVSatScaledIonoCorrections ::= SEQUENCE {
    cA                              IEEE754Sp,              -- dimensionless
    cF107                           IEEE754Sp,              -- sfu
    cAp                             IEEE754Sp               -- nT
}


-- ****************************************************************************
-- * SBAS Message Type 0 - DO NOT USE FOR SAFETY APPLICATIONS MESSAGE         *
-- *                                                                          *
-- * Message name:    DataSBAS0                                               *
-- * Message ID:      6306                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 0 - Do not use ranging data from the sending prn.      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS0 ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    data                            SEQUENCE (SIZE(14)) OF Unsigned16   -- any data in least significant 212 bits
}


-- ****************************************************************************
-- * SBAS Message Type 1 - PRN Mask                                           *
-- *                                                                          *
-- * Message name:    DataSBAS1                                               *
-- * Message ID:      6377                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
