    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    iodF                            Unsigned2,                          -- IOD Fast
    iodP                            Unsigned2,                          -- IOD PRN
    prcF                            SEQUENCE (SIZE(13)) OF Signed12,    -- 0.125 metres
    udrei                           SEQUENCE (SIZE(13)) OF Unsigned4,   -- UDRE Indicators
    wordPadding1                    Pad12bits
}


