-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 7 - Provides fast correction degradation factors for   *
-- * PRNs as defined in DataSBAS1.                                            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS7Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    wordPadding1                    Pad4bits,
    tLatency                        INTEGER (0..15),                    -- System latency seconds
    wordPadding2                    Pad6bits,
    iodP                            INTEGER (0..3),                     -- IOD PRN
    wordPadding3                    Pad14bits,
    spare                           Unsigned2,                          -- spare
    wordPadding4                    Pad8bits,
    dfi                             SEQUENCE (SIZE(51)) OF SEQUENCE {
        wordPadding                     Pad4bits,
        dfi                             INTEGER (0..15)                     -- degradation factor indicators
    }
}


-- ****************************************************************************
-- * SBAS Message Type 9 - Unscaled GEO Navigation Message                    *
-- *                                                                          *
-- * Message name:    DataSBAS9Unscaled                                       *
-- * Message ID:      6455                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 9 - This message contains unscaled GEO navigation      *
-- * message parameters for a single SBAS satellite.                          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS9Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          SBASMultiSignalID,
    satID                           SatID,
    res                             Unsigned8,              -- reserved
    t0                              Unsigned13,             -- 16 seconds
    ura                             Unsigned4,              -- URA of 15 shows satellite ranging signal should not be used
    xG                              Signed30,               -- 0.08 metres
    yG                              Signed30,               -- 0.08 metres
    zG                              Signed25,               -- 0.4 metres
    xGdot                           Signed17,               -- 0.000625 metres/second
    yGdot                           Signed17,               -- 0.000625 metres/second
    zGdot                           Signed18,               -- 0.004 metres/second
    xGdot2                          Signed10,               -- 0.0000125 metres/second/second
    yGdot2                          Signed10,               -- 0.0000125 metres/second/second
    zGdot2                          Signed10,               -- 0.0000625 metres/second/second
    aGf0                            Signed12,               -- 2^-31 seconds
    aGf1                            Signed8,                -- 2^-40 seconds/second
    wordPadding                     Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 9 - Scaled GEO Navigation Message                      *
-- *                                                                          *
-- * Message name:    DataSBAS9Scaled                                         *
-- * Message ID:      6440                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 9 - This message contains scaled GEO navigation        *
-- * message parameters for a single SBAS satellite.                          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information for the various   *
-- * parameters can be found in: Minimum Operational Performance Standards    *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS9Scaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          SBASMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad8bits,
    res                             INTEGER (0..255),       -- reserved
    wordPadding1                    Pad15bits,
    t0                              INTEGER (0..86384),     -- seconds
    wordPadding2                    Pad12bits,
    ura                             INTEGER (0..15),        -- URA of 15 shows satellite ranging signal should not be used
    xG                              IEEE754Dp,              -- metres
    yG                              IEEE754Dp,              -- metres
    zG                              IEEE754Dp,              -- metres
    xGdot                           IEEE754Sp,              -- metres/second
    yGdot                           IEEE754Sp,              -- metres/second
    zGdot                           IEEE754Sp,              -- metres/second
    xGdot2                          IEEE754Sp,              -- metres/second/second
    yGdot2                          IEEE754Sp,              -- metres/second/second
    zGdot2                          IEEE754Sp,              -- metres/second/second
    aGf0                            IEEE754Sp,              -- seconds
    aGf1                            IEEE754Sp               -- seconds/second
}


-- ****************************************************************************
-- * SBAS Message Type 10 - Unscaled Degradation Factors Message              *
-- *                                                                          *
-- * Message name:    DataSBAS10Unscaled                                      *
-- * Message ID:      6288                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * SBAS Message Type 10 - Provides degradation factors.                     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- * Comment states value of least significant bit, if not 1, and units.      *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS10Unscaled ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    pBrrc                           Unsigned10,                 -- 0.002 metres
    pCltclsb                        Unsigned10,                 -- 0.002 metres
    pCltcv1                         Unsigned10,                 -- 0.00005 metres/second
    pIltcv1                         Unsigned9,                  -- seconds
    pCltcv0                         Unsigned10,                 -- 0.002 metres
    pIltcv0                         Unsigned9,                  -- seconds
    pCgeolsb                        Unsigned10,                 -- 0.0005 metres
    pCgeov                          Unsigned10,                 -- 0.00005 metres/second
    pIgeo                           Unsigned9,                  -- seconds
    pCer                            Unsigned6,                  -- 0.5 metres
    pCionostep                      Unsigned10,                 -- 0.001 metres
    pIiono                          Unsigned9,                  -- seconds
    pCionoramp                      Unsigned10,                 -- 0.000005 metres/second
    pRSSUDRE                        Unsigned1,                  -- unitless
    pRSSiono                        Unsigned1,                  -- unitless
    pCcovariance                    Unsigned7,                  -- 0.1 unitless
    spare1                          Unsigned1,                  -- spare bit
    spare80                         OCTET STRING (SIZE(10)),    -- spare 80 bits
    wordPadding1                    Pad12bits
}


-- ****************************************************************************
-- * SBAS Message Type 10 - Scaled Degradation Factors Message                *
-- *                                                                          *
-- * Message name:    DataSBAS10Scaled                                        *
-- * Message ID:      6297                                                    *
-- * Message status:  Optional(1)                                             *
