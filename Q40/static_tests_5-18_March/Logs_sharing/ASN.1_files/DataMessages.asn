-- *                                                                          *
-- * SBAS Message Type 1 - Contains the PRN Mask and IOD PRN.                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Details can be found in: Minimum Operational Performance Standards       *
-- * For Global Positioning System/Wide Area Augmentation System Airborne     *
-- * Equipment.                                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataSBAS1 ::= SEQUENCE {
    validityTime                    TimeStamp,
    satID                           SatID,
    dataSource                      DataSource,
    wordPadding                     Pad4bits,
    signal                          SBASSignalID,
    prnMask                         SEQUENCE (SIZE(14)) OF Unsigned16,  -- PRN mask in least significant 210 bits
    wordPadding1                    Pad14bits,
    iodP                            INTEGER (0..3)                      -- IOD PRN
}


-- ****************************************************************************
