GalFNAVSatUnscaledAlmanacs ::= SEQUENCE {
    satID                           Unsigned6,
    almanacIOD                      Unsigned4,              -- dimensionless
    almanacReferenceTime            Unsigned10,             -- 600 seconds
    almanacReferenceWeekNumber      Unsigned2,              -- 1 week
    deltaRootA                      Signed13,               -- 2^-9 sqrt(metres)
    ecc                             Unsigned11,             -- 2^-16 dimensionless
    deltaI                          Signed11,               -- 2^-14 semi-circles
    omega0                          Signed16,               -- 2^-15 semi-circles
    omegaDot                        Signed11,               -- 2^-33 semi-circles/second
    omega                           Signed16,               -- 2^-15 semi-circles
    m0                              Signed16,               -- 2^-15 semi-circles
    af0                             Signed16,               -- 2^-19 seconds
    af1                             Signed13,               -- 2^-38 seconds/second
    e5aHealthStatus                 GalSignalHealthIndicator,
    wordPadding                     Pad13bits
}

-- Comment states value of least significant bit, if not 1, and units.
GalINAVSatUnscaledAlmanacs ::= SEQUENCE {
    satID                           Unsigned6,
