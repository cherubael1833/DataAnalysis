-- ****************************************************************************
-- * Galileo Scaled Ephemeris and Clock                                       *
-- *                                                                          *
-- * Message name:    DataGalScaledEphemerisAndClock                          *
-- * Message ID:      6364                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains scaled ephemeris and clock corrections for a       *
-- * single Galileo satellite.                                                *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- *                                                                          *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Galileo Open Service Signal-in-Space Interface Control Document.         *
-- * If parameters are decoded from an F/NAV message, clock parameters relate *
-- * to the dual frequency E1,E5a combination. If parameters are decoded from *
-- * an I/NAV message, clock parameters relate to the dual frequency E1,E5b   *
-- * combination.                                                             *
-- *                                                                          *
-- ****************************************************************************
--
DataGalScaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          GalMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    galDecodedEphemeris             GalSatScaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
GalSatScaledEphemerisAndClock ::= CHOICE {
    fnav                            GalFNAVSatScaledEphemerisAndClock,
    inav                            GalINAVSatScaledEphemerisAndClock,
    reserved2                       GalFNAVSatScaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved3                       GalFNAVSatScaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved4                       GalFNAVSatScaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved5                       GalFNAVSatScaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved6                       GalFNAVSatScaledEphemerisAndClock,    -- F/NAV structure used as placeholder
    reserved7                       GalFNAVSatScaledEphemerisAndClock     -- F/NAV structure used as placeholder
}

GalFNAVSatScaledEphemerisAndClock ::= SEQUENCE {
    -- Issue of Data nav
    navIOD                          Unsigned16,             -- dimensionless

    -- Ephemeris parameters
    wordPadding                     Pad8bits,
    signalInSpaceAccuracy           Unsigned8,
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..982980),    -- seconds
    m0                              IEEE754Dp,              -- radians
    deltaN                          IEEE754Sp,              -- radians/second
    ecc                             IEEE754Dp,              -- dimensionless
    rootA                           IEEE754Dp,              -- sqrt(metres)
    omega0                          IEEE754Dp,              -- radians
    i0                              IEEE754Dp,              -- radians
    omega                           IEEE754Dp,              -- radians
    omegaDot                        IEEE754Sp,              -- radians/second
    iDot                            IEEE754Sp,              -- radians/second
    cuc                             IEEE754Sp,              -- radians
    cus                             IEEE754Sp,              -- radians
    crc                             IEEE754Sp,              -- metres
    crs                             IEEE754Sp,              -- metres
    cic                             IEEE754Sp,              -- radians
    cis                             IEEE754Sp,              -- radians

    -- Clock Parameters
    wordPadding2                    Pad12bits,
    clockReferenceTime              INTEGER (0..982980),    -- seconds
    af0                             IEEE754Dp,              -- seconds
    af1                             IEEE754Sp,              -- seconds/second
    af2                             IEEE754Sp,              -- seconds/second/second

    -- Navigation Message Dependent Parameters
    bgdE1E5a                        IEEE754Sp,              -- seconds
    wordPadding3                    Pad6bits,
    e5aHealthStatus                 GalSignalHealthIndicator,
    e5aDataValidityStatus           BOOLEAN,                -- as defined in Galileo-OS-SIS-ICD
    wordPadding4                    Pad7bits
}

GalINAVSatScaledEphemerisAndClock ::= SEQUENCE {
    -- Issue of Data nav
    navIOD                          Unsigned16,             -- dimensionless

    -- Ephemeris parameters
    wordPadding                     Pad8bits,
    signalInSpaceAccuracy           Unsigned8,
    wordPadding1                    Pad12bits,
    ephemerisReferenceTime          INTEGER (0..982980),    -- seconds
    m0                              IEEE754Dp,              -- radians
    deltaN                          IEEE754Sp,              -- radians/second
    ecc                             IEEE754Dp,              -- dimensionless
    rootA                           IEEE754Dp,              -- sqrt(metres)
    omega0                          IEEE754Dp,              -- radians
    i0                              IEEE754Dp,              -- radians
    omega                           IEEE754Dp,              -- radians
    omegaDot                        IEEE754Sp,              -- radians/second
    iDot                            IEEE754Sp,              -- radians/second
    cuc                             IEEE754Sp,              -- radians
    cus                             IEEE754Sp,              -- radians
    crc                             IEEE754Sp,              -- metres
    crs                             IEEE754Sp,              -- metres
    cic                             IEEE754Sp,              -- radians
    cis                             IEEE754Sp,              -- radians

    -- Clock Parameters
    wordPadding2                    Pad12bits,
    clockReferenceTime              INTEGER (0..982980),    -- seconds
    af0                             IEEE754Dp,              -- seconds
    af1                             IEEE754Sp,              -- seconds/second
    af2                             IEEE754Sp,              -- seconds/second/second

    -- Navigation Message Dependent Parameters
    bgdE1E5b                        IEEE754Sp,              -- seconds
    wordPadding3                    Pad4bits,
    e1bHealthStatus                 GalSignalHealthIndicator,
    e5bHealthStatus                 GalSignalHealthIndicator,
    e1bDataValidityStatus           BOOLEAN,                -- as defined in Galileo-OS-SIS-ICD
    e5bDataValidityStatus           BOOLEAN,                -- as defined in Galileo-OS-SIS-ICD
    wordPadding4                    Pad6bits
}


-- ****************************************************************************
-- * BeiDou Unscaled Ephemeris and Clock                                      *
-- *                                                                          *
-- * Message name:    DataBDSUnscaledEphemerisAndClock                        *
-- * Message ID:      6301                                                    *
-- * Message status:  Optional(1)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains unscaled ephemeris and clock corrections for a     *
-- * single BeiDou satellite.                                                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message contents depends on the type of navigation message decoded.  *
-- * Units and scaling factors for the various parameters can be found in:    *
-- * BeiDou Navigation Satellite System Signal In Space ICD.                  *
-- *                                                                          *
-- ****************************************************************************
--
DataBDSUnscaledEphemerisAndClock ::= SEQUENCE {
    validityTime                    TimeStamp,
    dataSource                      DataSource,
    signal                          BDSMultiSignalID,
    satID                           SatID,
    wordPadding                     Pad13bits,
    bdsUnscaledEphemerisAndClock    BDSSatUnscaledEphemerisAndClock
}

-- Choices 1 to 8 sent as 0 to 7 down the wire.
-- Padded to use 3 bits.
BDSSatUnscaledEphemerisAndClock ::= CHOICE {
    dnav                            BDSDNAVSatUnscaledEphemerisAndClock,
    cnav1                           BDSCNAVSatUnscaledEphemerisAndClock,
    cnav2                           BDSCNAVSatUnscaledEphemerisAndClock,
    reserved3                       BDSCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved4                       BDSCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved5                       BDSCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved6                       BDSCNAVSatUnscaledEphemerisAndClock,    -- used as placeholder
    reserved7                       BDSCNAVSatUnscaledEphemerisAndClock     -- used as placeholder
}

-- See Tables 5.10 & 5.7, BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B1I (Version 3.0), February 2019
-- Comment states value of least significant bit, if not 1, and units
BDSDNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

    -- Ephemeris Parameters
    ephemerisAOD                    Unsigned5,              -- see reference
    ephemerisReferenceTime          Unsigned17,             -- 2^3 seconds
    rootA                           Unsigned32,             -- 2^-19 sqrt(metres)
    ecc                             Unsigned32,             -- 2^-33 dimensionless
    omega                           Signed32,               -- 2^-31 semi-circles
    deltaN                          Signed16,               -- 2^-43 semi-circles/second
    m0                              Signed32,               -- 2^-31 semi-circles
    omega0                          Signed32,               -- 2^-31 semi-circles
    omegaDot                        Signed24,               -- 2^-43 semi-circles/second
    i0                              Signed32,               -- 2^-31 semi-circles
    iDot                            Signed14,               -- 2^-43 semi-circles/second
    cuc                             Signed18,               -- 2^-31 radians
    cus                             Signed18,               -- 2^-31 radians
    crc                             Signed18,               -- 2^-6 metres
    crs                             Signed18,               -- 2^-6 metres
    cic                             Signed18,               -- 2^-31 radians
    cis                             Signed18,               -- 2^-31 radians

    -- Clock Parameters
    clockAOD                        Unsigned5,              -- see reference
    clockReferenceTime              Unsigned17,             -- 2^3 seconds
    a0                              Signed24,               -- 2^-33 seconds
    a1                              Signed22,               -- 2^-50 seconds/second
    a2                              Signed11,               -- 2^-66 seconds/second/second

    -- Group Delay Parameters
    tGD1                            Signed10,               -- 0.1 nano seconds
    tGD2                            Signed10,               -- 0.1 nano seconds

    -- Satellite Health Parameters
    satH1                           Unsigned1,              -- '0' means broadcasting satellite is good and '1' means not
    wordPadding                     Pad4bits
}

-- See Tables 7.7, 7.5, 7.6 and 7.22,  BeiDou Navigation Satellite System, SIS, ICD, Open Service Signal B2a (Version 1.0), December 2017
-- Comment states value of least significant bit, if not 1, and units
BDSCNAVSatUnscaledEphemerisAndClock ::= SEQUENCE {

   -- Ephemeris Parameters
    ephemerisIOD                    Unsigned8,              -- see reference
    ephemerisReferenceTime          Unsigned11,             -- 300 seconds
    satOrbitType                    Unsigned2,              -- 01 (1) indicates the GEO satellite, 10 (2) indicates the IGSO satellite, 11 (3) indicates the MEO satellite, and 00 (0) is reserved.
    deltaA                          Signed26,               -- 2^-9 metres
    aDot                            Signed25,               -- 2^-21 metres/second
    deltaN0                         Signed17,               -- 2^-44 semi-circles/second
    deltaN0Dot                      Signed23,               -- 2^-57 semi-circles/second/second
    m0                              Signed33,               -- 2^-32 semi-circles
    ecc                             Unsigned33,             -- 2^-34 dimensionless
    omega                           Signed33,               -- 2^-32 semi-circles
    omega0                          Signed33,               -- 2^-32 semi-circles
    i0                              Signed33,               -- 2^-32 semi-circles
    omegaDot                        Signed19,               -- 2^-44 semi-circles/second
    i0Dot                           Signed15,               -- 2^-44 semi-circles/second
    cis                             Signed16,               -- 2^-30 radians
    cic                             Signed16,               -- 2^-30 radians
    crs                             Signed24,               -- 2^-8 metres
    crc                             Signed24,               -- 2^-8 metres
    cus                             Signed21,               -- 2^-30 radians
    cuc                             Signed21,               -- 2^-30 radians

    -- Clock Correction Parameters
    clockIOD                        Unsigned10,             -- see reference
    clockReferenceTime              Unsigned11,             -- 300 seconds
    a0                              Signed25,               -- 2^-34 seconds
    a1                              Signed22,               -- 2^-50 seconds/second
    a2                              Signed11,               -- 2^-66 seconds/second/second

    -- Group Delay Parameters
    tGDB1Cp                         Signed12,               -- 2^-34 seconds
    tGDB2ap                         Signed12,               -- 2^-34 seconds
    iscB1Cd                         Signed12,               -- 2^-34 seconds

    -- Satellite Health Parameters
    satHealthStatus                 Unsigned2,              -- 0 - satellite is healthy, 1 - satellite is unhealthy or in test, 2 and 3 - reserved
    wordPadding                     Pad10bits
}


