DataMessages DEFINITIONS
AUTOMATIC TAGS ::=

BEGIN

EXPORTS ALL ;

IMPORTS
    Pad1bits, Pad2bits, Pad3bits, Pad4bits, Pad5bits, Pad6bits, Pad7bits, Pad8bits,
    Pad9bits, Pad10bits, Pad11bits, Pad12bits, Pad13bits, Pad14bits, Pad15bits,
    Unsigned1, Unsigned2, Unsigned3, Unsigned4, Unsigned5, Unsigned6, Unsigned7,
    Unsigned8, Unsigned9, Unsigned10, Unsigned11, Unsigned12, Unsigned13, Unsigned14,
    Unsigned15, Unsigned16, Unsigned17, Unsigned20, Unsigned21, Unsigned24,
    Unsigned32, Unsigned33,
    Signed3, Signed4, Signed5, Signed6, Signed7, Signed8, Signed9, Signed10, Signed11,
    Signed12, Signed13, Signed14, Signed15, Signed16, Signed17, Signed18, Signed19,
    Signed20, Signed21, Signed22, Signed23, Signed24, Signed25, Signed26, Signed27,
    Signed28, Signed30, Signed31, Signed32, Signed33, Signed35, Signed40,
    IEEE754Sp, IEEE754Dp
    FROM FundamentalDataTypes

    TimeReference, DatumID, SatID, ConstellationID, MessageOctet, SignalID,
    GPSSignalID, GPSMultiSignalID, GalSignalID, GalMultiSignalID,
    BDSSignalID, BDSMultiSignalID, GLOSignalID, GLOMultiSignalID,
    SBASSignalID, SBASMultiSignalID,
    SatTrackingState, InterferenceAndJammingStatus, InterferenceAndJammingTypes,
    SpoofingAndMeaconingTypes, CyberAttackTypes, SpoofingMeaconingStatus,
    CyberAttackStatus, PositionFigureOfMerit, VelocityFigureOfMerit, QFlag,
    MultiSignalID, SatSignalHealth, GalSignalHealthIndicator, DataSource,
    TimeFigureOfMerit, PositionLLA, PositionXYZ, VelocityXYZ, VelocityENU,
    LeverArmXYZ, NavSolutionMode, RAIMMode, RAIMType, DilutionOfPrecision,
    SensorsInUse, CorrectionService, TimeStamp, DateTime, FixStatus, AngularDir,
    IonoCorrection, TropoCorrection, SatClockCorrection, MagneticVariationSource,
    NorthRef, Position, RouteID, WaypointID, WaypointIndex, LogicalTrackerID
    FROM CommonFieldDefinitions
;

-- ****************************************************************************
-- * Initialisation Input Data                                                *
-- *                                                                          *
-- * Message name:    DataInitialisationInputData                             *
-- * Message ID:      6427                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input                                                   *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message allows the user to provide the receiver with initial        *
-- * position, velocity and time to improve Time To First Fix (TTFF).         *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataInitialisationInputData ::= SEQUENCE {
    validityTime                    TimeStamp,
    initialisationValidity          InitialisationValidity,
    dateTime                        DateTime,
    position                        Position,
    groundSpeed                     IEEE754Sp,              -- metres/second
    track                           AngularDir              -- track bearing and reference
}

-- The receiver sets the corresponding validity field (TRUE = Valid) in message
-- TBD to indicate receipt of valid initialisation data. The receiver only uses
-- complete sets of the Time, position, velocity or lever arms components.
-- Padded to use 16 bits.
InitialisationValidity ::= SEQUENCE {
    dateTimeValid                   BOOLEAN,
    latitudeValid                   BOOLEAN,
    longitudeValid                  BOOLEAN,
    altitudeValid                   BOOLEAN,
    groundTrackValid                BOOLEAN,
    groundSpeedValid                BOOLEAN,
    reservedBits                    Pad10bits
}


-- ****************************************************************************
-- * Date Time                                                                *
-- *                                                                          *
-- * Message name:    DataDateTime                                            *
-- * Message ID:      6444                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides accurate time/date. This message qualifies the     *
-- * time of the preceding nPPS pulse. It can be both an output from the      *
-- * receiver or be used to provide time aiding to the receiver in            *
-- * association with a nPPS input.                                           *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * For rates up to 10PPS the absolute time of the selected nPPS pulse can   *
-- * be determined from the DataDateTime message which shall be output after  *
-- * its associated nPPS pulse and before the next nPPS pulse is output.  At  *
-- * rates above 10PPS the behaviour and timing is not standardised and shall *
-- * be as defined by the receiver supplier.  At rates up to 10PPS the host   *
-- * shall be responsible for ensuring that the total number of connected     *
-- * messages and baud rate/parity selection do not prevent the receiver from *
-- * providing DataDateTime for each nPPS pulse.                              *
-- *                                                                          *
-- * When it is to be used in coordination with the nPPS time marker output   *
-- * the DataDateTime message should be initiated by configuring the nPPS     *
-- * using CmndEnablePPSOutput, rather than by connecting to this message     *
-- * directly.                                                                *
-- *                                                                          *
-- ****************************************************************************
--
DataDateTime ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    estimatedTimeOffsetAccuracy     IEEE754Sp,              -- seconds (1 sigma accuracy)
    wordPadding                     Pad8bits,
    port                            INTEGER (0..255)        -- Port Number of the PPS output
}


-- ****************************************************************************
-- * Event Date Time                                                          *
-- *                                                                          *
-- * Message name:    DataEventDateTime                                       *
-- * Message ID:      6252                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message reports the time associated with an input pulse on one of   *
-- * the receiver's event marker inputs.                                      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataEventDateTime ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    estimatedTimeOffsetAccuracy     IEEE754Sp,              -- seconds (1 sigma accuracy)
    wordPadding                     Pad8bits,
    port                            INTEGER (0..255)        -- Port Number of the event marker input
}


-- ****************************************************************************
-- * Semi Precise Date Time Transfer/Aiding                                   *
-- *                                                                          *
-- * Message name:    DataSemiPreciseDateTime                                 *
-- * Message ID:      6299                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message allows semi precise time transfer without the need to       *
-- * utilise a discrete timing marker. The achieved time accuracy depends on  *
-- * the accuracy with which the message is transmitted. The total estimated  *
-- * time uncertainty includes both the uncertainty with which the source     *
-- * knows time and the uncertainty in propagation time.                      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message allows semi precise time transfer in either direction. The  *
-- * fully qualified semi-precise time can be determined from the dateTime    *
-- * field and the sub-second component of TOW in validityTime. The timing    *
-- * reference for the message is the start time of the message               *
-- * synchronisation word (SOH/DEL).                                          *
-- *                                                                          *
-- * The field 'timeUncertainty' indicates to the receiving end of the        *
-- * transfer how accurately the time transfer is expected to be but it is    *
-- * additionally subject to the accuracy with which the receiving end is     *
-- * able to recover and process the message and delays in the transmission   *
-- * path.                                                                    *
-- *                                                                          *
-- * To achieve time transfer from the receiver to host, the host will        *
-- * connect to this message as normal for the required duration. To provide  *
-- * semi-precise time aiding to a receiver, the host sends this message to   *
-- * the receiver.                                                            *
-- *                                                                          *
-- * It is the responsibility of the host to manage the number of connected   *
-- * messages in order to maximise the achievable accuracy. Accuracy is       *
-- * likely to be improved by making use of multiple message transmissions.   *
-- *                                                                          *
-- * This message is only intended to support semi-precise time between the   *
-- * receiver and a locally connected host. Where time transfer is required   *
-- * to a remote host other standard transfer protocols should be utilised    *
-- * between the local and remote host.                                       *
-- *                                                                          *
-- ****************************************************************************
--
DataSemiPreciseDateTime ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    timeUncertainty                 IEEE754Sp               -- seconds (estimated accuracy of time transferred)
}


-- ****************************************************************************
-- * PVT Message                                                              *
-- *                                                                          *
-- * Message name:    DataPVT                                                 *
-- * Message ID:      6349                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides a short PVT message and can be used as an          *
-- * alternative to the Core Navigation Dataset Message.                      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Refer to National Geospatial-Intelligence Agency Standardization         *
-- * Document, Universal Grids and Grid Reference Systems.                    *
-- *                                                                          *
-- * Position measurements use Latitude, Longitude, Altitude (degrees,        *
-- * degrees, metres) or a selected Grid Eastings, Northings, Altitude        *
-- * (metres, metres, metres) using the selected datum coordinate system and  *
-- * altitude reference.                                                      *
-- *                                                                          *
-- * FixStatus = none (0), indicates that no PVT is available.                *
-- * In such a scenario it is recommended that the following values are used: *
-- * - position = [0,0,0] (DatumID, AltitudeRef, PositionFormatID)            *
-- * -            [0,0,-6378137] (latitude, longitude, altitude)              *
-- * - groundSpeed = [0]                                                      *
-- * - track = [0,0] (bearing, NorthRef)                                      *
-- * - estimated Errors = maximum value of variable type                      *
-- *                                                                          *
-- ****************************************************************************
--
DataPVT ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    position                        Position,               -- see Notes
    groundSpeed                     IEEE754Sp,              -- metres/second
    track                           AngularDir,             -- track bearing and reference
    geoidEllipsoidSeparation        IEEE754Sp,              -- metres (gives the geoid minus ellipsoid value)
    magneticVariation               IEEE754Sp,              -- degrees (-180.0 <= value < +180.0) positive when magnetic North is East of true North
    wordPadding                     Pad4bits,
    magneticVariationSource         MagneticVariationSource,
    qFlag                           QFlag,
    encryptedServiceUsed            BOOLEAN,                -- True if at least one encrypted service has been utilised
    authenticatedServiceUsed        BOOLEAN,                -- True if at least one authenticated service has been utilised
    fixAided                        BOOLEAN,
    wordPadding1                    Pad4bits,
    fixStatus                       FixStatus,
    positionFigureOfMerit           PositionFigureOfMerit,  -- 3-D position FOM
    velocityFigureOfMerit           VelocityFigureOfMerit,
    timeFigureOfMerit               TimeFigureOfMerit
}


-- ****************************************************************************
-- * Core Navigation Solution                                                 *
-- *                                                                          *
-- * Message name:    DataCoreNavSolution                                     *
-- * Message ID:      6402                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * The core navigation solution dataset returns a navigation solution       *
-- * together with estimated errors and information on the quality of the     *
-- * integrated navigation solution which has been calculated using one or    *
-- * more navigation sensors (e.g. GNSS and INS).                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Position measurements use Latitude, Longitude, Altitude (degrees,        *
-- * degrees, metres above ellipsoid) using the selected datum coordinate     *
-- * system. Velocity measurements use East, North, Up (metres, metres,       *
-- * metres) using the selected datum coordinate system.                      *
-- *                                                                          *
-- * FixStatus = none (0), indicates that no PVT is available.                *
-- * In such a scenario it is recommended that the following values are used: *
-- * - position = [0,0,-6378137]                                              *
-- * - heightAboveGeoid = [0]                                                 *
-- * - velocity = [0,0,0]                                                     *
-- * - estimated Errors = maximum value of variable type                      *
-- *                                                                          *
-- * When this message is transmitted by a GNSS sensor the errors defined     *
-- * within are calculated by the GNSS sensor itself. When it is              *
-- * transmitted by a combined GNSS sensor and an inertial sensor the         *
-- * errors defined within are calculated by the combined navigation system.  *
-- *                                                                          *
-- * The reported errors do not include datum transformation errors and       *
-- * users should seek clarification from vendors about their specific        *
-- * implementations.                                                         *
-- *                                                                          *
-- ****************************************************************************
--
DataCoreNavSolution ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    position                        PositionLLA,            -- Lat, Lon and Altitude (height above ellipsoid) - see Notes
    heightAboveGeoid                IEEE754Dp,              -- metres (height above the WGS-84 geoid )
    velocity                        VelocityENU,            -- see Notes
    magneticVariation               IEEE754Sp,
    wordPadding                     Pad4bits,
    magneticVariationSource         MagneticVariationSource,
    qFlag                           QFlag,
    encryptedServiceUsed            BOOLEAN,                -- True if at least one encrypted service has been utilised
    authenticatedServiceUsed        BOOLEAN,                -- True if at least one authenticated service has been utilised
    fixAided                        BOOLEAN,
    wordPadding1                    Pad4bits,
    datumID                         DatumID,
    estimatedHorizPosErr            IEEE754Sp,              -- metres (1 sigma accuracy)
    estimatedVertPosErr             IEEE754Sp,              -- metres (1 sigma accuracy)
    estimatedTimeError              IEEE754Sp,              -- seconds (1 sigma accuracy)
    estimatedHorizVelErr            IEEE754Sp,              -- metres/second (1 sigma accuracy)
    estimatedVertVelErr             IEEE754Sp,              -- metres/second (1 sigma accuracy)
    estimatedTimeRateErr            IEEE754Sp,              -- seconds/second (1 sigma accuracy)
    wordPadding2                    Pad4bits,
    fixStatus                       FixStatus,
    altitudeHeld                    BOOLEAN,                -- True if altitude is not calculated in the navigation solution but is set to a fixed/known value
    clockHeld                       BOOLEAN,                -- True if clock bias is not calculated in the navigation solution but is set to a fixed/known value
    leverArmInUse                   BOOLEAN,
    wordPadding3                    Pad5bits,
    timeSinceLastGoodFix            INTEGER (0..255),       -- seconds (0 indicates < 1 seconds, 255 indicates > 254 seconds)
    timeSinceLastNavSolModeChange   INTEGER (0..255),       -- seconds (0 indicates < 1 seconds, 255 indicates > 254 seconds)
    satsInSolution                  Unsigned8,              -- total number of satellites used in the solution
    satsInSolutionWithThreshCN0     Unsigned8,              -- Refers to the number of satellites in solution with a C/N0 > 30 dB/Hz for at least one signal
    satsInSolutionTrackedInState5   Unsigned8,              -- Refers to the number of satellites in solution tracked in State 5 (carrier phase tracking and demodulating data)
    navSolutionMode                 NavSolutionMode,
    raimMode                        RAIMMode,
    dilutionOfPrecision             DilutionOfPrecision,    -- DOP is determined from the satellites in use only.  A DOP over 6 indicates an unstable navigation solution.
    sensorsInUse                    SensorsInUse,
    ionoCorrectionInUse             IonoCorrection,
    tropoCorrectionInUse            TropoCorrection,
    correctionsInUse                CorrectionService,
    wordPadding4                    Pad4bits,
    leverArmValue                   LeverArmXYZ,
    servicesInUse                   MultiSignalID
}


-- ****************************************************************************
-- * Core ECEF Navigation solution                                            *
-- *                                                                          *
-- * Message name:    DataCoreECEFNavSolution                                 *
-- * Message ID:      6269                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * The core ECEF navigation solution dataset returns an ECEF navigation     *
-- * solution together with error estimates and information on the quality    *
-- * of the integrated navigation solution which has been calculated using    *
-- * one or more navigation sensors (e.g. GNSS and INS).                      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Position and Velocity measurements use an ECEF coordinate system with    *
-- * the WGS-84 datum origin.                                                 *
-- *                                                                          *
-- * FixStatus = none (0), indicates that no PVT is available.                *
-- * In such a scenario it is recommended that the following values are used: *
-- * - position = [0,0,0]                                                     *
-- * - velocity = [0,0,0]                                                     *
-- * - estimated Errors = maximum value of variable type                      *
-- *                                                                          *
-- * When this message is transmitted by a GNSS sensor the errors defined     *
-- * within are calculated by the GNSS sensor itself. When it is              *
-- * transmitted by a combined GNSS sensor and an inertial sensor the         *
-- * errors defined within are calculated by the combined navigation system.  *
-- *                                                                          *
-- ****************************************************************************
--
DataCoreECEFNavSolution ::= SEQUENCE {
    validityTime                    TimeStamp,
    dateTime                        DateTime,
    position                        PositionXYZ,
    velocity                        VelocityXYZ,
    qFlag                           QFlag,
    encryptedServiceUsed            BOOLEAN,                -- True if at least one encrypted service has been utilised
    authenticatedServiceUsed        BOOLEAN,                -- True if at least one authenticated service has been utilised
    fixAided                        BOOLEAN,
    wordPadding                     Pad12bits,
    estimatedXPosErr                IEEE754Sp,              -- metres (1 sigma accuracy)
    estimatedYPosErr                IEEE754Sp,              -- metres (1 sigma accuracy)
    estimatedZPosErr                IEEE754Sp,              -- metres (1 sigma accuracy)
    estimatedTimeError              IEEE754Sp,              -- seconds (1 sigma accuracy)
    estimatedXVelErr                IEEE754Sp,              -- metres/second (1 sigma accuracy)
    estimatedYVelErr                IEEE754Sp,              -- metres/second (1 sigma accuracy)
    estimatedZVelErr                IEEE754Sp,              -- metres/second (1 sigma accuracy)
    estimatedTimeRateErr            IEEE754Sp,              -- seconds/second (1 sigma accuracy)
    wordPadding1                    Pad4bits,
    fixStatus                       FixStatus,
    altitudeHeld                    BOOLEAN,                -- True if altitude is not calculated in the navigation solution but is set to a fixed/known value
    clockHeld                       BOOLEAN,                -- True if clock bias is not calculated in the navigation solution but is set to a fixed/known value
    leverArmInUse                   BOOLEAN,
    wordPadding2                    Pad5bits,
    timeSinceLastGoodFix            INTEGER (0..255),       -- seconds (0 indicates < 1 seconds, 255 indicates > 254 seconds)
    timeSinceLastNavSolModeChange   INTEGER (0..255),       -- seconds (0 indicates < 1 seconds, 255 indicates > 254 seconds)
    satsInSolution                  Unsigned8,              -- total number of satellites used in the solution
    satsInSolutionWithThreshCN0     Unsigned8,              -- Refers to the number of satellites in solution with a C/N0 > 30 dB/Hz for at least one signal
    satsInSolutionTrackedInState5   Unsigned8,              -- Refers to the number of satellites in solution tracked in State 5 (carrier phase tracking and demodulating data)
    navSolutionMode                 NavSolutionMode,
    raimMode                        RAIMMode,
    dilutionOfPrecision             DilutionOfPrecision,    -- DOP is determined from the satellites in use only. A DOP over 6 indicates an unstable navigation solution.
    sensorsInUse                    SensorsInUse,
    ionoCorrectionInUse             IonoCorrection,
    tropoCorrectionInUse            TropoCorrection,
    correctionsInUse                CorrectionService,
    wordPadding3                    Pad4bits,
    leverArmValue                   LeverArmXYZ,
    servicesInUse                   MultiSignalID
}


-- ****************************************************************************
-- * Core ECEF Nav Covariance matrix                                          *
-- *                                                                          *
-- * Message name:    DataCoreECEFNavCovariance                               *
-- * Message ID:      6420                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * Returns the diagonal and off-diagonal (single sided) elements of the     *
-- * symmetric covariance matrix of the position and velocity components (in  *
-- * ECEF) of the navigation solution state vector.                           *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The diagram below shows the order of transmission of the covariance      *
-- * matrix with the position variance (X,Y,Z) and velocity variance          *
-- * (X',Y',Z') information on the diagonal axis. Only the upper right of     *
-- * the matrix is sent (elements marked '.' are not sent). This is because   *
-- * the covariance matrix is symmetrical around the diagonal. The off        *
-- * diagonal elements, the covariances, describe the correlations between    *
-- * the errors in the different state vector estimates.                      *
-- *                                                                          *
-- * The units of the measurements that the covariance is derived for are     *
-- * metres for position and metres/s for velocity.                           *
-- *                                                                          *
-- * |           1(X)     2        3        4        5        6               *
-- * |           .        7(Y)     8        9       10       11               *
-- * |           .        .       12(Z)    13       14       15               *
-- * |           .        .        .       16(X')   17       18               *
-- * |           .        .        .        .       19(Y')   20               *
-- * |           .        .        .        .        .       21(Z')           *
-- *                                                                          *
-- * The validity time may be used to associate the covariance matrix with    *
-- * core nav data measurements in the same measurement epoch.                *
-- *                                                                          *
-- ****************************************************************************
--
DataCoreECEFNavCovariance ::= SEQUENCE {
    validityTime                                TimeStamp,
    covMatrix                                   SEQUENCE (SIZE(21)) OF IEEE754Sp
}


-- ****************************************************************************
-- * RAIM Statistics and Integrity                                            *
-- *                                                                          *
-- * Message name:    DataRAIMStats                                           *
-- * Message ID:      6265                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the Receiver Autonomous Integrity Monitor (RAIM)   *
-- * output alerts, statistics and integrity data.                            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataRAIMStats ::= SEQUENCE {
    validityTime                    TimeStamp,
    raimType                        RAIMType,
    raimMode                        RAIMMode,
    raimIntegrity                   RAIMIntegrity,
    hERLPosition                    IEEE754Sp,              -- metres
    vERLPosition                    IEEE754Sp,              -- metres
    hERLVelocity                    IEEE754Sp,              -- metres/second
    vERLVelocity                    IEEE754Sp,              -- metres/second
    testStatistic                   IEEE754Sp               -- Overall model test statistic for the PVT, divided by the test threshold
}

RAIMIntegrity ::= SEQUENCE {
-- Padded to use 4 bits.
    integrityStatus                 ENUMERATED {
        raimIntStatusSuccessful,        -- RAIM successful
        raimIntStatusFailed,            -- RAIM failed
        raimIntStatusUnavailable,       -- RAIM unavailable
        reserved3,
        reserved4,
        reserved5,
        reserved6,
        reserved7,
        reserved8,
        reserved9,
        reserved10,
        reserved11,
        reserved12,
        reserved13,
        reserved14,
        reserved15
    },
    verticalAlarmTriggered          BOOLEAN,
    horizontalAlarmTriggered        BOOLEAN,
    navSolutionTimeAlarmTriggered   BOOLEAN,
    fSEAlarmTriggered               BOOLEAN
}


-- ****************************************************************************
-- * Threat Summary Report                                                    *
-- *                                                                          *
-- * Message name:    DataThreatSummary                                       *
-- * Message ID:      6315                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides a summary of any interference/jamming,             *
-- * spoofing/meaconing and RF cyber threats that have been detected and how  *
-- * the receiver is responding to these threats. It does not provide detail  *
-- * of the threats on a signal by signal basis (see                          *
-- * DataThreatDetailedReport).                                               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataThreatSummary ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad4bits,
    jammingStatus                   InterferenceAndJammingStatus,
    wordPadding1                    Pad6bits,
    spoofingStatus                  SpoofingMeaconingStatus,
    wordPadding2                    Pad6bits,
    cyberAttackStatus               CyberAttackStatus,
    wordPadding3                    Pad8bits
}


-- ****************************************************************************
-- * Threat Detailed Report                                                   *
-- *                                                                          *
-- * Message name:    DataThreatDetailedReport                                *
-- * Message ID:      6438                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message reports the Jamming/Spoofing/CyberAttack receiver status    *
-- * on a signal by signal basis (for signals that are selected for use).     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataThreatDetailedReport ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages in this report
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    reports                         ThreatReports
}

-- The receiver may output multiple reports, limited by the maximum message
-- length. The receiver may also choose to output this message multiple times
-- to report on different subsets of signals. The receiver will only report for
-- signals that are selected for use.
ThreatReports ::= SEQUENCE {
    wordPadding                     Pad12bits,
    threatReports                   SEQUENCE (SIZE(0..15)) OF SEQUENCE {
        gnssSignal                      SignalID,
        signalPowerMeasurementValid     BOOLEAN,
        signalPower                     Unsigned7,              -- dB-Hz: Mean received in-band signal power density (dB-Hz).  Reported as dB above -204 dBW
        wordPadding                     Pad4bits,
        interferenceJammingStatus       InterferenceAndJammingStatus,
        detectedJammingTypes            InterferenceAndJammingTypes,
        perSatInfo                      SatThreatReports
    }
}

SatThreatReports ::= SEQUENCE {
    wordPadding                     Pad10bits,
    satThreatReports                SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        satID                           SatID,
        signalMeasuredJS                Unsigned8,
        wordPadding                     Pad2bits,
        jammingToSignalRatioType        ENUMERATED {
            jtsrtNotAvailable,              -- No J/S measurements available
            jtsrtRxOnly,                    -- J/S measurements assessed ref receiver input
            jtsrtAntenna                    -- J/S assessed ref antenna received signal
        },
        spoofingMeaconingStatus         SpoofingMeaconingStatus,    -- Signal Measured Jammer to Signal ratio.  Reported J/S in dB
        cyberAttackStatus               CyberAttackStatus,
        spoofingAndMeaconingTypes       SpoofingAndMeaconingTypes,
        cyberAttackTypes                CyberAttackTypes
    }
}


-- ****************************************************************************
-- * Satellite Range Information (Corrected)                                  *
-- *                                                                          *
-- * Message name:    DataCorrectedSatRangeInfo                               *
-- * Message ID:      6270                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message type is used to provide corrected GNSS satellite range      *
-- * information for all satellites being tracked by the receiver.            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message can also be used to pass corrected ranging information to   *
-- * the receiver from another GNSS sensor.                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataCorrectedSatRangeInfo ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of corrected range messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of corrected range message being reported (0 to N-1)
    wordPadding                     Pad12bits,
    navSolutionMode                 NavSolutionMode,
    signalRangeInfos                CorrectedSignalRangeInfos
}

-- Shall include multiple SignalRangeInfo objects, one per signal per satellite in the message
CorrectedSignalRangeInfos ::= SEQUENCE {
    correctedSignalRangeInfo        SEQUENCE (SIZE(0..65535)) OF SEQUENCE {
        signalRangeInfo                 SignalRangeInfo,
        satClockCorrectionInUse         SatClockCorrection,
        ionoCorrectionInUse             IonoCorrection,
        tropoCorrectionInUse            TropoCorrection,
        rxClockCorrectionInUse          BOOLEAN,
        wordPadding                     Pad3bits
    }
}

SignalRangeInfo ::= SEQUENCE {
    signalID                        SignalID,
    satID                           SatID,
    wordPadding                     Pad12bits,
    trackingState                   SatTrackingState,
    pseudoRange                     IEEE754Dp,              -- metres
    pseudoRangeRate                 IEEE754Dp,              -- metres/second
    accumulatedDeltaRange           IEEE754Dp,              -- cycles
    pseudoRangeStdDeviation         IEEE754Sp,              -- metres
    pseudoRangeRateStdDeviation     IEEE754Sp,              -- metres/second
    accumDeltaRangeStdDeviation     IEEE754Sp,              -- cycles
    cN0                             IEEE754Sp,              -- dB-Hz
    continuousTrackingTime          IEEE754Sp               -- seconds: Number of seconds of continuous tracking (no cycle slipping)
}


-- ****************************************************************************
-- * Satellite Range Information (Raw)                                        *
-- *                                                                          *
-- * Message name:    DataRawSatRangeInfo                                     *
-- * Message ID:      6359                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message type is used to provide raw (uncorrected) GNSS satellite    *
-- * range information for all satellites being tracked by the receiver.      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Raw measurements are not corrected for atmospheric, satellite clock or   *
-- * deliberately introduced range errors. This message can also be used to   *
-- * pass ranging information to the receiver from another GNSS sensor.       *
-- *                                                                          *
-- * Message can be issued multiple times within one epoch to provide         *
-- * information for all signals/satellites being tracked.                    *
-- *                                                                          *
-- ****************************************************************************
--
DataRawSatRangeInfo ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of range messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of range message being reported (0 to N-1)
    wordPadding                     Pad12bits,
    navSolutionMode                 NavSolutionMode,
    signalRangeInfos                RawSignalRangeInfos
}

-- Shall include multiple SignalRangeInfo objects, one per signal per satellite in the
-- message
RawSignalRangeInfos ::= SEQUENCE {
    rawSignalRangeInfos             SEQUENCE (SIZE(0..65535)) OF SignalRangeInfo
}


-- ****************************************************************************
-- * Satellite Range Residuals                                                *
-- *                                                                          *
-- * Message name:    DataSatRangeResiduals                                   *
-- * Message ID:      6300                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message type is used to provide the residuals of the GNSS satellite *
-- * ranges for all satellites being tracked by the receiver.                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataSatRangeResiduals ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of corrected range messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of corrected range message being reported (0 to N-1)
    rangeResiduals                  RangeResiduals
}

RangeResiduals ::= SEQUENCE {
    rangeResiduals                  SEQUENCE (SIZE(0..65535)) OF SEQUENCE {
        signalID                        SignalID,
        satID                           SatID,
        rangeResidual                   IEEE754Sp,              -- metres
        rangeRateResidual               IEEE754Sp,              -- metres/second
        cN0                             IEEE754Sp               -- dB-Hz
    }
}


-- ****************************************************************************
-- * Satellites In View                                                       *
-- *                                                                          *
-- * Message name:    DataSatsInView                                          *
-- * Message ID:      6361                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message details the satellites in view.                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The list contains all satellites as determined by the almanacs           *
-- * currently held in the receiver and does not necessarily mean they are    *
-- * being tracked by the receiver. Status information is also provided on    *
-- * each of the services from the satellites.                                *
-- *                                                                          *
-- * The message is sent in multiple, ordered blocks with only satellites     *
-- * from a single constellation in each block. The constellation ID is       *
-- * specified in the message head.                                           *
-- *                                                                          *
-- * The satsInUse boolean reported for each satellite indicates whether the  *
-- * satellite is being used to generate a navigation solution. If only the   *
-- * satellites in use are of interest, DataSatsInUse can be requested        *
-- * instead.                                                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataSatsInView ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    constellationID                 ConstellationID,
    satellitesInView                SatsInView
}

SatsInView ::= SEQUENCE {
    wordPadding                     Pad10bits,
    satsInView                      SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        satID                           SatID,
        elevationAndAzimuthValid        BOOLEAN,
        satInUse                        BOOLEAN,
        wordPadding                     Pad14bits,
        satelliteElevation              IEEE754Sp,              -- degrees (-90.0 <= value <= +90.0)
        satelliteAzimuth                IEEE754Sp,              -- degrees (-180.0 <= value < +180.0)
        signalsInView                   SignalsInfo
    }
}

SignalsInfo ::= SEQUENCE {
    wordPadding                     Pad12bits,
    signalsInfo                     SEQUENCE (SIZE(0..15)) OF SEQUENCE {
        signalID                        SignalID,
        logicalTrackerID                LogicalTrackerID,
        cN0                             IEEE754Sp,              -- dB-Hz
        wordPadding                     Pad4bits,
        trackingState                   SatTrackingState,
        wordPadding1                    Pad5bits,
        satSignalHealth                 SatSignalHealth
    }
}

-- ****************************************************************************
-- * Satellites In View ECEF                                                  *
-- *                                                                          *
-- * Message name:    DataSatsInViewECEF                                      *
-- * Message ID:      6413                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message details the satellites in view.                             *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The list contains all satellites as determined by the almanacs currently *
-- * held in the receiver and does not necessarily mean they are being        *
-- * tracked by the receiver. Status information is also provided on each of  *
-- * the services from the satellites.                                        *
-- *                                                                          *
-- * The message is sent in multiple, ordered blocks with only satellites     *
-- * from a single constellation in each block. The constellation ID is       *
-- * specified in the message head.                                           *
-- *                                                                          *
-- * The satsInUse boolean reported for each satellite indicates whether the  *
-- * satellite is being used to generate a navigation solution. If only the   *
-- * satellites in use are of interest, DataSatsInUseECEF can be requested    *
-- * instead.                                                                 *
-- *                                                                          *
-- * Position uses an ECEF coordinate system with the WGS-84 datum origin.    *
-- *                                                                          *
-- ****************************************************************************
--
DataSatsInViewECEF ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    constellationID                 ConstellationID,
    satellitesInView                SatsInViewECEF
}

SatsInViewECEF ::= SEQUENCE {
    wordPadding                     Pad10bits,
    satsInView                      SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        satID                           SatID,
        positionValid                   BOOLEAN,
        satInUse                        BOOLEAN,
        wordPadding                     Pad14bits,
        position                        PositionXYZ,
        signalsInView                   SignalsInfo
    }
}


-- ****************************************************************************
-- * Satellites In Use                                                        *
-- *                                                                          *
-- * Message name:    DataSatsInUse                                           *
-- * Message ID:      6318                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message details the satellites/signals used to generate a           *
-- * navigation solution.                                                     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message is sent in multiple, ordered blocks with only satellites     *
-- * from a single constellation in each block. The constellation ID is       *
-- * specified in the message head.                                           *
-- *                                                                          *
-- * Satellites/signals rejected by RAIM will not be included in this         *
-- * message.                                                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataSatsInUse ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    constellationID                 ConstellationID,
    satellitesInUse                 SatsInUse
}

SatsInUse ::= SEQUENCE {
    wordPadding                     Pad10bits,
    satsInUse                       SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        satID                           SatID,
        elevationAndAzimuthValid        BOOLEAN,
        wordPadding                     Pad15bits,
        satelliteElevation              IEEE754Sp,              -- degrees (-90.0 <= value <= +90.0)
        satelliteAzimuth                IEEE754Sp,              -- degrees (-180.0 <= value < +180.0)
        signalsInUse                    SignalsInfo
    }
}

-- ****************************************************************************
-- * Satellites In Use ECEF                                                   *
-- *                                                                          *
-- * Message name:    DataSatsInUseECEF                                       *
-- * Message ID:      6425                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message details the satellites/signals used to generate a           *
-- * navigation solution.                                                     *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message is sent in multiple, ordered blocks with only satellites     *
-- * from a single constellation in each block. The constellation ID is       *
-- * specified in the message head.                                           *
-- *                                                                          *
-- * Satellites/signals rejected by RAIM will not be included in this         *
-- * message.                                                                 *
-- *                                                                          *
-- * Position uses an ECEF coordinate system with the WGS-84 datum origin.    *
-- *                                                                          *
-- ****************************************************************************
--
DataSatsInUseECEF ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to be reported this epoch (N)
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
    constellationID                 ConstellationID,
    satellitesInUse                 SatsInUseECEF
}

SatsInUseECEF ::= SEQUENCE {
    wordPadding                     Pad10bits,
    satsInUse                       SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        satID                           SatID,
        positionValid                   BOOLEAN,
        wordPadding                     Pad15bits,
        position                        PositionXYZ,
        signalsInUse                    SignalsInfo
    }
}


-- ****************************************************************************
-- * Set Magnetic Variation Correction                                        *
-- *                                                                          *
-- * Message name:    DataMagVarCorrection                                    *
-- * Message ID:      6311                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message sets the magnetic variation correction to be used.          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataMagVarCorrection ::= SEQUENCE {
    wordPadding                     Pad12bits,
    magneticCorrectionSource        MagneticVariationSource,
    magneticVariationValue          IEEE754Sp               -- degrees (-180.0 <= value < +180.0)
}


-- ****************************************************************************
-- * Set Magnetic Deviation Correction                                        *
-- *                                                                          *
-- * Message name:    DataMagDevCorrection                                    *
-- * Message ID:      6317                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message sets the magnetic deviation correction values to be used.   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The deviation values provided are applied evenly over the full 360       *
-- * degrees circle starting at 0 degrees magnetic. E.g. with                 *
-- * magDevCorrectionType set to magDevCorrectionTypeManual, a sequence of    *
-- * 36 deviationValues would define the deviation corrections from 0 to 350  *
-- * degrees in 10 degree intervals (i.e. at 0, 10, 20, ...., 340, 350).      *
-- *                                                                          *
-- * The widely used sense of MagDev corrections is utilised such that the    *
-- * relevant deviation value will be added to the measured magnetic sensor   *
-- * (compass) bearing to obtain a corrected magnetic bearing.                *
-- *                                                                          *
-- ****************************************************************************
--
DataMagDevCorrection ::= SEQUENCE {
    wordPadding                     Pad14bits,
    magDevCorrectionType            ENUMERATED {
        magDevCorrectionTypeAuto,                               -- Receiver to calculate and utilise its own MagDev corrections (if supported)
        magDevCorrectionTypeOff,                                -- Do not apply MagDev corrections - any deviation values supplied will be ignored
        magDevCorrectionTypeManual                              -- Use supplied deviation values
    },
    wordPadding2                    Pad9bits,
    deviationValues                 SEQUENCE (SIZE(0..72)) OF IEEE754Sp     -- See Notes
}


-- ****************************************************************************
-- * NMEA Encapsulated Message                                                *
-- *                                                                          *
-- * Message name:    DataNMEAMessage                                         *
-- * Message ID:      6264                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * Data message for encapsulated NMEA sentences.                            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataNMEAMessage ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad8bits,
    nmeaSentence                    SEQUENCE (SIZE(0..255)) OF MessageOctet
}


-- ****************************************************************************
-- * RTCM104 Encapsulated Message                                             *
-- *                                                                          *
-- * Message name:    DataRTCM104Message                                      *
-- * Message ID:      6292                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message is nominally for input but could also be an output data     *
-- * message.                                                                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataRTCM104Message ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad15bits,
    rtcm104Message                  CHOICE {
        rtcm104V2Message                SEQUENCE {
            header                          SEQUENCE (SIZE(4)) OF RTCM104Word,
            wordPadding                     Pad11bits,
            payload                         SEQUENCE (SIZE(0..31)) OF RTCM104Word
        },
        rtcm104V3Message                SEQUENCE {
            minorVersion                    INTEGER (0..63),
            payload                         SEQUENCE (SIZE(0..1023)) OF MessageOctet,
            checksum                        OCTET STRING (SIZE(3))
        }
    }
}

RTCM104Word ::= OCTET STRING (SIZE(4))      -- RTCM 30 bit word occupies least significant 30 bits of 4 byte structure


-- ****************************************************************************
-- * Attitude                                                                 *
-- *                                                                          *
-- * Message name:    DataAttitude                                            *
-- * Message ID:      6434                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides the calculated attitude relative to the tangential *
-- * plane at the platform's position using the selected Datum.               *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Roll is positive clockwise (right wing down) relative to the horizontal; *
-- * Pitch is positive nose up relative to the horizontal; Heading is wrt     *
-- * True North.                                                              *
-- *                                                                          *
-- * Data is only valid if the sensorsInUse flag has at least one bit set.    *
-- * The sensorsInUse flag bits should only be set for sensors used to        *
-- * generate the values in the message.                                      *
-- *                                                                          *
-- ****************************************************************************
--
DataAttitude ::= SEQUENCE {
    validityTime                    TimeStamp,
    rollAngle                       IEEE754Sp,              -- degrees (-180.0 <= value < +180.0)
    pitchAngle                      IEEE754Sp,              -- degrees (-90.0 <= value <= +90.0)
    headingAngleTrue                IEEE754Sp,              -- degrees wrt True North (0.0 <= value < +360.0)
    sensorsInUse                    SensorsInUse
}


-- ****************************************************************************
-- * Heading                                                                  *
-- *                                                                          *
-- * Message name:    DataHeading                                             *
-- * Message ID:      6346                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides the calculated heading.                            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Data is only valid if the sensorsInUse flag has at least one bit set.    *
-- * The sensorsInUse flag bits should only be set for sensors used to        *
-- * generate the values in the message.                                      *
-- *                                                                          *
-- * If no magnetic correction source is available then true and magnetic     *
-- * will be reported the same.                                               *
-- *                                                                          *
-- ****************************************************************************
--
DataHeading ::= SEQUENCE {
    validityTime                    TimeStamp,
    headingAngleTrue                IEEE754Sp,              -- degrees (0.0 <= value < +360.0)
    wordPadding                     Pad12bits,
    magneticCorrectionSource        MagneticVariationSource,
    headingAngleMagnetic            IEEE754Sp,              -- degrees (0.0 <= value < +360.0)
    sensorsInUse                    SensorsInUse
}


-- ****************************************************************************
-- * INU State Vector Input                                                   *
-- *                                                                          *
-- * Message name:    DataINUStateVectorInput                                 *
-- * Message ID:      6278                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       Up to 100Hz (the actual input rate may be limited by    *
-- *                  the bandwidth of the host interface.)                   *
-- * Input/Output:    Input                                                   *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This is a scaled version of the message DataLegacyINUStateVectorInput    *
-- * (see description and references with the legacy message itself). It      *
-- * provides the same parameters, but as scaled SI units.                    *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The X, Y, Z reference frame used is the aircraft body frame. X is out    *
-- * the nose, Y is out the right wing, and Z is out the belly of the         *
-- * aircraft.                                                                *
-- *                                                                          *
-- ****************************************************************************
--
DataINUStateVectorInput ::= SEQUENCE {
    inuModeWord                     INUMode,                -- INU Mode word
    velocityTimeTag                 IEEE754Sp,              -- Time interval since last 1PPS (in seconds)

    velocityX                       IEEE754Sp,              -- Platform X velocity (out the nose) in m/s
    velocityY                       IEEE754Sp,              -- Platform Y velocity (out the right wing) in m/s
    velocityZ                       IEEE754Sp,              -- Platform Z velocity (through the belly) in m/s

    azimuth                         IEEE754Sp,              -- Platform azimuth in degrees (positive is clockwise wrt North)
    roll                            IEEE754Sp,              -- Platform roll in degrees (positive is starboard wing down)
    pitch                           IEEE754Sp,              -- Platform pitch in degrees (positive is up)

    presentTrueHeading              IEEE754Sp,              -- Heading in degrees wrt True North
    presentMagneticHeading          IEEE754Sp,              -- Heading in degrees wrt Magnetic North

    accelerationX                   IEEE754Sp,              -- Platform X acceleration (out the nose) in m/s/s
    accelerationY                   IEEE754Sp,              -- Platform Y acceleration (out the right wing) in m/s/s
    accelerationZ                   IEEE754Sp,              -- Platform Z acceleration (through the belly) in m/s/s

    cNEXx                           IEEE754Dp,              -- CNEX X value
    cNEXy                           IEEE754Dp,              -- CNEX Y value
    cNEXz                           IEEE754Dp,              -- CNEX Z value

    longitude                       IEEE754Dp,              -- in degrees, positive is East of Greenwich Meridian

    inertialAltitude                IEEE754Sp,              -- in metres referenced to the geoid of the selected datum (default is WGS-84)
    greatCircleSteeringError        IEEE754Sp,              -- in degrees
    xAxisResidualTilt               IEEE754Sp,              -- in degrees
    yAxisResidualTilt               IEEE754Sp,              -- in degrees

    inuModeWord2                    INUMode2,               -- INU Mode word II

    rollRate                        IEEE754Sp,              -- in degrees per second, positive is starboard wing down
    pitchRate                       IEEE754Sp,              -- in degrees per second, positive is nose up
    yawRate                         IEEE754Sp               -- in degrees per second, positive is yaw to the right
}


-- ****************************************************************************
-- * LEGACY INU State Vector Input                                            *
-- *                                                                          *
-- * Message name:    DataLegacyINUStateVectorInput                           *
-- * Message ID:      6422                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       Up to 100Hz (the actual input rate may be limited by    *
-- *                  the bandwidth of the host interface.)                   *
-- * Input/Output:    Input                                                   *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * THIS IS A LEGACY MESSAGE.  The definition here is to achieve backwards   *
-- * compatibility.                                                           *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message must be provided to the GNSS sensor at a minimum rate of    *
-- * 4Hz to enable INU aiding of the GNSS sensor. Further aiding data is      *
-- * used at no greater rate than 100Hz. This message should be used in       *
-- * conjunction with the INU Correction Data Input message.                  *
-- *                                                                          *
-- * This message was originally defined in: Aeronautical Systems Division,   *
-- * Air Force Systems Command, 'Specification for USAF Standard Form, Fit    *
-- * and Function Medium Accuracy Inertial Navigation Unit', SNU84-1,         *
-- * Revision D, 21 Sep 92, Message Block ID IO1/IO5.                         *
-- * Note Words IO1/IO5-02 through IO1/IO5-13 are identical to IO6/IO8-02     *
-- * through IO6/IO8-13.                                                      *
-- * Reference: https://apps.dtic.mil/dtic/tr/fulltext/u2/a332939.pdf         *
-- *                                                                          *
-- * The X, Y, Z reference frame used is the aircraft body frame. X is out    *
-- * the nose, Y is out the right wing, and Z is out the belly of the         *
-- * aircraft.                                                                *
-- *                                                                          *
-- ****************************************************************************
--
DataLegacyINUStateVectorInput ::= SEQUENCE {
    -- IO1/IO5 - 01: INU Mode word
    inuModeWord                     INUMode,
    -- IO6/IO8 - 02: Platform velocity time tag.
    -- Time from last 1PPS.
    -- LSB is 64 microseconds.
    velocityTimeTag                 Unsigned16,
    -- IO6/IO8 - 3(MSP), IO6/IO8 - 4(LSP): Platform velocity in X direction
    -- X is out the nose.
    -- An integer multiple of 3.81470E-6 (LSB=2^-18) feet per second (fps)
    velocityX                       SNU84Int32,
    -- IO6/IO8 - 5(MSP), IO6/IO8 - 6(LSP): Platform velocity in Y direction.
    -- Y is out the right wing.
    -- An integer multiple of 3.81470E-6 (LSB=2^-18) feet per second (fps)
    velocityY                       SNU84Int32,
    -- IO6/IO8 - 7(MSP), IO6/IO8 - 8(LSP): Platform velocity in Z direction.
    -- Z is out the belly of the aircraft.
    -- An integer multiple of 3.81470E-6 (LSB=2^-18) feet per second (fps)
    velocityZ                       SNU84Int32,
    -- IO6/IO8 - 9: Platform azimuth.
    -- Positive is clockwise with respect to True/Magnetic North.
    -- An integer multiple of 3.05176E-05 (LSB=2^-15) semi-circles
    platformAzimuth                 SNU84Int16,
    -- IO6/IO8 - 10: Platform roll.
    -- Positive is roll to starboard (starboard wing down).
    -- An integer multiple of 3.05176E-05 (LSB=2^-15) semi-circles
    roll                            SNU84Int16,
    -- IO6/IO8 - 11: Platform pitch.
    -- Positive is nose up.
    -- An integer multiple of 3.05176E-05 (LSB=2^-15) semi-circles
    pitch                           SNU84Int16,
    -- IO6/IO8 - 12: Present True heading.
    -- Positive is clockwise with respect to True North,
    -- An integer multiple of 3.05176E-05 (LSB=2^-15) semi-circles
    presentTrueHeading              SNU84Int16,
    -- IO6/IO8 - 13: Present Magnetic heading.
    -- Positive is clockwise with respect to Magnetic North
    -- An integer multiple of 3.05176E-05 (LSB=2^-15) semi-circles
    presentMagneticHeading          SNU84Int16,
    -- IO1 - 14: Platform X Acceleration
    -- An integer multiple of 0.03125 (LSB=2^-5) feet per second per second
    accelerationX                   SNU84Int16,
    -- IO1 - 15: Platform Y Acceleration
    -- An integer multiple of 0.03125 (LSB=2^-5) feet per second per second
    accelerationY                   SNU84Int16,
    -- IO1 - 16: Platform Z Acceleration
    -- An integer multiple of 0.03125 (LSB=2^-5) feet per second per second
    accelerationZ                   SNU84Int16,
    -- IO1 - 17(MSP), IO1 - 18(LSP): CNEX x value.
    -- An integer multiple of 9.31323E-10 (LSB=2^-30)
    cNEXx                           SNU84Int32,
    -- IO1 - 19(MSP), IO1 - 20(LSP): CNEX y value.
    -- An integer multiple of 9.31323E-10 (LSB=2^-30)
    cNEXy                           SNU84Int32,
    -- IO1 - 21(MSP), IO1 - 22(LSP: CNEX z value.
    -- An integer multiple of 9.31323E-10 (LSB=2^-30)
    cNEXz                           SNU84Int32,
    -- IO1 - 23(MSP), IO1 - 24(LSP): Longitude
    -- Positive is East; zero is Greenwich Meridian.
    -- INU latitude of the host platform in WGS-84.
    -- An integer multiple of 4.65661E-10 (LSB=2^-31) semi-circles
    longitude                       SNU84Int32,
    -- IO1 - 25: Inertial Altitude
    -- Referenced to the geoid of the selected datum (default is WGS-84)
    -- An integer multiple of 4.0 (LSB=2^2) feet
    inertialAltitude                SNU84Int16,
    -- IO1 - 26: Great Circle steering error.
    -- An integer multiple of 3.05175E-05 (LSB=2^-15) semi-circles
    greatCircleSteeringError        SNU84Int16,
    -- IO1 - 27: Platform x-axis residual tilt.
    -- An integer multiple of 1 arc second
    xAxisResidualTilt               SNU84Int16,
    -- IO1 - 28: Platform y-axis residual tilt.
    -- An integer multiple of 1 arc second
    yAxisResidualTilt               SNU84Int16,
    -- IO1 - 29: INU Mode word II
    inuModeWord2                    INUMode,
    -- IO1 - 30: Platform roll rate.
    -- Positive is roll to the right (starboard wing down).
    -- An integer multiple of 1.22070E-04 (LSB=2^-13) semi-circles per second
    rollRate                        SNU84Int16,
    -- IO1 - 31: Platform pitch rate.
    -- Positive is nose up, units are degrees per second.
    -- An integer multiple of 1.22070E-04 (LSB=2^-13) semi-circles per second
    pitchRate                       SNU84Int16,
    -- IO1 - 32: Platform yaw rate.
    -- Positive is yaw to the right (starboard).
    -- An integer multiple of 1.22070E-04 (LSB=2^-13) semi-circles per second
    yawRate                         SNU84Int16
}

-- A signed 16 bit integer.
-- This is a legacy type that is for use in legacy messages
SNU84Int16 ::= SEQUENCE {
    -- Sign Bit, FALSE (0) is positive
    sign                           BOOLEAN,
    -- Value, 15 bits.
    value                          INTEGER (0..32767)
}

-- A signed 32 bit integer.
-- This is a legacy type that is for use in legacy messages
SNU84Int32 ::= SEQUENCE {
    sign                            BOOLEAN,                -- Sign Bit, FALSE (0) is positive
    value                           INTEGER (0..2147483646) -- Value, 31 bits.
}

-- INU Mode word
INUMode ::= SEQUENCE {
    inertialSensorReferenceFail     BOOLEAN,                -- inertial sensor / reference has failed
    anyNavigationDataFail           BOOLEAN,                -- Any navigation data has failed
    degradedNavigation              BOOLEAN,                -- Navigation is degraded
    navigationDataUnavailable       BOOLEAN,                -- Navigation data is unavailable
    digitalAttitudeDataFail         BOOLEAN,                -- Attitude data failure
    degradedNAVReady                BOOLEAN,                -- Degraded navigation data is available
    attitudeReady                   BOOLEAN,                -- Attitude data available
    controlVectorAcknowledge        BOOLEAN,                -- Acknowledge control vector
    altitudeLoopBit                 BOOLEAN,                -- TBD
    inuInInitiatedBit               BOOLEAN,                -- TBD
    mechanizationFlag               BOOLEAN,                -- TBD
    inManualMagneticVariation       BOOLEAN,                -- TBD
    digitalSelect                   BOOLEAN,                -- TBD
    inGridMode                      BOOLEAN,                -- In Grid mode
    cDUFail                         BOOLEAN,                -- CDU has failed
    logicZero                       BOOLEAN                 -- set to false
}


-- INU Mode word 2
INUMode2 ::= SEQUENCE {
    off                             BOOLEAN,                -- Off
    standby                         BOOLEAN,                -- Standby
    airAlign                        BOOLEAN,                -- Air Align
    storedHeadingAlign              BOOLEAN,                -- Stored Air Align
    gcAlign                         BOOLEAN,                -- GC Align
    enhancedGCAlignReserved         BOOLEAN,                -- Enhanced GC Align (Reserved)
    precisionGCAlignReserved        BOOLEAN,                -- Precision GC Align (Reserved)
    eiaReserved                     BOOLEAN,                -- EIA (Reserved)
    navigate                        BOOLEAN,                -- Navigate
    overfly                         BOOLEAN,                -- Overfly
    auxiliary                       BOOLEAN,                -- Auxiliary
    orientBoresight                 BOOLEAN,                -- Orient/Boresight
    attitude                        BOOLEAN,                -- Attitude
    test                            BOOLEAN,                -- Test
    calibrateReserved               BOOLEAN,                -- Calibrate (Reserved)
    spare                           BOOLEAN                 -- Spare
}


-- ****************************************************************************
-- * INU Correction Data Input                                                *
-- *                                                                          *
-- * Message name:    DataINUCorrectionDataInput                              *
-- * Message ID:      6343                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input                                                   *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message is sent to the GNSS Sensor when very large corrections have *
-- * been made to the INU and the new INU data following the reset is         *
-- * substantially different from the previously received data contained in   *
-- * the INU State Vector Message.                                            *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataINUCorrectionDataInput ::= SEQUENCE {
    validityTime                    TimeStamp,
    -- Time Of Transmission: Time from last 1 pulse-per-second
    timeOfTransmission              IEEE754Sp,              -- seconds
    -- Counter: This field contains the value of a counter which is incremented
    -- each time the message is recomputed (i.e. each time a new correction message
    -- is provided).
    counter                         Unsigned16,
    mode                            INUCorrectionMode,
    positionCorrectionValid         BOOLEAN,
    referenceHeadingValid           BOOLEAN,
    velocityCorrectionValid         BOOLEAN,
    headingCorrectionValid          BOOLEAN,
    xAxisCorrectionValid            BOOLEAN,
    yAxisCorrectionValid            BOOLEAN,
    wordPadding                     Pad10bits,
    positionCorrection              PositionLLA,
    referenceHeading                IEEE754Sp,              -- degrees (0.0 <= value < +360.0)
    velocityCorrection              VelocityXYZ,
    headingCorrection               IEEE754Sp,              -- degrees (-180.0 <= value < +180.0)
    xAxisCorrection                 IEEE754Sp,              -- degrees (-90.0 < value < 90.0)
    yAxisCorrection                 IEEE754Sp               -- degrees (-90.0 < value < 90.0)
}


-- ****************************************************************************
-- * LEGACY INU Correction Data Input                                         *
-- *                                                                          *
-- * Message name:    DataLegacyINUCorrectionDataInput                        *
-- * Message ID:      6362                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input                                                   *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * THIS IS A LEGACY MESSAGE.  The definition here is to achieve backwards   *
-- * compatibility.                                                           *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message is sent to the GNSS Sensor when very large corrections have *
-- * been made to the INU and the new INU data following the reset is         *
-- * substantially different from the previously received data contained in   *
-- * the INU State Vector Message.                                            *
-- *                                                                          *
-- ****************************************************************************
--
DataLegacyINUCorrectionDataInput ::= SEQUENCE {
    -- Time of transmission
    -- Time from last 1PPS.
    -- LSB is 2^6 microsecond
    timeOfTransmission              Unsigned16,
    -- Time of Validity
    -- Time from last 1PPS.
    -- LSB is 2^6 microsecond
    timeOfValidity                  Unsigned16,
    -- This field contains the value of a counter which is incremented
    -- each time the message is recomputed (i.e. each time a new correction
    -- message is provided).
    counter                         Unsigned16,
    modeWord                        INUCorrectionMode,      -- Mode word
    latitudeCorrection              SNU84Int32,             -- LSB is 2^-31 semi-circles
    longitudeCorrection             SNU84Int32,             -- LSB is 2^-31 semi-circles
    altitudeCorrection              SNU84Int16,             -- An integer multiple of 0.125 (LSB=2^-3) feet
    referenceHeading                SNU84Int16,             -- LSB is 2^15 semi-circles
    xVelocityCorrection             SNU84Int16,             -- An integer multiple of 0.25 (LSB=2^-2) feet per second (fps)
    yVelocityCorrection             SNU84Int16,             -- An integer multiple of 0.25 (LSB=2^-2) feet per second (fps)
    zVelocityCorrection             SNU84Int16,             -- An integer multiple of 0.25 (LSB=2^-2) feet per second (fps)
    headingCorrection               SNU84Int16,             -- LSB is 2^15 semi-circles
    xAxisCorrection                 SNU84Int16,             -- LSB is 2^-17 Radians
    yAxisCorrection                 SNU84Int16              -- LSB is 2^-17 Radians
}

-- Indication which corrections are valid
INUCorrectionMode ::= SEQUENCE {
    spare1                          BOOLEAN,                -- First bit is spare
    tiltCorrectionsValid            BOOLEAN,                -- Tilt correction valid.  TRUE = Valid
    headingCorrectionsValid         BOOLEAN,                -- Heading correction valid.  TRUE = Valid
    velocityCorrectionsValid        BOOLEAN,                -- Velocity correction valid.  TRUE = Valid
    positionCorrectionsValid        BOOLEAN,                -- Position correction valid.  TRUE = Valid
    spare                           Pad11bits               -- 11 bits are spare
}


-- ****************************************************************************
-- * Navigation Sensor Aiding Input                                           *
-- *                                                                          *
-- * Message name:    DataExtNavSensorInput                                   *
-- * Message ID:      6319                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       Up to 100Hz (the actual input rate may be limited by    *
-- *                  the bandwidth of the host interface.)                   *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the data from a variety of auxiliary navigation    *
-- * sensors.                                                                 *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Depending on the host platform's navigation suite all or a portion of    *
-- * the navigation sensor data within this will be populated. It is the      *
-- * responsibility of the Host platform's mission system to consolidate the  *
-- * sensor data into this message.                                           *
-- *                                                                          *
-- ****************************************************************************
--
DataExtNavSensorInput ::= SEQUENCE {
    validityTime                    TimeStamp,
    validityFlags                   NavSensorAidingMode,
    sensorsInUse                    SensorsInUse,
    positionLLA                     PositionLLA,            -- position (latitude, longitude and altitude (metres above ellipsoid))
    radAltitude                     IEEE754Sp,              -- radar altitude in metres (corrected to be height above selected geoid)
    baroAltitude                    IEEE754Sp,              -- barometric height in metres (with reference to selected geoid)
    trueSpeed                       IEEE754Sp,              -- metres/second
    velocityENU                     VelocityENU,
    heading                         AngularDir,             -- heading bearing and reference
    pitch                           IEEE754Sp,              -- degrees (-90.0 <= value <= +90.0), positive is nose up referenced to local frame
    roll                            IEEE754Sp,              -- degrees (-180.0 <= value < +180.0), positive is right wing down referenced to local frame
    velocityBodyXYZ                 VelocityXYZ             -- X: positive is toward the nose, Y: positive is toward the left wing, Z: positive is up
}


-- Padded to use 16 bits.
NavSensorAidingMode ::= SEQUENCE {
    tovValid                        BOOLEAN,                -- TRUE = Valid
    latLonValid                     BOOLEAN,                -- TRUE = Valid
    altValid                        BOOLEAN,                -- TRUE = Valid
    radAltitudeValid                BOOLEAN,                -- TRUE = Valid
    baroAltitudeValid               BOOLEAN,                -- TRUE = Valid
    trueSpeedValid                  BOOLEAN,                -- TRUE = Valid
    velocityENUValid                BOOLEAN,                -- TRUE = Valid
    headingValid                    BOOLEAN,                -- TRUE = Valid
    pitchRollValid                  BOOLEAN,                -- TRUE = Valid
    velocityXYZValid                BOOLEAN,                -- TRUE = Valid
    trueSpeedTypeIsGround           BOOLEAN,                -- TRUE = Ground, FALSE = Air
    headingTypeIsTrue               BOOLEAN,                -- TRUE = True North, FALSE = Magnetic North
    reservedBits                    Pad4bits
}


-- ****************************************************************************
-- * Mean Sea Level Pressure                                                  *
-- *                                                                          *
-- * Message name:    DataPressureMSL                                         *
-- * Message ID:      6338                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message specifies the current local MSL pressure reading to support *
-- * absolute height reporting above MSL from a local barometric sensor.      *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- ****************************************************************************
--
DataPressureMSL ::= SEQUENCE {
    validityTime                    TimeStamp,
    pressureMSL                     IEEE754Sp               -- Mean Sea Level (MSL) pressure in Pascals
}


-- ****************************************************************************
-- * Raw Received GNSS Nav Page Symbols                                       *
-- *                                                                          *
-- * Message name:    DataRawNavPageSymbols                                   *
-- * Message ID:      6388                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains raw navigation data page symbols from a specific   *
-- * GNSS service and frequency.                                              *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message includes all the received page symbols, including on-board  *
-- * data if applicable (service specific) and CRC data. The data is          *
-- * provided as a sequence of confidence levels for each bit (to allow       *
-- * off-line soft decision processing if required).                          *
-- *                                                                          *
-- * Each symbol is expressed as a confidence value range 0 to 15. 0          *
-- * represents symbols most likely to be a '0' and 15 represents symbols     *
-- * most likely to be a '1'.                                                 *
-- *                                                                          *
-- * The 4 bit symbols are packed into the bytes most significant part        *
-- * first, in the order they are received in the page/frame.                 *
-- *                                                                          *
-- * The validityTime is TOW for the start of the page and is reported in the *
-- * applicable constellation time reference.                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataRawNavPageSymbols ::= SEQUENCE {
    validityTime                    TimeStamp,
    gnssSignal                      SignalID,
    satID                           SatID,
    pageType                        Unsigned16,             -- Page type is service dependent
    wordPadding                     Pad6bits,
    rawNavDataPageSymbols           SEQUENCE (SIZE(0..512)) OF INTEGER (0..15)
}


-- ****************************************************************************
-- * Raw Received GNSS Nav Page Bits                                          *
-- *                                                                          *
-- * Message name:    DataRawNavPageBits                                      *
-- * Message ID:      6275                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains raw navigation data page bits from a specific GNSS *
-- * service and frequency.                                                   *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message includes all the received page bits, including on-board     *
-- * data if applicable (service specific) and CRC bits. The data is          *
-- * provided as a sequence of bits following decoding.                       *
-- *                                                                          *
-- * The raw data bits are packed into the MessageOctets most significant     *
-- * bit first down to least significant bit, in the order they are received  *
-- * in the page/frame. Any unused bits of the final MessageOctet are set to  *
-- * 0 and further padded with 0 bits, if necessary, to ensure an even        *
-- * number of MessageOctets are sent. The bitCount field indicates how many  *
-- * of the bits within the rawNavDataPageBits field are received data.       *
-- *                                                                          *
-- * The validityTime is TOW for the start of the page and is reported in the *
-- * applicable constellation time reference.                                 *
-- *                                                                          *
-- ****************************************************************************
--
DataRawNavPageBits ::= SEQUENCE {
    validityTime                    TimeStamp,
    gnssSignal                      SignalID,
    satID                           SatID,
    pageType                        Unsigned16,             -- Page type is service dependent
    wordPadding                     Pad6bits,
    bitCount                        INTEGER (0..512),       -- Number of valid bits in the rawNavDataPageBits field
    wordPadding1                    Pad9bits,
    rawNavDataPageBits              SEQUENCE (SIZE(0..64)) OF MessageOctet
}


-- ****************************************************************************
-- * Inter GNSS Time Broadcast                                                *
-- *                                                                          *
-- * Message name:    DataInterGNSSTimeBroadcast                              *
-- * Message ID:      6404                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message is a generic GNSS to GNSS System Time Conversion message    *
-- * that provides the broadcast parameters. For example Galileo broadcasts   *
-- * the offset between Galileo and GPS, whilst the modernised GPS            *
-- * (CNAV/CNAV2) broadcasts offsets to the Galileo and GLONASS.              *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The signal indicates the source GNSS bands.                              *
-- *                                                                          *
-- * The offsetConstellationID indicates the GNSS that the offset is          *
-- * relative to. The rate of change of drift is only currently broadcast     *
-- * from the GPS CNAV/CNAV2 services and will be set to zero for other       *
-- * systems. The sense of the offset parameters is as per the broadcast      *
-- * source.                                                                  *
-- *                                                                          *
-- ****************************************************************************
--
DataInterGNSSTimeBroadcast ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad10bits,
    interGNSSTimeOffsets            SEQUENCE (SIZE(0..63)) OF SEQUENCE {
        signal                          SignalID,               -- Source of broadcast
        offsetConstellationID           ConstellationID,        -- Constellation ID (see Notes)
        constantTerm                    IEEE754Sp,              -- Constant term of the polynomial describing the offset in seconds
        rateOfChangeOfOffset            IEEE754Sp,              -- First order term in seconds/second
        rateOfChangeOfDrift             IEEE754Sp,              -- Second order term in seconds/second/second
        referenceTimeForGGTOData        Unsigned16,             -- seconds
        weekNumberOfGGTOReference       Unsigned16              -- weeks
    }
}


-- ****************************************************************************
-- * Inter GNSS Time Estimate                                                 *
-- *                                                                          *
-- * Message name:    DataInterGNSSTimeEstimate                               *
-- * Message ID:      6411                                                    *
-- * Message status:  Optional(2)                                             *
-- * Frequency:       As required                                             *
-- * Input/Output:    Output                                                  *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message provides the polynomial parameters, as calculated by the    *
-- * receiver, required to estimate the time difference, and accuracy,        *
-- * between the offset Constellation and the reference Constellation.        *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * The message reports the required values for a sequence of constellation  *
-- * pairs.                                                                   *
-- *                                                                          *
-- * The offset is calculated using a first order polynomial to give the      *
-- * time interval between top-of-the-second marks for the                    *
-- * offsetConstellationID and the referenceConstellationID.                  *
-- *                                                                          *
-- * T_offset = T_reference + constantTerm + deltaT x rateOfChangeOfOffset    *
-- *                                                                          *
-- * The user should account separately for any bulk time differences         *
-- * between the GNSS reported times, such as leap seconds or time zone       *
-- * differences (e.g. for GLONASS time).                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataInterGNSSTimeEstimate ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad10bits,
    interGNSSTimeOffsets            SEQUENCE (SIZE(0..45)) OF SEQUENCE {
        referenceConstellationID        ConstellationID,
        offsetConstellationID           ConstellationID,
        constantTerm                    IEEE754Sp,              -- constant term of the polynomial describing the offset (seconds)
        rateOfChangeOfOffset            IEEE754Sp,              -- first order term (seconds/second)
        estimatedTimeOffsetAccuracy     IEEE754Sp,              -- seconds (1 sigma accuracy)
        estimatedTimeRateAccuracy       IEEE754Sp               -- seconds (1 sigma accuracy)
    }
}


-- ****************************************************************************
-- * Satellite/Signals Health                                                 *
-- *                                                                          *
-- * Message name:    DataSatSignalsHealth                                    *
-- * Message ID:      6309                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains a summary of the satellite/signal health.          *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * This message can be used to obtain information about satellite and       *
-- * signal health. This message can also be used to pass Health information  *
-- * to the receiver from an external source.                                 *
-- *                                                                          *
-- * The Navigational health of the satellite is given plus the health of     *
-- * each individual signal.                                                  *
-- *                                                                          *
-- ****************************************************************************
--
DataSatSignalsHealth ::= SEQUENCE {
    validityTime                    TimeStamp,
    wordPadding                     Pad8bits,
    satSignalsHealth                SatSignalsHealth        -- Signals Health
}

SatSignalsHealth ::= SEQUENCE (SIZE(0..255)) OF SEQUENCE {
    satID                           SatID,                  -- SatID within the Constellation (as indicated in signalID)
    satelliteHealth                 Unsigned16,             -- Satellite Navigational health (0 OK)
    wordPadding                     Pad12bits,
    signalsHealth                   SignalsHealth           -- Health of the given signals
}

SignalsHealth ::= SEQUENCE (SIZE(0..15)) OF SEQUENCE {
    signalID                        SignalID,
    wordPadding                     Pad13bits,
    satSignalHealth                 SatSignalHealth
}


-- Almanac Messages --
--
-- These messages provide the unscaled and scaled almanac.
-- The GNSSs provide different information so undertake on a constellation,
-- by constellation basis.
--
-- ****************************************************************************
-- * GPS Unscaled Almanac                                                     *
-- *                                                                          *
-- * Message name:    DataGPSUnscaledAlmanac                                  *
-- * Message ID:      6451                                                    *
-- * Message status:  Core                                                    *
-- * Frequency:       As required                                             *
-- * Input/Output:    Input/Output                                            *
-- *~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*
-- * Short Description:                                                       *
-- *                                                                          *
-- * This message contains the unscaled almanac parameters received from the  *
-- * tracked GPS satellites.                                                  *
-- *                                                                          *
-- * Notes:                                                                   *
-- *                                                                          *
-- * Note that the signal ID refers to where the message has come from.       *
-- * Units, scaling factors, and other semantic information (e.g. reference   *
-- * angles) for the various parameters can be found in:                      *
-- * Interface Specification NAVSTAR GPS.                                     *
-- *                                                                          *
-- ****************************************************************************
--
DataGPSUnscaledAlmanac ::= SEQUENCE {
    validityTime                    TimeStamp,
    numberOfMessages                Unsigned8,              -- Number of messages to report almanac
    messageNumber                   Unsigned8,              -- Number of message being reported (0 to N-1)
