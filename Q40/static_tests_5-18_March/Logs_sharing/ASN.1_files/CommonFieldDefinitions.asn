-- This type is used for the description fields.
DescriptionInfo ::= OCTET STRING (SIZE(16))


-- This type identifies dilution of precision values for several different parameters.
-- When there is insufficient information to calculate dilution of precision, values
-- should default to the maximum value of the variable type.
DilutionOfPrecision ::= SEQUENCE {
    horizontalDilutionOfPrecision   Unsigned8,              -- unitless (scale factor = 0.1)
    verticalDilutionOfPrecision     Unsigned8,              -- unitless (scale factor = 0.1)
    geometricDilutionOfPrecision    Unsigned8,              -- unitless (scale factor = 0.1)
    timeDilutionOfPrecision         Unsigned8,              -- unitless (scale factor = 0.1)
    positionDilutionOfPrecision     Unsigned8,              -- unitless (scale factor = 0.1)
    wordPadding                     Pad8bits                -- to pad out to three words
}


-- Specify the anticipated dynamics (see comments).
-- Padded to use 4 bits.
DynamicsMode ::= ENUMERATED {
    dynamicsAutoSelect,             -- allow the receiver to automatically adapt to the  platform dynamics and environment
    dynamicsFixed,                  -- receiver is installed in a fixed location and shall not move in operation
    dynamicsLow,                    -- receiver is hand-held and typically operating in a mounted/dismounted environment operating at velocities less than ~50 m/s (approx. 100 Knots) and at accelerations less than ~4g
    dynamicsMedium,                 -- receiver is mounted on a moving platform capable of travelling at sustained velocities up to ~600 m/s (~1,200 Knots) and maximum acceleration of ~10g
    dynamicsHigh,                   -- receiver is mounted on a very fast/agile moving platform (e.g. a fighter aircraft) capable of travelling at speeds of up to ~Mach 10 and capable of acceleration/deceleration up to ~50g
    dynamicsUltraHigh,              -- receivers mounted in hypersonic platforms (e.g. weapons, munitions) capable of exceeding HD speeds and with acceleration/deceleration, jerk etc. up to ~1000g
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- Specify the anticipated dynamics .
-- Padded to use 16 bits.
DynamicsSupport ::= SEQUENCE {
    dynamicsFixed                   BOOLEAN,                -- see DynamicsMode notes
    dynamicsLow                     BOOLEAN,                -- see DynamicsMode notes
    dynamicsMedium                  BOOLEAN,                -- see DynamicsMode notes
    dynamicsHigh                    BOOLEAN,                -- see DynamicsMode notes
    dynamicsUltraHigh               BOOLEAN,                -- see DynamicsMode notes
    reserved5                       BOOLEAN,                -- see DynamicsMode notes
    reserved6                       BOOLEAN,
    reserved7                       BOOLEAN,
    reserved8                       BOOLEAN,
    reserved9                       BOOLEAN,
    reserved10                      BOOLEAN,
    reserved11                      BOOLEAN,
    reserved12                      BOOLEAN,
    reserved13                      BOOLEAN,
    reserved14                      BOOLEAN,
    reserved15                      BOOLEAN
}


-- This type identifies the status of the position/time fix.
-- Padded to use 4 bits.
FixStatus ::= ENUMERATED {
    fixStatusNone,                  -- no fix
    fixStatusFixedRx,               -- receiver location is fixed.
    fixStatusTwoDimensional,        -- fix in 2 dimensions (position is fixed to the geoid or at a specified altitude)
    fixStatusThreeDimensional,      -- fix in 3 dimensions
    fixStatusDeadReckoning,         -- fix from/based on dead reckoning
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type reports or selects multiple Galileo signals (or indicates that the receiver should do so automatically).
-- Padded to use 24 bits.
GalMultiSignalID ::= SEQUENCE {
    galSigAutoChoose                BOOLEAN,
    galSigE1bc                      BOOLEAN,
    galSigE5a                       BOOLEAN,
    galSigE5b                       BOOLEAN,
    galSigE6bc                      BOOLEAN,
    galSigE1a                       BOOLEAN,
    galSigE6a                       BOOLEAN,
    reservedBits                    Pad17bits
}


-- As defined in Galileo-OS-SIS-ICD.
GalSignalHealthIndicator ::= ENUMERATED {
    galSigHealthOK,                 -- Signal OK
    galSigHealthOutOfService,       -- Signal out of service
    galSigHealthWillBeOutOfService, -- Signal will be out of service
    galSigHealthInTest              -- Signal Component currently in test
}


-- This type reports or selects a single Galileo signal (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
GalSignalID ::= ENUMERATED {
    galSigNone,
    galSigAutoChoose,
    galSigE1bc,
    galSigE5a,
    galSigE5b,
    galSigE6bc,
    galSigE1a,
    galSigE6a,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type reports or selects multiple GLONASS signals (or indicates that the receiver should do so automatically).
-- Padded to use 24 bits.
GLOMultiSignalID ::= SEQUENCE {
    gloSigAutoChoose                BOOLEAN,
    gloSigL1OF                      BOOLEAN,
    gloSigL1SFEncrypted             BOOLEAN,
    gloSigL2OF                      BOOLEAN,
    gloSigL2SFEncrypted             BOOLEAN,
    gloSigL3OC                      BOOLEAN,
    gloSigL1OC                      BOOLEAN,
    gloSigL1SCEncrypted             BOOLEAN,
    gloSigL2OC                      BOOLEAN,
    gloSigL2SCEncrypted             BOOLEAN,
    reservedBits                    Pad14bits
}


-- This type reports or selects a single GLONASS signal (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
GLOSignalID ::= ENUMERATED {
    gloSigNone,
    gloSigAutoChoose,
    gloSigL1OF,
    gloSigL1SFEncrypted,
    gloSigL2OF,
    gloSigL2SFEncrypted,
    gloSigL3OC,
    gloSigL1OC,
    gloSigL1SCEncrypted,
    gloSigL2OC,
    gloSigL2SCEncrypted,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type gives the GNSS time as a number of seconds into a week, and a
-- number of weeks into an epoch (e.g. year).
GNSSTime ::= SEQUENCE {
    wordPadding                     Pad8bits,
    timeOfWeek                      Unsigned24,             -- Number of seconds into current week
    weekNumber                      Unsigned16              -- Number of weeks into current epoch
}


-- This type reports or selects multiple GPS signals (or indicates that the receiver should do so automatically).
-- Padded to use 24 bits.
GPSMultiSignalID ::= SEQUENCE {
    gpsSigAutoChoose                BOOLEAN,
    gpsSigL1CA                      BOOLEAN,
    gpsSigL1C                       BOOLEAN,
    gpsSigL2CM                      BOOLEAN,
    gpsSigL2CL                      BOOLEAN,
    gpsSigL5                        BOOLEAN,
    gpsSigL1PY                      BOOLEAN,
    gpsSigL2PY                      BOOLEAN,
    gpsSigL1MCode                   BOOLEAN,
    gpsSigL2MCode                   BOOLEAN,
    reservedBits                    Pad14bits
}


-- This type reports or selects a single GPS signal (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
GPSSignalID ::= ENUMERATED {
    gpsSigNone,
    gpsSigAutoChoose,
    gpsSigL1CA,
    gpsSigL1C,
    gpsSigL2CM,
    gpsSigL2CL,
    gpsSigL5,
    gpsSigL1PY,
    gpsSigL2PY,
    gpsSigL1MCode,
    gpsSigL2MCode,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- HoldType determines how the parameter is held.
HoldType ::= ENUMERATED {
    holdTypeOff,                    -- the parameter is not held and is determined by the navigation solution calculation engine
    holdTypeCurrentValue,           -- the parameter is held at the current value (when the hold is applied)
    holdTypeProvidedValue           -- the parameter is set to, and held at, the value passed
}


-- This type identifies the Interference and Jamming status.
-- Padded to use 4 bits.
InterferenceAndJammingStatus ::= ENUMERATED {
    ijStatusNoInterferenceOrJammingDetected,
    ijStatusTolerableInterferenceOrJammingDetected,
    ijStatusSevereInterferenceOrJammingAlarm,
    reserved3,
    reserved4,
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type identifies Interference and Jamming types.
-- Padded to use 16 bits.
InterferenceAndJammingTypes ::= SEQUENCE {
    none                            BOOLEAN,
    pulse                           BOOLEAN,
    cw                              BOOLEAN,
    chirp                           BOOLEAN,
    partialBandNoise                BOOLEAN,
    fullBandNoise                   BOOLEAN,
    reservedBits                    Pad9bits,
    other                           BOOLEAN                 -- indicates jamming/interference of undefined type
}


-- This type is used to specify an input or an output capability.
IODirection ::= ENUMERATED {
    iodNotUsed,                     -- not used/off
    iodInput,                       -- input (to receiver)
    iodOutput,                      -- output (from receiver)
    iodBidirectional                -- bi-directional (if applicable)
}


-- This type reports or selects ionospheric correction methods (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
IonoCorrection ::= ENUMERATED {
    ionoCorrectionNone,             -- no correction applied
    ionoCorrectionAuto,             -- receiver to select correction method
    ionoCorrectionDualFrequency,    -- correction via linear combination of observations of differing frequency
    ionoCorrectionModel,            -- correction via mathematical model utilising navigation broadcast correction parameters
    ionoCorrectionIsFrozen,         -- previous correction value applied
    ionoCorrectionAided,            -- correction via external system e.g. none
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type identifies a lever arm value consisting of X, Y and Z components, each measured in
-- metres. The reference Lever Arm Coordinate System is shown in Figure 2-1 in [AD-1].
LeverArmXYZ ::= SEQUENCE {
    x                               IEEE754Sp,              -- metres
    y                               IEEE754Sp,              -- metres
    z                               IEEE754Sp               -- metres
}


-- This type is used to specify a line state high/low value.
LineState ::= ENUMERATED {
    lineStateLow,                   -- low
    lineStateHigh,                  -- high
    lineStateTri                    -- tri-state
}


-- This type identifies the logical tracker ID used internally and is used to request control handoff.
LogicalTrackerID ::= INTEGER (0..65535)


-- This type reports or selects magnetic variation sources (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
MagneticVariationSource ::= ENUMERATED {
    magVarSourceNone,               -- magnetic variation is not available
    magVarSourceAutoChoose,         -- receiver to select magnetic variation source
    magVarSourceLocal,              -- local magnetic variation
    magVarSourceModel,              -- modelled magnetic variation
    magVarSourceModelUnverified,    -- model used but model is expired or validity can't be confirmed
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type is used in messages to define an octet (8 bit byte).
MessageOctet ::= OCTET STRING (SIZE(1))


-- This type allows multiple multi-signal identifiers to be reported or selected.
MultiSignalID ::= SEQUENCE{
    wordPadding                     Pad12bits,
    signalIDs                       SEQUENCE (SIZE(0..15)) OF SignalID
}


-- This type identifies the navigation solution mode employed.
-- Padded to use 4 bits.
NavSolutionMode ::= ENUMERATED {
    navSolModeAutoChoose,                                   -- receiver may choose (not used in reporting nav solution mode in use)
    navSolModeGNSSUnfiltered,                               -- GNSS unfiltered navigation solution (e.g. least squares approach)
    navSolModeGNSSFiltered,                                 -- GNSS navigation solution, determined using navigation filtering approach (e.g. Kalman)
    navSolModeMultiSensorIntegrationUncoupled,              -- GNSS navigation solution periodically resets inertial navigation solution
    navSolModeMultiSensorIntegrationLooselyCoupled,         -- GNSS navigation solution is used in a navigation filter to correct inertial solution
    navSolModeMultiSensorIntegrationTightlyCoupled,         -- GNSS measurements (e.g. pseudorange) are used in a navigation filter to correct inertial solution
    navSolModeMultiSensorIntegrationUltraTightlyCoupled,    -- GNSS correlator measurements are used in a navigation filter to correct inertial solution which aids tracking
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type specifies the reference for an angular bearing.
NorthRef ::= ENUMERATED {
    northRefInvalid,                -- referenced to unknown or invalid reading
    northRefTrue,                   -- referenced to True North
    northRefMagnetic,               -- referenced to Magnetic North
    northRefGrid                    -- referenced to Grid North
}


-- This type is used to specify which persistent information is to be saved or reset
-- when either CmndSaveConfigData or CmndResetConfigData is executed.
-- Notes:
-- When ephemeral data is selected, that is the missionData and navData,
-- the receiver will save the data periodically according to the receiver implementation.
-- Other data will be saved only when the command is issued.
-- Padded to use 32 bits.
NVRAMSection ::=  SEQUENCE {
    entireNVRAM                     BOOLEAN,                -- if this bit is set then all the following bits are ignored
    missionData                     BOOLEAN,                -- includes position and time data
    navData                         BOOLEAN,                -- includes all the current almanac, ephemeris, iono and clock data
    waypointsAndRoutes              BOOLEAN,                -- includes all waypoints and routes data
    configurationSettings           BOOLEAN,                -- includes all configuration data as returned by CmndReportRxConfig, EXCLUDING CmndSetSignals data
    connectedMessages               BOOLEAN,                -- includes the currently connected messages and their ports and rates
    satSignalSelection              BOOLEAN,                -- includes the currently selected satellite signals
    reservedBits                    Pad25bits               -- reserved for future use
}


-- This type uniquely identifies each logical communications port in the system.
-- Logical ports are numbered from 1.
--
-- - portCurrent(0),
-- - port1(1),
-- - port2(2),
-- - port3(3),
-- - port4(4),
-- - portAll(255)
PortID ::= INTEGER {
    portCurrent(0),
    port1(1),
    port2(2),
    port3(3),
    port4(4),
    portAll(255)
} (0..255)


-- This type specifies the 3-D position in the selected position format and using the specified datum and altitude reference.
Position ::= SEQUENCE {
    datumID                         DatumID,
    wordPadding                     Pad14bits,
    altitudeRef                     AltitudeRef,
    wordPadding1                    Pad13bits,
-- Choices 1 to N are sent as 0 to N-1 down the wire and equate to the PositionFormatID.
    position CHOICE {
        posLatLon SEQUENCE {
            positionLLA                     PositionLLA
        },
        posMGRSold SEQUENCE {
            gzd                             OCTET STRING (SIZE(2)),     -- Two character grid zone designator
            sqID                            OCTET STRING (SIZE(2)),     -- Two character 100,000m square identifier
            positionENA                     PositionENA                 -- Easting, northing and altitude
        },
        posMGRSnew SEQUENCE {
            gzd                             OCTET STRING (SIZE(2)),     -- Two character grid zone designator
            sqID                            OCTET STRING (SIZE(2)),     -- Two character 100,000m square identifier
            positionENA                     PositionENA                 -- Easting, northing and altitude
        },
        posUTM SEQUENCE {
            wordPadding                     Pad10bits,
            zoneNumber                      INTEGER(0..60),             -- Zone number
            wordPadding1                    Pad8bits,
            bandLetter                      MessageOctet,               -- Latitude band letter
            positionENA                     PositionENA
        },
        posUPS SEQUENCE {
            wordPadding                     Pad10bits,
            zoneNumber                      INTEGER(0..60),             -- Zone number
            positionENA                     PositionENA
        },
        posBNG SEQUENCE {
            gzd                             OCTET STRING (SIZE(2)),     -- Two character grid zone designator
            positionENA                     PositionENA
        },
        posITMG SEQUENCE {
            wordPadding                     Pad8bits,
            gridLetter                      MessageOctet,               -- One character grid letter
            positionENA                     PositionENA
        },
        posUSNG SEQUENCE {
            gzd                             OCTET STRING (SIZE(2)),     -- Two character grid zone designator
            sqID                            OCTET STRING (SIZE(2)),     -- Two character 100,000m square identifier
            positionENA                     PositionENA
        }
    }
}


-- This type identifies a position, consisting of an Easting, a Northing and an altitude.
-- Eastings and Northings are measured in metres referenced to the selected grid and datum.
-- Altitude is measured in metres.
-- When used in Position, the altitude is referenced to ellipsoid, geoid or origin
-- (centre of the Earth) as determined by CmndSetPositionFormat, with default being height
-- above ellipsoid.
PositionENA ::= SEQUENCE {
    easting                         IEEE754Dp,      -- metres
    northing                        IEEE754Dp,      -- metres
    altitude                        IEEE754Dp       -- metres
}


-- This type identifies the position Figure of Merit accuracy range.
-- This is a 3-D position FOM when the receiver is reporting 3-D position.
PositionFigureOfMerit ::= ENUMERATED {
    posFOM0,                        --  undefined
    posFOM1,                        --          accuracy <= 0.001m
    posFOM2,                        -- 0.001m < accuracy <= 0.01m
    posFOM3,                        -- 0.01m  < accuracy <= 0.1m
    posFOM4,                        -- 0.1m   < accuracy <= 1m
    posFOM5,                        -- 1m     < accuracy <= 2.5m
    posFOM6,                        -- 2.5m   < accuracy <= 10m
    posFOM7,                        -- 10m    < accuracy <= 25m
    posFOM8,                        -- 25m    < accuracy <= 100m
    posFOM9,                        -- 100m   < accuracy <= 250m
    posFOM10,                       -- 250m   < accuracy <= 1000m
    posFOM11,                       -- 1000m  < accuracy <= 2500m
    posFOM12,                       -- 2500m  < accuracy <= 10000m
    posFOM13                        -- 10000m < accuracy
}


-- This type specifies the format and grid to be used when reporting position.
-- The default (0) is for position to be given in lat/lon IEEE754 degrees using the WGS-84 datum.
-- Each format has a default datum, as given in the comments in [] brackets.
PositionFormatID ::= INTEGER {
    pfLatLon(0),                    -- Latitude and longitude in decimal degrees [WGS-84 - wge(267)]
    pfMGRSold(1),                   -- Military Grid Reference System - old [WGS-84 - wge(267)]
    pfMGRSnew(2),                   -- Military Grid Reference System - new [WGS-84 - wge(267)]
    pfUTM(3),                       -- Universal Transverse Mercator [WGS-84 - wge(267)]
    pfUPS(4),                       -- Universal Polar Stereographic [WGS-84 - wge(267)]
    pfBNG(5),                       -- British National Grid [OSGB36 - ogb7(181)]
    pfITMG(6),                      -- Irish Transverse Mercator Grid [IRELAND 1965 - irl7(118)]
    pfUSNG(7)                       -- United States National Grid [NAD83 - narC(153)]
} (0..65535)


-- This type identifies a position, consisting of a latitude, a longitude and an altitude.
-- Latitude and longitude are measured in degrees, in the datum selected (default is WGS-84).
-- Altitude is measured in metres.
-- When used in Position, the altitude is referenced to ellipsoid, geoid or origin
-- (centre of the Earth) as determined by CmndSetPositionFormat, with default being height
-- above ellipsoid.
-- When used in DataCoreNavSolution, the altitude is height above ellipsoid.
PositionLLA ::= SEQUENCE {
    latitude                        IEEE754Dp,              -- degrees (-90.0 <= value <= +90.0)
    longitude                       IEEE754Dp,              -- degrees (-180.0 <= value < +180.0)
    altitude                        IEEE754Dp               -- metres
}


-- This type identifies an ECEF style position, consisting of a X distance, a Y distance and a Z distance.
-- All distances are measured in metres, in the datum selected (default is WGS-84).
PositionXYZ ::= SEQUENCE {
    x                               IEEE754Dp,              -- metres
    y                               IEEE754Dp,              -- metres
    z                               IEEE754Dp               -- metres
}


-- This type identifies the Quality Flag (QFlag).
-- Flag is set to TRUE when ALL the following are true:
--  * Estimated Position Error <100m,
--  * Estimated Time Error < 100us,
--  * there are sufficient satellites in solution for selected fix mode,
--  * PDOP < 5
--  * no unmitigable spoofing, cyber attack or interference has been detected,
--  * only healthy satellites have been used,
--  * the receiver considers the solution to be trustworthy (derived from a sufficient number of trusted sources).
-- If the flag is not set (i.e. set to FALSE) then the metadata should be used to understand the risks.
QFlag ::= BOOLEAN


-- This type reports or selects a mode of RAIM.
-- Padded to use 4 bits.
RAIMMode ::= ENUMERATED {
    raimModeNone,                           -- no RAIM performed
    raimModeAutoChooseRAIMMode,             -- auto only valid when selecting RAIM mode (input to Rx)
    raimModeFaultDetection,                 -- FD  - Detects whether faulty observations are present
    raimModeFaultDetectionAndExclusion,     -- FDE - Detects whether faulty observations are present, if a fault is detected a subset of non-faulty observations is selected for use in the navigation solution
    raimModeFaultDetectionAndIsolation,     -- FDI - Detects whether faulty observations are present, if a fault is detected the faulty observation is identified and excluded from the navigation solution
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type reports or selects a type of RAIM.
-- Padded to use 4 bits.
RAIMType ::= ENUMERATED {
    raimTypeAutoChoose,
    raimTypeGeneralPurpose,
    raimTypeDO229,
    reserved3,
    reserved4,
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type is used as a place holder for future constellations.
ReservedMultiSignalID ::= Pad24bits


-- This type defines a RouteID.
-- ID 0 is special and cannot contain data and is used to signify all or no routes depending on context.
RouteID ::= SEQUENCE {
    wordPadding                         Pad8bits,
    routeID                             INTEGER (0..255)
}


-- This type reports or selects satellite clock correction methods (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
SatClockCorrection ::= ENUMERATED {
    satClockCorrectionNone,
    satClockCorrectionAuto,
    satClockCorrectionBroadcast,
    satClockCorrectionAided,
    reserved4,
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type is used to report or select a satellite within a given constellation.
-- The number will correspond to the Space Vehicle ID (SVID) or Pseudorandom Number (PRN).
SatID ::= SEQUENCE {
    wordPadding                     Pad8bits,
    satID                           INTEGER (0..255)
}


-- This type indicates the reported satellite service health.
SatSignalHealth ::= ENUMERATED {
    sshSatOk,                       -- satellite OK
    sshSatOutOfService,             -- satellite out of service
    sshSatWillBeOutOfService,       -- satellite planned to be out of service
    sshSatCurrentlyInTest,          -- satellite under test
    sshHealthUnknown                -- satellite service health unknown
}


-- This type identifies the states of the receiver trackers.
-- Padded to use 4 bits.
SatTrackingState ::= ENUMERATED {
    trackingState0,                 -- Not in acquisition or tracking
    trackingState1,                 -- Normal acquisition,
    trackingState2,                 -- Direct acquisition,
    trackingState3,                 -- Code lock,
    trackingState4,                 -- Non-coherent carrier lock,
    trackingState5,                 -- Carrier track data demodulation
    trackingState6,                 -- Sequential track
    trackingState7,                 -- Signal reacquisition
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type reports or selects a multiple SBAS (or other augmentation service) signals (or indicates that the receiver should do so automatically).
-- Padded to use 24 bits.
SBASMultiSignalID ::= SEQUENCE {
    sbasSigAutoChoose               BOOLEAN,
    sbasSigL1WAAS                   BOOLEAN,
    sbasSigL5WAAS                   BOOLEAN,
    sbasSigL1EGNOS                  BOOLEAN,
    sbasSigSDCM                     BOOLEAN,
    sbasSigSNAS                     BOOLEAN,
    sbasSigGAGAN                    BOOLEAN,
    sbasSigMSAS                     BOOLEAN,
    reservedBits                    Pad16bits
}


-- This type reports or selects a single SBAS (or other augmentation service) signal (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
SBASSignalID ::= ENUMERATED {
    sbasSigNone,
    sbasSigAutoChoose,
    sbasSigL1WAAS,
    sbasSigL5WAAS,
    sbasSigL1EGNOS,
    sbasSigSDCM,
    sbasSigSNAS,
    sbasSigGAGAN,
    sbasSigMSAS,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type identifies the sensors in use.
-- Padded to use 32 bits.
SensorsInUse ::= SEQUENCE {
    gnssSingleAntenna               BOOLEAN,
    gnssMultiAntenna                BOOLEAN,
    imu                             BOOLEAN,                -- Inertial Measurement Unit
    magnetometer                    BOOLEAN,
    baro                            BOOLEAN,
    vehicleWheelSensorOdometer      BOOLEAN,
    accelerometer                   BOOLEAN,
    singleAxisGyro                  BOOLEAN,
    stableClock                     BOOLEAN,
    ins                             BOOLEAN,                -- Inertial Navigation System
    radAlt                          BOOLEAN,
    trn                             BOOLEAN,                -- Terrain Reference Navigation
    extNavData                      BOOLEAN,                -- ephemeris, ionospheric corrections, clock etc. are from an external aiding source
    velocityAiding                  BOOLEAN,
    reservedBits                    Pad18bits
}


-- This type gives all the information necessary to completely configure a
-- serial communications port on the receiver.
SerialPortConfiguration ::= SEQUENCE {
    serialPortID                    PortID,
    wordPadding                     Pad6bits,
    direction                       ENUMERATED {
        directionBoth,                  -- both directions
        directionRxOut,                 -- transmit (from receiver's perspective)
        directionRxIn                   -- receive (from receiver's perspective)
    },
    wordPadding1                    Pad5bits,
-- This type sets the parity mechanism used - usually 0 (no parity bit).
    parity                          ENUMERATED {
        parityNone,                     -- no parity
        parityOdd,                      -- sets odd parity
        parityEven,                     -- sets even parity
        parityMark,                     -- sets the parity bit to mark
        paritySpace                     -- sets the parity bit to space
    },
    wordPadding2                    Pad8bits,
    baudRate                        Unsigned32              -- bits per second, e.g. 4800, 9600 etc
}


-- This type allows a multi-signal identifier to be reported or selected for any constellation.
SignalID ::= SEQUENCE {
-- Used to pad the SignalID out to total of 32 bits (two words).
-- E.g. GPSMultiSignalID (24 bits), ASN.1 choice (4 bits) + padding (4 bits).
    wordPadding                     Pad4bits,
-- Choices 1 to 16 sent as 0 to 15 down the wire.
-- Padded to use 4 bits.
    multiSignalID                   CHOICE {
-- reserved0 & 1 used to align indexes with ConstellationID to avoid potential confusion.
        reserved0                       ReservedMultiSignalID,
-- reserved0 & 1 used to align indexes with ConstellationID to avoid potential confusion.
        reserved1                       ReservedMultiSignalID,
        gps                             GPSMultiSignalID,
        gal                             GalMultiSignalID,
        glo                             GLOMultiSignalID,
        bds                             BDSMultiSignalID,
        reserved6                       ReservedMultiSignalID,
        reserved7                       ReservedMultiSignalID,
        reserved8                       ReservedMultiSignalID,
        reserved9                       ReservedMultiSignalID,
        reserved10                      ReservedMultiSignalID,
        reserved11                      ReservedMultiSignalID,
        reserved12                      ReservedMultiSignalID,
        reserved13                      ReservedMultiSignalID,
        reserved14                      ReservedMultiSignalID,
        sbas                            SBASMultiSignalID
    }
}


-- This type defines a spoofing/meaconing status.
SpoofingMeaconingStatus ::= ENUMERATED {
    smStatusNoSpoofingOrMeaconingDetected,
    smStatusPotentialMeaconingDetectedAndMitigated,
    smStatusPotentialSpoofingDetectedAndMitigated,
    smStatusSpoofingOrMeaconingAlarm
}


-- This type identifies spoofing and meaconing types.
-- Padded to use 16 bits.
SpoofingAndMeaconingTypes ::= SEQUENCE {
    none                            BOOLEAN,
    spoofing                        BOOLEAN,
    meaconing                       BOOLEAN,
    reservedBits                    Pad12bits,
    other                           BOOLEAN                 -- indicates spoofing/meaconing of undefined type
}


-- This type identifies the time Figure of Merit accuracy (estimated time error) range.
TimeFigureOfMerit ::= ENUMERATED {
    timeFOM0,                       --  undefined
    timeFOM1,                       --         accuracy <= 1ns
    timeFOM2,                       -- 1ns   < accuracy <= 10ns
    timeFOM3,                       -- 10ns  < accuracy <= 100ns
    timeFOM4,                       -- 100ns < accuracy <= 1us
    timeFOM5,                       -- 1us   < accuracy <= 10us
    timeFOM6,                       -- 10us  < accuracy <= 100us
    timeFOM7,                       -- 100us < accuracy <= 1ms
    timeFOM8,                       -- 1ms   < accuracy <= 10ms
    timeFOM9,                       -- 10ms  < accuracy 
    timeFOM10,                      -- reserved
    timeFOM11,                      -- reserved
    timeFOM12,                      -- reserved
    timeFOM13,                      -- reserved
    timeFOM14,                      -- reserved
    timeFOM15                       -- reserved
}


-- This type defines the time reference in use or requested.
-- Padded to use 4 bits.
TimeReference ::= ENUMERATED {
    timeRefUTC,                     -- UTC
    timeRefGPS,                     -- GPS system time reference
    timeRefGal,                     -- Galileo system time reference
    timeRefGLO,                     -- GLONASS system time reference
    timeRefBDS,                     -- BeiDou system time reference
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    timeRefRx,                      -- receiver local time reference
    timeRefElapsed                  -- elapsed time, starting point defined by context
}


-- This type contains a time stamp.
-- Each data message will include a time stamp field that will occupy the first
-- few octets of the message, this field shall contain the time of validity of
-- the message data from the receiver (as determined by the receiver).
-- When the time is unknown, for example immediately following receiver start-up,
-- the time stamp reference will indicate the elapsed time since start-up until
-- the time from the GNSS constellation selected as the reference has been
-- determined, the reference system shall default to GPS.
TimeStamp ::= SEQUENCE {
    wordPadding                     Pad12bits,
    timeReference                   TimeReference,
    towSeconds                      IEEE754Dp               -- Time Of Week (TOW) in seconds
}


-- This type reports or selects tropospheric correction methods (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
TropoCorrection ::= ENUMERATED {
    tropoCorrectionNone,            -- no correction applied
    tropoCorrectionAuto,            -- receiver to select correction method
    tropoCorrectionModel,           -- correction via mathematical model utilising a priori values
    tropoCorrectionIsFrozen,        -- previous correction value applied
    tropoCorrectionAided,           -- correction via external system e.g. SBAS
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type is used for upload operations.
UploadActions ::= ENUMERATED {
    uploadData,                     -- upload the data block to the receiver
    uploadVerify,                   -- verify that the completed image upload has been received
    uploadApply,                    -- apply the upload
    uploadAbort                     -- abort the upload process (discard any uploaded data)
}


-- This type identifies a velocity consisting of East, North (True) and Up components, each measured in
-- metres per second (Note: Invalid at the poles).
VelocityENU ::= SEQUENCE {
    east                            IEEE754Sp,              -- metres/second
    north                           IEEE754Sp,              -- metres/second
    up                              IEEE754Sp               -- metres/second
}


-- This type identifies the velocity Figure of Merit accuracy range.
VelocityFigureOfMerit ::= ENUMERATED {
    velFOM0,                        --  undefined
    velFOM1,                        --            accuracy <= 0.001m/s
    velFOM2,                        -- 0.001m/s < accuracy <= 0.005m/s
    velFOM3,                        -- 0.005m/s < accuracy <= 0.01m/s
    velFOM4,                        -- 0.01m/s  < accuracy <= 0.05m/s
    velFOM5,                        -- 0.05m/s  < accuracy <= 0.1m/s
    velFOM6,                        -- 0.1m/s   < accuracy <= 0.5m/s
    velFOM7,                        -- 0.5m/s   < accuracy <= 1m/s
    velFOM8,                        -- 1m/s     < accuracy <= 5m/s
    velFOM9,                        -- 5m/s     < accuracy <= 10m/s
    velFOM10,                       -- 10m/s    < accuracy <= 50m/s
    velFOM11,                       -- 50m/s    < accuracy <= 100m/s
    velFOM12,                       -- 100m/s   < accuracy <= 500m/s
    velFOM13                        -- 500m/s   < accuracy
}


-- This type identifies an ECEF type velocity consisting of X, Y and Z components, each measured in
-- metres per second.
VelocityXYZ ::= SEQUENCE {
    x                               IEEE754Sp,          -- metres/second
    y                               IEEE754Sp,          -- metres/second
    z                               IEEE754Sp           -- metres/second
}


-- This type defines a WaypointID.
-- ID 0 is special and cannot contain data and is used to signify all or no waypoints depending on context.
WaypointID ::= INTEGER (0..65535)


-- This type defines a Waypoint Index (the index into the array of WaypointIDs in a Route).
-- The first element in the index is 1, but 0 is included to signify no waypoint index.
WaypointIndex ::= SEQUENCE {
    wordPadding                     Pad6bits,
    waypointIndex                   INTEGER (0..1023)
}


END