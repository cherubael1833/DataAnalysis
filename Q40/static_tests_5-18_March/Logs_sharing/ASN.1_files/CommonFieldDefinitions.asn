    ainA(10),       -- AIN EL ABD 1970, Bahrain
    ainB(11),       -- AIN EL ABD 1970, Saudi Arabia
    ama(12),        -- AMERICAN SAMOA 1962, Samoa Islands
    ame7(13),       -- RD AMERSFOORT, Netherlands
    ano(14),        -- ANNA 1 ASTRO 1965, Cocos Islands
    arfM(15),       -- ARC 1950, Southern Africa
    arfA(16),       -- ARC 1950, Botswana
    arfH(17),       -- ARC 1950, Burundi
    arfB(18),       -- ARC 1950, Lesotho
    arfC(19),       -- ARC 1950, Malawi
