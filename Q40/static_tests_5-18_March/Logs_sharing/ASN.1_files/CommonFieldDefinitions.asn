CommonFieldDefinitions DEFINITIONS
AUTOMATIC TAGS ::=

BEGIN

EXPORTS ALL ;

IMPORTS
    Pad1bits, Pad2bits, Pad3bits, Pad4bits, Pad5bits, Pad6bits, Pad7bits, Pad8bits,
    Pad9bits, Pad10bits, Pad11bits, Pad12bits, Pad13bits, Pad14bits, Pad15bits,
    Pad16bits, Pad17bits, Pad18bits, Pad19bits, Pad24bits, Pad25bits,
    Unsigned8, Unsigned12, Unsigned16, Unsigned24, Unsigned32, IEEE754Sp, IEEE754Dp
    FROM FundamentalDataTypes
;


-- ****************************************************************************
-- * HostMessageVersion is a constant of type DescriptionInfo which           *
-- * represents the version of the GNSS Sensor Host Messages. The string      *
-- * should be in three elements, xx.zz.zz, where xx represents the major,    *
-- * yy the minor and zz the release version of the Host Messages that the    *
-- * receiver conforms to.                                                    *
-- *                                                                          *
-- * Each element is two digits, with '0' prepended if necessary, separated   *
-- * by '.', and encoded in ASCII. The string is right padded with the space  *
-- * character ('20'H) to fill the DescriptionInfo field.                     *
-- *                                                                          *
-- * E.g. the version comprising Major version = 1, Minor version = 2,        *
-- * Release version = 3, is formed into a string "01.02.03        ",         *
-- * including the leading '0' and trailing spaces, and is encoded as         *
-- * '30312E30322E30332020202020202020'H.                                     *
-- *                                                                          *
-- * The MessageVersion is returned in message StatusRxSimpleVersionInfo      *
-- * allowing a host to determine the Message Version that the receiver       *
-- * conforms to.                                                             *
-- *                                                                          *
-- ****************************************************************************
HostMessageVersion ::=              DescriptionInfo ('30302E31392E30302020202020202020'H)  -- "00.19.00        "


-- This type determines the AJAS mode.
AJASMode ::= ENUMERATED {
    ajasModeAutomatic,
    ajasModeDetection,
    ajasModeDetectionAndMitigation,
    ajasModeOff
}


-- This type specifies the reference for height/altitude measurements, all wrt selected datum.
AltitudeRef ::= ENUMERATED {
    altRefInvalid,                  -- height not valid
    altRefEllipsoid,                -- height above ellipsoid
    altRefGeoid,                    -- height above geoid
    altRefOrigin                    -- height above origin (Earth centre of mass)
}


-- This type specifies an angular bearing and the reference.
-- All bearings are in degrees, 0 <= value < 360.0, in a clockwise rotation,
-- where 0 degrees is the given reference.
AngularDir ::= SEQUENCE {
    angle                           IEEE754Sp,              -- degrees wrt to the given northReference (0 <= value < 360)
    wordPadding                     Pad14bits,
    northRef                        NorthRef                -- True, Magnetic or Grid
}


-- This type reports or selects multiple BeiDou signals (or indicates that the receiver should do so automatically).
-- Padded to use 24 bits.
BDSMultiSignalID ::= SEQUENCE {
    bdsSigAutoChoose                BOOLEAN,
    bdsSigL1OS                      BOOLEAN,
    bdsSigL1Encrypted               BOOLEAN,
    bdsSigL2OS                      BOOLEAN,
    bdsSigL2Encrypted               BOOLEAN,
    reservedBits                    Pad19bits
}


-- This type reports or selects a single BeiDou signal (or indicates that the receiver should do so automatically).
-- Padded to use 4 bits.
BDSSignalID ::= ENUMERATED {
    bdsSigNone,
    bdsSigAutoChoose,
    bdsSigL1OS,
    bdsSigL1Encrypted,
    bdsSigL2OS,
    bdsSigL2Encrypted,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type allows a GNSS/SBAS constellation to be reported or selected
-- (or indicates that the receiver should do so automatically).
ConstellationID ::= SEQUENCE {
    wordPadding                     Pad12bits,
-- Padded to use 4 bits.
    constellationID                 ENUMERATED {
        constellationNone,              -- No GNSS/SBAS is/has been identified
        constellationAutoChoose,        -- Auto choose constellation(s)
        constellationGPS,               -- GPS
        constellationGal,               -- Galileo
        constellationGLO,               -- GLONASS
        constellationBDS,               -- BeiDou
        reserved6,
        reserved7,
        reserved8,
        reserved9,
        reserved10,
        reserved11,
        reserved12,
        reserved13,
        reserved14,
        constellationSBAS               -- SBAS
    }
}


-- This type reports or selects a correction service.
-- Padded to use 4 bits.
CorrectionService ::= ENUMERATED {
    correctionNone,                 -- no correction in use
    correctionDGPS,                 -- differential GPS in use
    correctionSBAS,                 -- SBAS in use
    correctionRTK,                  -- RTK in use
    correctionPPP,                  -- PPP in use
    reserved5,
    reserved6,
    reserved7,
    reserved8,
    reserved9,
    reserved10,
    reserved11,
    reserved12,
    reserved13,
    reserved14,
    reserved15
}


-- This type stores correction services supported.
-- Padded to use 16 bits.
CorrectionServiceSupport ::= SEQUENCE {
    correctionDGPS                  BOOLEAN,                -- differential GPS in use
    correctionSBAS                  BOOLEAN,                -- SBAS in use
    correctionRTK                   BOOLEAN,                -- RTK in use
    correctionPPP                   BOOLEAN,                -- PPP in use
    reserved4                       BOOLEAN,
    reserved5                       BOOLEAN,
    reserved6                       BOOLEAN,
    reserved7                       BOOLEAN,
    reserved8                       BOOLEAN,
    reserved9                       BOOLEAN,
    reserved10                      BOOLEAN,
    reserved11                      BOOLEAN,
    reserved12                      BOOLEAN,
    reserved13                      BOOLEAN,
    reserved14                      BOOLEAN,
    reserved15                      BOOLEAN
}


-- This type defines a cyber attack status.
CyberAttackStatus ::= ENUMERATED {
    cyberStatusNoCyberAttackDetected,
    cyberStatusAttackDetectedAndMitigated,
    cyberStatusAttackAlarm
}


-- This type identifies cyber attack types.
-- Padded to use 16 bits.
CyberAttackTypes ::= SEQUENCE {
    none                            BOOLEAN,
    invalidNavData                  BOOLEAN,
    reservedBits                    Pad13bits,
    other                           BOOLEAN                 -- indicates a cyber attack of undefined type
}


-- This type is used to flag the source of ephemeris/almanac/clock and ionospheric data.
-- Padded to use 8 bits
DataSource ::= SEQUENCE {
    wordPadding                     Pad5bits,
    dataSource                      ENUMERATED {
        dsUnknown,                      -- unknown/un-authenticated source
        dsSatellite,                    -- source is an un-authenticated satellite navigation message
        dsSatelliteAuth,                -- source is an authenticated/protected satellite navigation message
        dsExternal,                     -- source is an unauthenticated external source
        dsExternalTrusted               -- source is from an external trusted and/or authenticated source
    }
}

-- This type contains date and time fields.
DateTime ::= SEQUENCE {
    timeReference                   TimeReference,
    yearValid                       BOOLEAN,
    monthValid                      BOOLEAN,
    dayValid                        BOOLEAN,
    wordPadding                     Pad1bits,
    year                            Unsigned12,
    month                           INTEGER (0..12),        -- 0 is not valid; month will be in the range 1..12, January to December
    day                             INTEGER (0..31),        -- 0 is not valid; day will be in the range 1..31
    hour                            INTEGER (0..23),
    minute                          INTEGER (0..59),
    second                          INTEGER (0..60),        -- range set 0-60 in order to cater for UTC leap second adjustments
    wordPadding1                    Pad2bits
}


-- This type specifies the geodetic datum to be used.
--
-- List is from NATO STANAG 2211 which references NATO Standard AGeoP-21.
-- Remaining values are spare/reserved.
-- Note 1: A "0" in the Datum Number field of an output message indicates that
-- the Datum to be used is the default Datum which is WGS-84 (wge(267)).
-- Refer to the Datum Code field to identify the Datum.
-- Note 2: User defined Datums may be programmed by the host.
DatumID ::= INTEGER {
    defaultDatum(0),-- Note 1
    acc(1),         -- ACCRA, Ghana
    adiE(2),        -- ADINDAN, Burkina Faso
    adiF(3),        -- ADINDAN, Cameroon
